const InsightBadge = ({ text, type = 'warning' }) => {
  const s = {
    warning: 'bg-amber-500/10 border-amber-500/30 text-amber-200',
    danger:  'bg-rose-500/10  border-rose-500/30  text-rose-200',
    success: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-200',
    info:    'bg-blue-500/10  border-blue-500/30  text-blue-200',
  };
  const icons = { warning: AlertTriangle, danger: XCircle, success: CheckCircle2, info: Lightbulb };
  const Icon = icons[type];
  return (
    <div className={`flex items-start gap-2 p-3 border ${s[type]} mt-3`}>
      <Icon className="w-3 h-3 shrink-0 mt-0.5 opacity-80" />
      <p className="text-[10px] leading-relaxed font-semibold italic">{text}</p>
    </div>
  );
};

const ConditionRow = ({ item }) => {
  const wrColor = item.wr >= 70 ? 'text-emerald-400' : item.wr >= 55 ? 'text-amber-400' : 'text-rose-400';
  const barColor = item.wr >= 70 ? 'bg-emerald-500' : item.wr >= 55 ? 'bg-amber-500' : 'bg-rose-500';
  const plColor = item.netPL >= 0 ? 'text-emerald-400' : 'text-rose-400';
  return (
    <div className={`flex items-center gap-3 px-4 py-3 border-b border-white/[0.04] last:border-0 hover:bg-white/[0.025] transition-colors ${!item.strength ? 'bg-rose-950/20' : ''}`}>
      <div className="w-36 shrink-0">
        <span className="text-[10px] font-bold text-slate-400 uppercase tracking-tight">{item.label}</span>
        {!item.strength && <span className="ml-2 text-[8px] text-rose-500 font-black uppercase">WEAK</span>}
      </div>
      <div className="flex-1">
        <div className="w-full bg-[#0a1020] h-1.5 rounded-full overflow-hidden">
          <div className={`h-full ${barColor} rounded-full transition-all duration-700`} style={{ width: `${item.wr}%` }} />
        </div>
      </div>
      <span className={`text-xs font-black w-10 text-right mono ${wrColor}`}>{item.wr}%</span>
      <span className={`text-[10px] font-bold w-12 text-right mono ${item.avgR >= 2 ? 'text-blue-400' : item.avgR >= 0 ? 'text-slate-500' : 'text-rose-500'}`}>{item.avgR > 0 ? '+' : ''}{item.avgR.toFixed(1)}R</span>
      <span className={`text-[10px] font-bold w-16 text-right mono ${plColor}`}>{item.netPL >= 0 ? '+' : ''}${item.netPL.toLocaleString()}</span>
      <span className="text-[9px] text-slate-700 w-14 text-right mono">{item.trades} trades</span>
    </div>
  );
};

