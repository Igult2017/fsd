const StatCard = ({ label, value, change, icon: Icon, color, dark = true }) => (
  <div className={`border p-5 rounded-2xl shadow-sm transition-all h-full flex flex-col justify-between ${dark ? 'bg-slate-900 border-slate-800 hover:border-slate-700' : 'bg-white border-gray-200 hover:border-gray-300 shadow-sm'}`}>
    <div>
      <div className="flex justify-between items-start mb-4">
        <div className={`p-2 rounded-xl ${dark ? 'bg-slate-800/50' : 'bg-gray-100'} ${color}`}>
          <Icon size={18} />
        </div>
        <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full font-mono ${change.startsWith('+') ? 'bg-emerald-500/10 text-emerald-400' : 'bg-red-500/10 text-red-400'}`}>
          {change}
        </span>
      </div>
      <h3 className={`text-[10px] font-semibold uppercase tracking-widest ${dark ? 'text-slate-500' : 'text-slate-400'}`}>{label}</h3>
    </div>
    <p className={`text-xl font-bold mt-2 font-mono tracking-tight ${dark ? 'text-white' : 'text-slate-800'}`}>{value}</p>
  </div>
);

const SidebarItem = ({ icon: Icon, label, active = false, onClick, hasDropdown = false, isOpen = false, onToggle, collapsed = false, dark = true }) => (
  <div>
    <button 
      onClick={hasDropdown ? onToggle : onClick}
      className={`w-full flex items-center gap-3 rounded-xl transition-all ${
        active
          ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-600/20'
          : dark
            ? 'text-slate-400 hover:bg-slate-800/50 hover:text-white'
            : 'text-slate-500 hover:bg-gray-100 hover:text-slate-900'
      } ${collapsed ? 'justify-center px-2 py-4' : 'px-4 py-3'}`}
      title={collapsed ? label : ''}
    >
      <Icon size={collapsed ? 26 : 18} strokeWidth={collapsed ? 2 : 2.5} />
      {!collapsed && (
        <>
          <span className="font-bold text-[11px] tracking-widest uppercase flex-1 text-left">{label}</span>
          {hasDropdown && (
            <ChevronRight size={14} className={`transition-transform ${isOpen ? 'rotate-90' : ''}`} />
          )}
        </>
      )}
    </button>
  </div>
);

