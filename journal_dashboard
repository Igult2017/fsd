const TradeEntryForm = () => {
  const [step, setStep] = React.useState(1);
  const [formData, setFormData] = React.useState({
    // Basic fields
    instrument: '',
    direction: 'Long',
    lotSize: '',
    entryPrice: '',
    stopLoss: '',
    takeProfit: '',
    outcome: 'Win',
    profitLoss: '',
    // Decision Architecture
    thesis: '',
    trigger: '',
    invalidationLogic: '',
    expectedBehavior: '',
    setupTag: 'Breakout',
    tradeGrade: 'A',
    // Context
    marketRegime: 'Trending',
    trendDirection: 'Bullish',
    volatilityState: 'Normal',
    // Review
    whatWorked: '',
    whatFailed: '',
    adjustments: '',
    notes: ''
  });

  const updateField = (field, value) => {
    setFormData(prev => ({ ...prev, [field]: value }));
  };

  const nextStep = () => setStep(s => Math.min(4, s + 1));
  const prevStep = () => setStep(s => Math.max(1, s - 1));

  const InputField = ({ label, field, type = "text", placeholder = "", rows }) => (
    <div className="space-y-2">
      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">{label}</label>
      {rows ? (
        <textarea
          rows={rows}
          className="w-full px-3 py-2.5 rounded-lg border border-slate-800 bg-slate-900/50 text-slate-100 text-sm placeholder:text-slate-600 focus:border-indigo-500/50 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all resize-none"
          placeholder={placeholder}
          value={formData[field]}
          onChange={(e) => updateField(field, e.target.value)}
        />
      ) : (
        <input
          type={type}
          className="w-full px-3 py-2.5 rounded-lg border border-slate-800 bg-slate-900/50 text-slate-100 text-sm placeholder:text-slate-600 focus:border-indigo-500/50 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all"
          placeholder={placeholder}
          value={formData[field]}
          onChange={(e) => updateField(field, e.target.value)}
        />
      )}
    </div>
  );

  const SelectField = ({ label, field, options }) => (
    <div className="space-y-2">
      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">{label}</label>
      <select
        className="w-full px-3 py-2.5 rounded-lg border border-slate-800 bg-slate-900/50 text-slate-100 text-sm focus:border-indigo-500/50 focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all cursor-pointer"
        value={formData[field]}
        onChange={(e) => updateField(field, e.target.value)}
      >
        {options.map(opt => <option key={opt} value={opt} className="bg-slate-900">{opt}</option>)}
      </select>
    </div>
  );

  return (
    <div className="max-w-6xl mx-auto">
      <div className="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden">
        {/* Header */}
        <div className="bg-slate-900/50 border-b border-slate-800 p-6">
          <h2 className="text-2xl font-black text-white mb-2 uppercase italic font-geist tracking-tight">Trade Entry Journal</h2>
          <p className="text-sm text-slate-400">Document your trading decisions and performance</p>
        </div>

        {/* Step Navigation */}
        <div className="border-b border-slate-800 bg-slate-950/50">
          <div className="flex">
            {[
              { id: 1, label: 'Decision', desc: 'Thesis & Logic' },
              { id: 2, label: 'Execution', desc: 'Core Data' },
              { id: 3, label: 'Context', desc: 'Market State' },
              { id: 4, label: 'Review', desc: 'Performance' }
            ].map((item) => (
              <button
                key={item.id}
                onClick={() => setStep(item.id)}
                className={`flex-1 px-4 py-4 text-center border-r border-slate-800 last:border-r-0 transition-all ${
                  step === item.id
                    ? 'bg-indigo-600 text-white'
