        {/* Form Content */}
        <div className="p-8">
          {step === 1 && (
            <div className="space-y-6">
              <h3 className="text-lg font-black text-white uppercase">Decision Architecture</h3>
              <InputField label="Trade Thesis" field="thesis" rows={4} placeholder="What's your edge? Why are you taking this trade?" />
              <InputField label="Entry Trigger" field="trigger" rows={3} placeholder="What specific signal triggered your entry?" />
              <InputField label="Invalidation Logic" field="invalidationLogic" rows={3} placeholder="Under what conditions is your thesis wrong?" />
              <InputField label="Expected Behavior" field="expectedBehavior" rows={3} placeholder="How should price behave if you're right?" />
              <div className="grid grid-cols-2 gap-4">
                <SelectField label="Setup Tag" field="setupTag" options={['Breakout', 'Reversal', 'Continuation', 'Pullback', 'Other']} />
                <SelectField label="Trade Grade" field="tradeGrade" options={['A - Textbook', 'B - Solid', 'C - Acceptable', 'D - Marginal']} />
