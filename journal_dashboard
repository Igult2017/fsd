              <button onClick={() => setIsDarkTheme(!isDarkTheme)} className={`p-2.5 rounded-lg transition-all ${isDarkTheme ? 'text-slate-400 hover:bg-slate-800/50 hover:text-white' : 'text-slate-500 hover:bg-gray-100 hover:text-slate-900'}`}>
                {isDarkTheme ? <Sun size={18} /> : <Moon size={18} />}
              </button>
              <button className={`p-2.5 rounded-lg transition-all ${isDarkTheme ? 'text-slate-400 hover:bg-slate-800/50 hover:text-white' : 'text-slate-500 hover:bg-gray-100 hover:text-slate-900'}`}>
                <div className="w-7 h-7 rounded-full bg-indigo-600 flex items-center justify-center"><User size={16} className="text-white" /></div>
              </button>
              <button className={`p-2.5 rounded-lg transition-all ${isDarkTheme ? 'text-slate-400 hover:bg-slate-800/50 hover:text-white' : 'text-slate-500 hover:bg-gray-100 hover:text-slate-900'}`}><Users size={18} /></button>
            </div>
          </header>

          <div className="flex-1 overflow-y-auto no-scrollbar">
            <div className="max-w-[1600px] mx-auto p-6 md:p-10 space-y-10">

              {activeTab === 'create-session' ? (
                <CreateSessionForm onSubmit={handleCreateSession} />
              ) : activeTab === 'sessions' ? (
                <SessionsList sessions={sessions} onDeleteSession={handleDeleteSession} />
              ) : activeTab === 'journal' ? (
                <TradeEntryForm />
              ) : activeTab === 'leaderboard' ? (
                <LeaderboardPage />
              ) : (
                <>
                  {/* Active Session Banner */}
                  {selectedSession && (
                    <div className="bg-gradient-to-r from-indigo-500/10 to-purple-500/10 border border-indigo-500/20 rounded-2xl p-6 mb-6">
                      <div className="flex items-center justify-between">
                        <div>
                          <p className={`text-[10px] uppercase tracking-wider mb-1 font-black ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>Active Session</p>
                          <h2 className={`text-2xl font-black tracking-tight ${isDarkTheme ? 'text-white' : 'text-slate-800'}`}>{selectedSession.sessionName}</h2>
                        </div>
                        <button onClick={() => setSelectedSession(null)} className={`text-xs transition-all px-4 py-2 rounded-lg ${isDarkTheme ? 'text-slate-400 hover:text-white bg-slate-800/50' : 'text-slate-500 hover:text-slate-800 bg-gray-100 hover:bg-gray-200'}`}>Clear Session</button>
                      </div>
                    </div>
                  )}

                  {/* Stat Cards */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
                    {sessionStats.map((stat, idx) => <StatCard key={idx} {...stat} dark={isDarkTheme} />)}
                  </div>

                  {/* Equity Curve + Performance */}
                  <div className="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
                    {/* Equity Curve */}
                    <div className={`xl:col-span-8 border rounded-3xl p-8 relative overflow-hidden transition-colors duration-300 ${isDarkTheme ? 'bg-slate-900 border-slate-800' : 'bg-white border-gray-200 shadow-sm'}`}>
                      <div className="absolute top-0 right-0 p-8 opacity-10 pointer-events-none"><LineChart size={120} className="text-indigo-500" /></div>
                      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 relative z-10">
                        <h3 className={`text-xl font-black flex items-center gap-3 tracking-tight uppercase italic font-geist ${isDarkTheme ? 'text-white' : 'text-slate-800'}`}>
                          <LineChart size={20} className="text-indigo-400" /> Equity Curve
                        </h3>
                        <div className={`flex p-1 rounded-xl border ${isDarkTheme ? 'bg-slate-800/50 border-slate-800' : 'bg-gray-100 border-gray-200'}`}>
                          {['1D', '1W', '1M', 'ALL'].map((range, i) => (
                            <button key={range} className={`px-4 py-1.5 text-[10px] font-black rounded-lg transition-all uppercase tracking-widest ${
                              i === 0
                                ? isDarkTheme ? 'bg-slate-700 text-white shadow-lg' : 'bg-white text-slate-800 shadow-sm'
                                : isDarkTheme ? 'text-slate-500 hover:text-slate-300' : 'text-slate-400 hover:text-slate-700'
                            }`}>{range}</button>
                          ))}
                        </div>
                      </div>
                      <SmoothEquityCurve />
                      <div className={`flex justify-between mt-6 text-[10px] font-black uppercase tracking-[0.3em] px-4 font-mono ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>
                        {['09:00', '11:00', '13:00', '15:00', '17:00'].map(t => <span key={t}>{t}</span>)}
                      </div>
                    </div>

                    {/* Performance Panel */}
                    <div className={`xl:col-span-4 border rounded-3xl p-8 h-full transition-colors duration-300 ${isDarkTheme ? 'bg-slate-900 border-slate-800' : 'bg-white border-gray-200 shadow-sm'}`}>
                      <h3 className={`text-xl font-black mb-6 tracking-tight uppercase italic font-geist ${isDarkTheme ? 'text-white' : 'text-slate-800'}`}>Performance</h3>
                      <div className="space-y-8">
                        {[
                          { label: 'Winning Rate', value: '60%', color: 'text-emerald-500', barColor: 'bg-emerald-500', glow: 'rgba(16,185,129,0.4)', width: 'w-[60%]' },
                          { label: 'Losing Rate',  value: '40%', color: 'text-red-500',    barColor: 'bg-red-500',    glow: 'rgba(239,68,68,0.4)',    width: 'w-[40%]' }
                        ].map(({ label, value, color, barColor, glow, width }) => (
                          <div key={label} className="space-y-3">
                            <div className="flex justify-between items-center">
                              <span className={`text-[10px] font-bold uppercase tracking-widest ${isDarkTheme ? 'text-slate-400' : 'text-slate-500'}`}>{label}</span>
                              <span className={`${color} font-bold font-mono`}>{value}</span>
                            </div>
                            <div className={`w-full h-3 rounded-full overflow-hidden flex shadow-inner p-0.5 ${isDarkTheme ? 'bg-slate-800' : 'bg-gray-100'}`}>
                              <div className={`h-full ${barColor} rounded-full ${width} transition-all duration-1000`} style={{ boxShadow: `0 0 10px ${glow}` }} />
                            </div>
                          </div>
                        ))}

                        <div className={`pt-8 border-t mt-4 ${isDarkTheme ? 'border-slate-800/60' : 'border-gray-100'}`}>
                          <h4 className={`text-[10px] font-black uppercase tracking-[0.2em] mb-6 ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>Volume Leaders</h4>
                          <div className="space-y-6">
                            {['NVDA', 'TSLA', 'AAPL'].map(sym => (
                              <div key={sym} className="flex justify-between items-center">
                                <span className={`text-sm font-black tracking-widest font-geist italic ${isDarkTheme ? 'text-white' : 'text-slate-800'}`}>{sym}</span>
                                <div className="flex items-center gap-4">
                                  <div className={`w-32 h-1.5 rounded-full overflow-hidden ${isDarkTheme ? 'bg-slate-800' : 'bg-gray-100'}`}>
                                    <div className="h-full bg-indigo-500 w-2/3 shadow-[0_0_8px_rgba(99,102,241,0.4)]" />
                                  </div>
                                  <span className={`text-[10px] font-bold font-mono ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>12 TRADES</span>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Trade Log + Right Widgets */}
                  <div className="grid grid-cols-1 xl:grid-cols-12 gap-8 pb-10">
                    {/* Trade Log */}
                    <div className="xl:col-span-8 space-y-8">
                      <div className={`border rounded-3xl overflow-hidden shadow-sm transition-colors duration-300 ${isDarkTheme ? 'bg-slate-900 border-slate-800' : 'bg-white border-gray-200'}`}>
                        <div className={`px-8 py-6 border-b flex justify-between items-center backdrop-blur-sm ${isDarkTheme ? 'border-slate-800 bg-slate-900/50' : 'border-gray-100 bg-gray-50/80'}`}>
                          <h3 className={`text-xl font-black tracking-tight italic uppercase font-geist ${isDarkTheme ? 'text-white' : 'text-slate-800'}`}>Recent Trade Log</h3>
                          <button className="text-indigo-400 hover:text-indigo-500 text-[10px] font-black uppercase tracking-widest flex items-center gap-1 transition-all">Journal Access <ChevronRight size={16} /></button>
                        </div>
                        <div className="overflow-x-auto no-scrollbar">
                          <table className="w-full text-left border-collapse min-w-[700px]">
                            <thead>
                              <tr className={`border-b ${isDarkTheme ? 'border-slate-800 bg-slate-800/30' : 'border-gray-100 bg-gray-50'}`}>
                                {['Ticker', 'Type', 'Execution', 'Size', 'Net P&L', 'Status'].map(h => (
                                  <th key={h} className={`px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>{h}</th>
                                ))}
                              </tr>
                            </thead>
                            <tbody className={`divide-y ${isDarkTheme ? 'divide-slate-800/50' : 'divide-gray-100'}`}>
                              {(currentSessionData.trades?.length > 0 ? currentSessionData.trades : MOCK_TRADES).map((trade) => (
                                <tr key={trade.id} className={`transition-all ${isDarkTheme ? 'hover:bg-slate-800/40' : 'hover:bg-gray-50'}`}>
                                  <td className="px-8 py-5">
                                    <p className={`font-black tracking-widest italic ${isDarkTheme ? 'text-white' : 'text-slate-800'}`}>{trade.symbol}</p>
                                    <p className={`text-[10px] font-mono font-bold mt-1 uppercase opacity-60 ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>{trade.date}</p>
                                  </td>
                                  <td className="px-8 py-5">
                                    <span className={`text-[10px] font-black px-2.5 py-1 rounded-lg tracking-[0.1em] border ${trade.type === 'LONG' ? 'bg-emerald-500/10 text-emerald-600 border-emerald-500/30' : 'bg-red-500/10 text-red-500 border-red-500/30'}`}>{trade.type}</span>
                                  </td>
                                  <td className="px-8 py-5 text-sm font-mono font-bold">
                                    <span className={isDarkTheme ? 'text-slate-100' : 'text-slate-700'}>{trade.entry.toFixed(2)}</span>
                                    <span className={`mx-3 ${isDarkTheme ? 'text-slate-700' : 'text-gray-300'}`}>/</span>
                                    <span className={isDarkTheme ? 'text-slate-100' : 'text-slate-700'}>{trade.exit.toFixed(2)}</span>
                                  </td>
                                  <td className={`px-8 py-5 text-[11px] font-black uppercase tracking-widest ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>
                                    <span className={`font-mono ${isDarkTheme ? 'text-slate-200' : 'text-slate-700'}`}>{trade.size}</span> UNITS
                                  </td>
                                  <td className={`px-8 py-5 text-sm font-black font-mono tracking-tighter ${trade.pnl >= 0 ? 'text-emerald-500' : 'text-red-500'}`}>
                                    {trade.pnl >= 0 ? `+$${trade.pnl.toLocaleString()}` : `-$${Math.abs(trade.pnl).toLocaleString()}`}
                                  </td>
                                  <td className="px-8 py-5">
                                    <div className="flex items-center">
                                      <div className={`w-1.5 h-1.5 rounded-full mr-3 shadow-lg ${trade.status === 'Win' ? 'bg-emerald-500 shadow-emerald-500/50' : 'bg-red-500 shadow-red-500/50'}`} />
                                      <span className={`text-[10px] font-black uppercase tracking-widest ${isDarkTheme ? 'text-slate-300' : 'text-slate-600'}`}>{trade.status}</span>
                                    </div>
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>

                    {/* Right Column Widgets */}
                    <div className="xl:col-span-4 space-y-8">
                      {/* Calendar Heatmap */}
                      <div className={`border rounded-3xl p-8 transition-colors duration-300 ${isDarkTheme ? 'bg-slate-900 border-slate-800' : 'bg-white border-gray-200 shadow-sm'}`}>
                        <h3 className={`text-[10px] font-black uppercase tracking-[0.25em] flex items-center gap-2 mb-6 ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>
                          <Calendar size={12} strokeWidth={3} /> Performance Heatmap
                        </h3>
                        <MiniCalendar isDark={isDarkTheme} />
                      </div>

                      {/* Alpha Logic — always indigo, always looks great */}
                      <div className="bg-gradient-to-br from-indigo-600 via-indigo-700 to-indigo-950 rounded-3xl p-8 text-white relative overflow-hidden border border-white/10 shadow-2xl">
                        <div className="relative z-10">
                          <div className="flex items-center gap-2 mb-3">
                            <TrendingUp size={16} className="text-indigo-200" strokeWidth={3} />
                            <h4 className="font-black text-sm uppercase tracking-[0.2em]">Alpha Logic</h4>
                          </div>
                          <p className="text-xs text-indigo-100/80 leading-relaxed mb-6 font-bold italic tracking-tight">"Win probability increases by 18.4% when entries are localized within the 09:30 - 10:15 window."</p>
                          <button className="text-[10px] font-black uppercase tracking-[0.25em] bg-white text-indigo-950 hover:bg-indigo-50 px-6 py-3 rounded-xl transition-all shadow-xl w-full">Optimize Strategy</button>
                        </div>
                      </div>

                      {/* Global Sessions */}
                      <div className={`border rounded-3xl p-8 transition-colors duration-300 ${isDarkTheme ? 'bg-slate-900 border-slate-800' : 'bg-white border-gray-200 shadow-sm'}`}>
                        <h3 className={`text-[10px] font-black uppercase tracking-[0.25em] flex items-center gap-2 mb-6 ${isDarkTheme ? 'text-slate-500' : 'text-slate-400'}`}>
                          <Clock size={12} strokeWidth={3} /> Global Sessions
                        </h3>
                        <div className={`border rounded-2xl p-6 space-y-5 ${isDarkTheme ? 'bg-slate-800/40 border-slate-800' : 'bg-gray-50 border-gray-200'}`}>
                          <div className="flex items-center justify-between">
                            <div className="flex items-center gap-3">
                              <div className="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.8)] animate-pulse" />
                              <span className={`text-xs font-black tracking-widest uppercase ${isDarkTheme ? 'text-white' : 'text-slate-800'}`}>New York</span>
                            </div>
                            <span className="text-[9px] font-black text-emerald-500 tracking-[0.1em] bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20 uppercase">Live</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* Modals */}
      {showBrokerModal && <FindBrokerModal onClose={() => setShowBrokerModal(false)} />}
      {showPropfirmModal && <FindPropfirmModal onClose={() => setShowPropfirmModal(false)} />}
    </>
  );
};

export default App;
