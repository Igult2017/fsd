// --- Language Selector Component ---
const LanguageSelector = () => {
  const [open, setOpen] = React.useState(false);
  const [selected, setSelected] = React.useState(LANGUAGES[0]);
  const ref = React.useRef(null);

  React.useEffect(() => {
    const handler = (e) => {
      if (ref.current && !ref.current.contains(e.target)) setOpen(false);
    };
    document.addEventListener('mousedown', handler);
    return () => document.removeEventListener('mousedown', handler);
  }, []);

  return (
    <div ref={ref} className="relative">
      <button
        onClick={() => setOpen(!open)}
        className={`p-2.5 rounded-lg transition-all flex items-center gap-1.5 ${open ? 'bg-slate-800 text-white' : 'hover:bg-slate-800/50 text-slate-400 hover:text-white'}`}
        title="Change Language"
      >
        <Globe size={18} />
      </button>

      {open && (
        <div className="absolute right-0 top-full mt-2 w-52 bg-slate-900 border border-slate-700 rounded-2xl shadow-2xl shadow-black/60 overflow-hidden z-50">
          {/* Header */}
          <div className="px-4 py-3 border-b border-slate-800 flex items-center gap-2">
            <Globe size={12} className="text-indigo-400" />
            <span className="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em]">Select Language</span>
          </div>

          {/* Language List */}
          <div className="py-1.5 max-h-72 overflow-y-auto no-scrollbar">
            {LANGUAGES.map((lang) => {
              const isActive = selected.code === lang.code;
              return (
                <button
                  key={lang.code}
                  onClick={() => { setSelected(lang); setOpen(false); }}
                  className={`w-full flex items-center gap-3 px-4 py-2.5 transition-all group ${
                    isActive
                      ? 'bg-indigo-600/20 text-white'
                      : 'text-slate-400 hover:bg-slate-800/60 hover:text-white'
                  }`}
                >
                  <span className="text-xl leading-none">{lang.flag}</span>
                  <div className="flex-1 text-left">
                    <p className={`text-[11px] font-black uppercase tracking-wider ${isActive ? 'text-white' : 'text-slate-300'}`}>{lang.label}</p>
                    <p className="text-[9px] text-slate-500 font-medium mt-0.5">{lang.native}</p>
                  </div>
                  {isActive && (
                    <div className="w-1.5 h-1.5 rounded-full bg-indigo-400 shadow-[0_0_6px_rgba(99,102,241,0.8)]" />
                  )}
                </button>
              );
            })}
          </div>

          {/* Footer */}
          <div className="px-4 py-2.5 border-t border-slate-800 bg-slate-800/30">
            <p className="text-[9px] text-slate-600 font-medium">
              Selected: <span className="text-slate-400 font-black">{selected.flag} {selected.label}</span>
            </p>
          </div>
        </div>
      )}
    </div>
  );
};

