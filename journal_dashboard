          {step === 3 && (
            <div className="space-y-6">
              <h3 className="text-lg font-black text-white uppercase">Market Context</h3>
              <div className="grid grid-cols-2 gap-4">
                <SelectField label="Market Regime" field="marketRegime" options={['Trending', 'Ranging']} />
                <SelectField label="Trend Direction" field="trendDirection" options={['Bullish', 'Bearish', 'Sideways']} />
                <SelectField label="Volatility" field="volatilityState" options={['Low', 'Normal', 'High']} />
              </div>
            </div>
          )}

          {step === 4 && (
            <div className="space-y-6">
              <h3 className="text-lg font-black text-white uppercase">Post-Trade Review</h3>
              <InputField label="What Worked" field="whatWorked" rows={3} placeholder="What did you execute well?" />
              <InputField label="What Failed" field="whatFailed" rows={3} placeholder="What went wrong?" />
              <InputField label="Future Adjustments" field="adjustments" rows={3} placeholder="What will you change?" />
              <InputField label="Additional Notes" field="notes" rows={3} placeholder="Any other observations..." />
            </div>
          )}

          {/* Navigation */}
          <div className="flex justify-between items-center pt-8 mt-8 border-t border-slate-800">
            <button
              onClick={prevStep}
              disabled={step === 1}
              className={`flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-wider transition-all ${
                step === 1 ? 'opacity-0 pointer-events-none' : 'text-slate-400 hover:text-white hover:bg-slate-800'
              }`}
            >
              <ChevronLeft size={16} /> Back
            </button>

            {step < 4 ? (
              <button
                onClick={nextStep}
                className="flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold text-xs uppercase tracking-wider transition-all"
