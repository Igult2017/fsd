import React, { useState, useRef, useEffect } from "react";
import {
  BrainCircuit, Send, Sparkles, AlertTriangle,
  RotateCcw, Copy, Check, MessageSquare, Download,
  Terminal, BarChart3, ShieldCheck, Zap, History,
  Command, ChevronRight, FileText
} from "lucide-react";

// --- Configuration & API Logic ---
const apiKey = "";
const MODEL_NAME = "gemini-2.5-flash-preview-09-2025";

const SUGGESTED_QUESTIONS = [
  "What patterns do you see in my losing trades?",
  "Am I over-trading on any particular day?",
  "How does my emotional state affect my win rate?",
  "Which setup tags perform best for me?",
  "Am I following my risk management rules?",
  "What's my average R:R on winning vs losing trades?",
  "Do I trade better in specific sessions?",
  "Where do I deviate most from my planned entries?",
  "What does my impulse control data reveal?",
  "Which instruments give me the best results?",
];

const SYSTEM_PROMPT = `You are an elite trading coach and performance analyst connected directly to the trader's TradeLog journal database. You have full access to all their trade entries.

Your role is to:
- Query and analyse the trader's data to give sharp, specific, actionable insights.
- Point out weaknesses without sugarcoating.
- Reference specific data points and statistics.
- Keep responses focused, structured, and professional. Use markdown tables or lists for data.

Always respond as if you have already retrieved the relevant data from the database.`;

export default function App() {
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const [copiedIdx, setCopiedIdx] = useState(null);
  const [error, setError] = useState(null);
  const messagesEndRef = useRef(null);

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, loading]);

  const callGemini = async (userMessages) => {
    let delay = 1000;
    const maxRetries = 5;

    for (let i = 0; i <= maxRetries; i++) {
      try {
        const response = await fetch(
          `https://generativelanguage.googleapis.com/v1beta/models/${MODEL_NAME}:generateContent?key=${apiKey}`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              contents: [{ parts: [{ text: userMessages.map(m => `${m.role.toUpperCase()}: ${m.content}`).join("\n") }] }],
              systemInstruction: { parts: [{ text: SYSTEM_PROMPT }] },
            }),
          }
        );

        if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);

        const data = await response.json();
        const text = data.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!text) throw new Error("Empty response from AI");
        return text;
      } catch (err) {
        if (i === maxRetries) throw err;
        await new Promise((resolve) => setTimeout(resolve, delay));
        delay *= 2;
      }
    }
  };

  const sendMessage = async (overrideInput) => {
    const userMsg = (overrideInput ?? input).trim();
    if (!userMsg || loading) return;
    setInput("");
    setError(null);

    const newMessages = [...messages, { role: "user", content: userMsg }];
    setMessages(newMessages);
    setLoading(true);

    try {
      const reply = await callGemini(newMessages);
      setMessages([...newMessages, { role: "model", content: reply }]);
    } catch (err) {
      setError("Analysis failed. Connection to the neural engine timed out. Please retry.");
    } finally {
      setLoading(false);
    }
  };

  const copyMessage = (text, idx) => {
    document.execCommand('copy'); 
    navigator.clipboard.writeText(text);
    setCopiedIdx(idx);
    setTimeout(() => setCopiedIdx(null), 2000);
  };

  const downloadFullReport = () => {
    if (messages.length === 0) return;
    
    const timestamp = new Date().toLocaleString();
    let content = `FSD AI TRADE ANALYSIS REPORT\nGenerated: ${timestamp}\n`;
    content += `==========================================\n\n`;

    messages.forEach((msg, i) => {
      const role = msg.role === 'user' ? 'TRADER' : 'FSD AI ANALYST';
      content += `[${role}]\n${msg.content}\n\n`;
      content += `------------------------------------------\n\n`;
    });

    content += `END OF REPORT\n`;

    const blob = new Blob([content], { type: "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `fsd-ai-analysis-${Date.now()}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const downloadMessage = (text, idx) => {
    const content = `TRADELOG AI ANALYST REPORT\n\n${text}`;
    const blob = new Blob([content], { type: "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `trade-analysis-${Date.now()}.txt`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const clearChat = () => {
    setMessages([]);
    setError(null);
  };

  return (
    <div className="min-h-screen bg-[#020617] text-slate-200 font-sans selection:bg-indigo-500/30">
      {/* Background Decor */}
      <div className="fixed inset-0 overflow-hidden pointer-events-none">
        <div className="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-600/10 blur-[120px] rounded-full" />
        <div className="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-emerald-600/5 blur-[120px] rounded-full" />
      </div>

      <div className="relative flex flex-col h-screen max-w-6xl mx-auto border-x border-slate-800/50 bg-slate-950/20 backdrop-blur-3xl">
        
        {/* Top Navigation Bar */}
        <header className="flex-shrink-0 flex items-center justify-between px-6 py-4 border-b border-slate-800/60 bg-slate-900/40 backdrop-blur-md z-10">
          <div className="flex items-center gap-4">
            <div className="p-2 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-xl shadow-lg shadow-indigo-500/20">
              <BrainCircuit className="w-5 h-5 text-white" />
            </div>
            <div>
              <h1 className="text-sm font-bold tracking-tight text-white uppercase flex items-center gap-2">
                fsd AI <span className="text-[10px] bg-indigo-500/20 text-indigo-400 px-1.5 py-0.5 rounded border border-indigo-500/30">v2.5</span>
              </h1>
              <p className="text-[10px] text-slate-500 font-medium tracking-wide flex items-center gap-1.5">
                <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                SECURE DATABASE UPLINK ACTIVE
              </p>
            </div>
          </div>
          
          <div className="flex items-center gap-2">
            {messages.length > 0 && (
              <>
                <button 
                  onClick={downloadFullReport}
                  className="flex items-center gap-2 px-3 py-1.5 bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-400 text-[10px] font-bold uppercase tracking-wider rounded-lg border border-indigo-500/30 transition-all active:scale-95"
                  title="Download Full Report"
                >
                  <FileText className="w-3.5 h-3.5" />
                  <span className="hidden sm:inline">Download Report</span>
                </button>
                <button 
                  onClick={clearChat}
                  className="p-2 text-slate-400 hover:text-rose-400 hover:bg-rose-400/10 rounded-lg transition-all border border-transparent hover:border-rose-400/20"
                  title="Clear Session"
                >
                  <RotateCcw className="w-4 h-4" />
                </button>
              </>
            )}
            <div className="hidden md:flex flex-col items-end px-4 py-1.5 bg-slate-800/30 border border-slate-700/50 rounded-lg">
               <span className="text-[8px] text-slate-500 uppercase font-black tracking-widest">Latency</span>
               <span className="text-[10px] text-emerald-400 font-mono">24ms / OPTIMAL</span>
            </div>
          </div>
        </header>

        {/* Workspace */}
        <main className="flex-1 overflow-hidden relative flex flex-col">
          
          {messages.length === 0 ? (
            <div className="flex-1 overflow-y-auto custom-scrollbar">
              <div className="flex flex-col items-center justify-center min-h-full p-6 text-center">
                <div className="relative mb-6 mt-4">
                  <div className="absolute inset-0 bg-indigo-500/20 blur-3xl rounded-full scale-150 animate-pulse" />
                  <div className="relative w-16 h-16 bg-slate-900 border border-slate-700/50 rounded-2xl flex items-center justify-center shadow-2xl">
                    <Terminal className="w-8 h-8 text-indigo-400" />
                  </div>
                </div>
                
                <h2 className="text-xl font-bold text-white mb-2">Initialize Analysis</h2>
                <p className="text-slate-400 max-w-md mx-auto mb-8 text-sm leading-relaxed px-4">
                  Connect your trade data for deep-level pattern recognition, psychological audit, and risk efficiency mapping.
                </p>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-2.5 w-full max-w-2xl px-4 pb-8">
                  {SUGGESTED_QUESTIONS.map((q, i) => (
                    <button
                      key={i}
                      onClick={() => sendMessage(q)}
                      className="group flex items-center justify-between p-3.5 bg-slate-900/40 border border-slate-800 hover:border-indigo-500/50 hover:bg-slate-800/50 transition-all rounded-xl text-left"
                    >
                      <span className="text-[12px] text-slate-300 group-hover:text-white transition-colors line-clamp-1">{q}</span>
                      <ChevronRight className="w-3.5 h-3.5 text-slate-600 group-hover:text-indigo-400 transform group-hover:translate-x-1 transition-all flex-shrink-0 ml-2" />
                    </button>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <div className="flex-1 overflow-y-auto p-6 space-y-8 scroll-smooth custom-scrollbar">
              {messages.map((msg, idx) => (
                <div 
                  key={idx} 
                  className="flex gap-4 md:gap-6 max-w-4xl mx-auto group animate-in fade-in slide-in-from-bottom-2 duration-500"
                >
                  <div className={`mt-1 flex-shrink-0 w-8 h-8 md:w-10 md:h-10 rounded-lg md:rounded-xl flex items-center justify-center border shadow-sm
                    ${msg.role === 'user' 
                      ? 'bg-slate-800 border-slate-700' 
                      : 'bg-indigo-500/10 border-indigo-500/30'}`}
                  >
                    {msg.role === 'user' ? (
                      <span className="text-[9px] font-bold text-slate-400 uppercase">Trd</span>
                    ) : (
                      <BrainCircuit className="w-4 h-4 md:w-5 md:h-5 text-indigo-400" />
                    )}
                  </div>

                  <div className="flex-1 space-y-2 min-w-0">
                    <div className="flex items-center justify-between">
                      <span className="text-[9px] font-black uppercase tracking-[0.2em] text-slate-500">
                        {msg.role === 'user' ? 'Local Operator' : 'Neural Core'}
                      </span>
                      {msg.role === 'model' && (
                        <div className="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                          <button 
                            onClick={() => copyMessage(msg.content, idx)}
                            className="p-1.5 hover:bg-slate-800 rounded-md text-slate-500 hover:text-indigo-400 transition-all"
                            title="Copy"
                          >
                            {copiedIdx === idx ? <Check className="w-3 h-3" /> : <Copy className="w-3 h-3" />}
                          </button>
                          <button 
                            onClick={() => downloadMessage(msg.content, idx)}
                            className="p-1.5 hover:bg-slate-800 rounded-md text-slate-500 hover:text-indigo-400 transition-all"
                            title="Download Segment"
                          >
                            <Download className="w-3 h-3" />
                          </button>
                        </div>
                      )}
                    </div>
                    
                    <div className={`prose prose-invert max-w-none text-[13px] md:text-[14px] leading-relaxed
                      ${msg.role === 'user' ? 'text-slate-200 font-medium' : 'text-slate-300'}
                    `}>
                      {msg.content.split('\n').map((line, i) => {
                        if (line.trim().startsWith('|')) return <pre key={i} className="font-mono bg-slate-900/80 p-3 rounded-lg text-[11px] my-3 overflow-x-auto border border-slate-800 text-indigo-300">{line}</pre>;
                        if (line.startsWith('###')) return <h3 key={i} className="text-white font-bold text-sm uppercase tracking-wider mt-6 mb-2">{line.replace('###', '')}</h3>;
                        return <p key={i} className="mb-3 last:mb-0">{line}</p>;
                      })}
                    </div>
                  </div>
                </div>
              ))}
              
              {loading && (
                <div className="flex gap-4 md:gap-6 max-w-4xl mx-auto py-4">
                  <div className="w-8 h-8 md:w-10 md:h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center">
                    <Zap className="w-4 h-4 md:w-5 md:h-5 text-indigo-400 animate-pulse" />
                  </div>
                  <div className="flex-1 space-y-3">
                    <div className="h-2 w-24 bg-slate-800 rounded-full animate-pulse" />
                    <div className="space-y-2">
                      <div className="h-3 w-full bg-slate-900/50 rounded animate-pulse" />
                      <div className="h-3 w-3/4 bg-slate-900/50 rounded animate-pulse" />
                    </div>
                  </div>
                </div>
              )}
              <div ref={messagesEndRef} className="h-4" />
            </div>
          )}
        </main>

        {/* Input Terminal */}
        <footer className="flex-shrink-0 p-4 md:p-6 bg-slate-900/30 border-t border-slate-800/60 backdrop-blur-md">
          <div className="max-w-4xl mx-auto space-y-4">
            {error && (
              <div className="flex items-center gap-3 p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl animate-in fade-in slide-in-from-top-1">
                <AlertTriangle className="w-4 h-4 text-rose-500 flex-shrink-0" />
                <p className="text-[11px] text-rose-400 font-medium">{error}</p>
              </div>
            )}

            <div className="relative group">
              <div className="absolute inset-0 bg-indigo-500/10 blur-xl opacity-0 group-focus-within:opacity-100 transition-opacity rounded-2xl" />
              <div className="relative flex items-end gap-2 md:gap-3 p-2 bg-slate-900 border border-slate-700 group-focus-within:border-indigo-500/50 rounded-2xl transition-all shadow-2xl">
                <div className="hidden sm:flex h-11 w-11 items-center justify-center text-slate-500 bg-slate-800/50 rounded-xl border border-slate-700/50">
                  <Command className="w-4 h-4" />
                </div>
                <textarea
                  rows={1}
                  className="flex-1 bg-transparent py-3 px-1 md:px-2 text-sm text-white placeholder-slate-500 focus:outline-none resize-none min-h-[44px] max-h-32 custom-scrollbar"
                  placeholder="Query trading database..."
                  value={input}
                  onChange={e => setInput(e.target.value)}
                  onKeyDown={e => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                      e.preventDefault();
                      sendMessage();
                    }
                  }}
                  disabled={loading}
                />
                <button
                  onClick={() => sendMessage()}
                  disabled={!input.trim() || loading}
                  className="h-11 w-11 flex items-center justify-center bg-indigo-600 hover:bg-indigo-500 disabled:opacity-30 disabled:hover:bg-indigo-600 text-white rounded-xl shadow-lg shadow-indigo-600/20 transition-all active:scale-95 flex-shrink-0"
                >
                  {loading ? (
                    <div className="w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin" />
                  ) : (
                    <Send className="w-4 h-4" />
                  )}
                </button>
              </div>
            </div>

            <div className="flex items-center justify-between px-1">
              <div className="flex gap-4">
                 <div className="flex items-center gap-1.5 text-[9px] text-slate-500 font-bold uppercase tracking-widest">
                   <ShieldCheck className="w-2.5 h-2.5 text-emerald-500" />
                   Encrypted
                 </div>
                 <div className="flex items-center gap-1.5 text-[9px] text-slate-500 font-bold uppercase tracking-widest">
                   <BarChart3 className="w-2.5 h-2.5 text-indigo-500" />
                   Analytical Mode
                 </div>
              </div>
              <p className="text-[9px] text-slate-600 font-mono hidden sm:block">STATUS: SYSTEM_READY</p>
            </div>
          </div>
        </footer>
      </div>

      <style>{`
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(71, 85, 105, 0.3); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(99, 102, 241, 0.4); }
        
        /* Ensure layout stability */
        html, body, #root { height: 100%; overflow: hidden; }
      `}</style>
    </div>
  );
}
