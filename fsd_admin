                  </div>
                  <span className="text-xs text-slate-600 font-medium flex-shrink-0">{post.date}</span>
                </div>
                <h4 className="text-base font-bold text-white mb-2 leading-snug">{post.title}</h4>
                <p className="text-slate-500 text-sm line-clamp-2 font-medium leading-relaxed">
