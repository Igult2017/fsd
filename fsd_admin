          title={sidebarCollapsed ? 'Expand sidebar' : 'Collapse sidebar'}
        >
          <svg viewBox="0 0 24 24" className={`w-3 h-3 transition-transform duration-300 ${sidebarCollapsed ? 'rotate-0' : 'rotate-180'}`} fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>

        {/* Logo */}
        <div className={`flex-shrink-0 pt-4 pb-3 flex items-center ${sidebarCollapsed ? 'justify-center px-0' : 'px-4 gap-2.5'}`}>
          <img
            src="data:image/png;base64,"
            alt="FSD Admin"
            className="w-10 h-10 rounded-full object-cover flex-shrink-0 ring-2 ring-slate-700"
          />
          {!sidebarCollapsed && (
            <span className="font-black text-lg tracking-tighter text-white uppercase whitespace-nowrap overflow-hidden">FSD ADMIN</span>
          )}
        </div>

        {/* Nav */}
        <div className="flex-1 overflow-y-auto py-2 min-h-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden px-2">
          <nav className="space-y-0.5">
            {[
              { id: 'dashboard', label: 'Overview', icon: LayoutDashboard },
              { id: 'users', label: 'User Accounts', icon: Users },
              { id: 'analytics', label: 'Trade Analysis', icon: LineChart },
              { id: 'blog', label: 'Blogpost', icon: FileText },
              { id: 'marketing', label: 'Marketing', icon: Megaphone },
            ].map(item => (
              <button key={item.id} onClick={() => setActiveTab(item.id)} title={sidebarCollapsed ? item.label : ''}
                className={`w-full flex items-center gap-3 rounded-lg transition-all duration-200 ${sidebarCollapsed ? 'justify-center px-0 py-3' : 'px-3 py-2.5'} ${activeTab === item.id ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-600/20' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'}`}>
                <item.icon size={20} className="flex-shrink-0" />
                {!sidebarCollapsed && <span className="font-semibold text-sm whitespace-nowrap">{item.label}</span>}
              </button>
            ))}

            {!sidebarCollapsed
              ? <><div className="pt-3 pb-1 px-1"><div className="h-px bg-slate-800" /></div><p className="text-[9px] font-black uppercase tracking-widest text-slate-600 px-3 pb-1">Operations</p></>
              : <div className="py-2 px-2"><div className="h-px bg-slate-800" /></div>
            }

            {[
              { id: 'customer-care', label: 'Customer Care', icon: HeadphonesIcon, badge: openTickets },
              { id: 'system-monitor', label: 'System Monitor', icon: Activity },
            ].map(item => (
              <button key={item.id} onClick={() => setActiveTab(item.id)} title={sidebarCollapsed ? item.label : ''}
                className={`w-full flex items-center gap-3 rounded-lg transition-all duration-200 relative ${sidebarCollapsed ? 'justify-center px-0 py-3' : 'px-3 py-2.5'} ${activeTab === item.id ? 'bg-indigo-600 text-white shadow-lg shadow-indigo-600/20' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'}`}>
                <item.icon size={20} className="flex-shrink-0" />
                {!sidebarCollapsed && <span className="font-semibold text-sm flex-1 text-left whitespace-nowrap">{item.label}</span>}
                {item.badge > 0 && (
                  <span className={`bg-rose-500 text-white text-[9px] font-black rounded-full min-w-[18px] text-center ${sidebarCollapsed ? 'absolute top-1 right-1 px-1 py-0.5' : 'px-1.5 py-0.5'}`}>{item.badge}</span>
                )}
              </button>
            ))}

            {!sidebarCollapsed && <div className="pt-3 pb-1 px-1"><div className="h-px bg-slate-800" /></div>}
            {sidebarCollapsed && <div className="py-2 px-2"><div className="h-px bg-slate-800" /></div>}

            <button onClick={() => setActiveTab('settings')} title={sidebarCollapsed ? 'System Settings' : ''}
              className={`w-full flex items-center gap-3 rounded-lg transition-all duration-200 ${sidebarCollapsed ? 'justify-center px-0 py-3' : 'px-3 py-2.5'} ${activeTab === 'settings' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'}`}>
              <Settings size={20} className="flex-shrink-0" />
              {!sidebarCollapsed && <span className="font-semibold text-sm whitespace-nowrap">System Settings</span>}
            </button>
          </nav>
        </div>

        {/* Admin profile */}
        <div className={`flex-shrink-0 border-t border-slate-800 bg-slate-900 ${sidebarCollapsed ? 'p-2' : 'p-3'}`}>
          {sidebarCollapsed ? (
            <div className="flex justify-center py-1">
              <div className="relative cursor-pointer" title="Admin User">
                <div className="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center font-black text-xs text-white shadow-lg">AD</div>
                <div className="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full border-2 border-slate-900" />
              </div>
            </div>
          ) : (
            <div className="flex items-center gap-3 p-2.5 bg-slate-800 hover:bg-slate-700/80 rounded-xl cursor-pointer transition-colors group">
              <div className="relative flex-shrink-0">
                <div className="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center font-black text-xs text-white shadow-lg">AD</div>
                <div className="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full border-2 border-slate-800" />
              </div>
              <div className="flex-1 min-w-0">
                <p className="text-sm font-bold text-white truncate">Admin User</p>
                <p className="text-[10px] text-indigo-400 font-black uppercase tracking-widest">Super Admin</p>
              </div>
              <Settings size={14} className="text-slate-600 group-hover:text-slate-400 transition-colors flex-shrink-0" />
            </div>
          )}
        </div>
      </aside>

      {/* Main */}
      <main className="flex-1 overflow-y-auto bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-slate-950 min-w-0">
        <header className="sticky top-0 z-10 bg-slate-950/80 backdrop-blur-md border-b border-slate-800 px-6 py-4 flex justify-between items-center">
          <h1 className="text-xl font-black capitalize tracking-tight">{pageTitle[activeTab] || activeTab}</h1>

          <div className="flex items-center gap-2">
            <button className="relative p-2 text-slate-400 hover:text-white transition-colors">
              <Mail size={20} />
              <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-rose-500 rounded-full border-2 border-slate-950" />
            </button>
            <button className="relative p-2 text-slate-400 hover:text-white transition-colors">
              <Bell size={20} />
              <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-rose-600 rounded-full border-2 border-slate-950" />
            </button>
          </div>
        </header>
        <section className="p-8">{renderContent()}</section>
      </main>
    </div>
  );
}
