            <StatCard title="MRR" value="$84,200" change="+18.3%" trend="up" icon={Globe} />
          </div>
          <div style={{ display: 'grid', gridTemplateColumns: isTablet ? '1fr' : '2fr 1fr', gap: '20px' }}>
            <div style={{ ...cs, padding: '20px' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '16px', flexWrap: 'wrap', gap: '10px' }}>
                <h3 style={{ color: 'white', fontWeight: 700, fontSize: '15px', margin: 0, display: 'flex', alignItems: 'center', gap: '8px' }}><TrendingUp size={16} style={{ color: C.greenLight }} /> Growth Analytics</h3>
                <select style={{ background: C.border, color: '#94a3b8', border: `1px solid ${C.border2}`, padding: '6px 12px', fontFamily: FONT, fontSize: '12px', outline: 'none' }}><option>Last 12 Months</option><option>Last 30 Days</option></select>
              </div>
              <LineGraph data={GROWTH_DATA} />
            </div>
            <div style={{ ...cs, padding: '20px' }}>
              <h3 style={{ color: 'white', fontWeight: 700, fontSize: '15px', margin: '0 0 16px' }}>Recent Activity</h3>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
                {[{ text: 'New Enterprise signup: Marcus', time: '2m ago', err: false }, { text: 'Critical Error: Binance API lag', time: '14m ago', err: true }, { text: 'Blog post published: CPI Recap', time: '1h ago', err: false }].map((a, i) => (
                  <div key={i} style={{ display: 'flex', gap: '10px' }}>
                    <div style={{ width: '7px', height: '7px', borderRadius: '50%', background: a.err ? C.red : C.indigo, marginTop: '3px', flexShrink: 0 }} />
                    <div>
                      <p style={{ color: '#cbd5e1', fontSize: '13px', fontWeight: 500, margin: 0 }}>{a.text}</p>
                      <p style={{ color: '#475569', fontSize: '11px', margin: '2px 0 0' }}>{a.time}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      );
      case 'users': return (
        <div style={{ ...cs, overflow: 'hidden' }}>
          <div style={{ padding: '16px', borderBottom: `1px solid ${C.border}`, display: 'flex', flexDirection: isMobile ? 'column' : 'row', justifyContent: 'space-between', alignItems: isMobile ? 'flex-start' : 'center', gap: '10px' }}>
            <div style={{ position: 'relative', width: isMobile ? '100%' : 'auto' }}>
              <Search size={15} style={{ position: 'absolute', left: '12px', top: '50%', transform: 'translateY(-50%)', color: '#475569' }} />
              <input type="text" placeholder="Search traders..." style={{ ...inp, width: isMobile ? '100%' : '220px', paddingLeft: '36px' }} />
            </div>
            <button style={{ ...btn, display: 'flex', alignItems: 'center', gap: '8px', background: C.indigo, color: 'white', padding: '10px 18px', fontSize: '13px', border: 'none', alignSelf: isMobile ? 'flex-start' : 'auto' }}><UserPlus size={15} /> Add User</button>
          </div>
          {isMobile ? (
            /* Mobile card layout for users */
            <div style={{ display: 'flex', flexDirection: 'column' }}>
              {MOCK_USERS.map(user => (
                <div key={user.id} style={{ padding: '14px 16px', borderBottom: `1px solid ${C.border}` }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <p style={{ color: 'white', fontWeight: 600, fontSize: '14px', margin: 0 }}>{user.name}</p>
                      <p style={{ color: '#475569', fontSize: '11px', margin: '2px 0 4px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{user.email}</p>
                      <div style={{ display: 'flex', alignItems: 'center', gap: '4px', marginBottom: '6px' }}>
                        <span style={{ fontSize: '12px' }}>{user.flag}</span>
                        <span style={{ color: '#64748b', fontSize: '11px' }}>{user.country}</span>
                      </div>
                      <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', alignItems: 'center' }}>
                        <span style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', padding: '2px 8px', background: user.plan === 'Enterprise' ? 'rgba(245,158,11,0.1)' : C.border, color: user.plan === 'Enterprise' ? C.amberLight : '#94a3b8' }}>{user.plan}</span>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '5px' }}>
                          <div style={{ width: '5px', height: '5px', borderRadius: '50%', background: user.status === 'Active' ? C.green : user.status === 'Banned' ? C.red : '#475569' }} />
                          <span style={{ color: '#94a3b8', fontSize: '11px', fontWeight: 600 }}>{user.status}</span>
                        </div>
                        <span style={{ color: C.indigoLight, fontWeight: 700, fontFamily: 'monospace', fontSize: '12px' }}>{user.winRate}</span>
                      </div>
                    </div>
                    <button style={{ ...btn, background: 'transparent', color: '#475569', border: 'none', padding: '4px', flexShrink: 0 }}><MoreVertical size={15} /></button>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div style={{ overflowX: 'auto' }}>
              <table style={{ width: '100%', borderCollapse: 'collapse', minWidth: '780px' }}>
                <thead>
                  <tr style={{ background: 'rgba(30,41,59,0.5)' }}>
                    {['User', 'Email', 'Country', 'Plan', 'Status', 'Win Rate', 'Last Login', 'Actions'].map(h => (
                      <th key={h} style={{ padding: '12px 20px', textAlign: h === 'Win Rate' ? 'center' : h === 'Actions' ? 'right' : 'left', color: C.muted, fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.1em', fontFamily: FONT, whiteSpace: 'nowrap' }}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {MOCK_USERS.map(user => (
                    <tr key={user.id} style={{ borderTop: `1px solid ${C.bg}` }}>
                      <td style={{ padding: '14px 20px', fontFamily: FONT }}><p style={{ color: 'white', fontWeight: 600, fontSize: '13px', margin: 0 }}>{user.name}</p></td>
                      <td style={{ padding: '14px 20px', fontFamily: FONT }}><p style={{ color: '#475569', fontSize: '12px', margin: 0 }}>{user.email}</p></td>
                      <td style={{ padding: '14px 20px', fontFamily: FONT }}><div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}><span style={{ fontSize: '14px' }}>{user.flag}</span><span style={{ color: '#94a3b8', fontSize: '12px', whiteSpace: 'nowrap' }}>{user.country}</span></div></td>
                      <td style={{ padding: '14px 20px', fontFamily: FONT }}><span style={{ fontSize: '10px', fontWeight: 700, textTransform: 'uppercase', padding: '3px 8px', background: user.plan === 'Enterprise' ? 'rgba(245,158,11,0.1)' : C.border, color: user.plan === 'Enterprise' ? C.amberLight : '#94a3b8' }}>{user.plan}</span></td>
                      <td style={{ padding: '14px 20px', fontFamily: FONT }}><div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}><div style={{ width: '6px', height: '6px', borderRadius: '50%', background: user.status === 'Active' ? C.green : user.status === 'Banned' ? C.red : '#475569' }} /><span style={{ color: '#94a3b8', fontSize: '12px', fontWeight: 600 }}>{user.status}</span></div></td>
                      <td style={{ padding: '14px 20px', textAlign: 'center', color: C.indigoLight, fontWeight: 700, fontFamily: 'monospace', fontSize: '13px' }}>{user.winRate}</td>
                      <td style={{ padding: '14px 20px', color: '#475569', fontSize: '12px', fontFamily: FONT, whiteSpace: 'nowrap' }}>{user.lastLogin}</td>
                      <td style={{ padding: '14px 20px', textAlign: 'right' }}><button style={{ ...btn, background: 'transparent', color: '#475569', border: 'none', padding: '4px' }}><MoreVertical size={15} /></button></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      );
      case 'blog': return <BlogSection />;
      case 'marketing': return (
        <div style={{ display: 'grid', gridTemplateColumns: isTablet ? '1fr' : '2fr 1fr', gap: '24px' }}>
          <div style={{ ...cs, padding: '24px' }}>
            <h3 style={{ color: 'white', fontWeight: 700, fontSize: '17px', margin: '0 0 20px', display: 'flex', alignItems: 'center', gap: '10px' }}><Megaphone size={18} style={{ color: C.indigoLight }} /> Multi-Channel Broadcast</h3>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
              <div><label style={{ ...lbl }}>Target Audience</label><select style={{ ...inp, cursor: 'pointer' }}><option>All Users (12,842)</option><option>Free Plan Only</option><option>Inactive Users</option></select></div>
              <div>
                <label style={{ ...lbl }}>Channel</label>
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '10px' }}>
                  {[{ icon: Mail, label: 'Email', active: true }, { icon: AlertCircle, label: 'Push', active: false }, { icon: ShieldCheck, label: 'In-App', active: false }].map(({ icon: Icon, label, active }) => (
                    <button key={label} style={{ ...btn, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '8px', padding: '14px', background: active ? 'rgba(99,102,241,0.1)' : 'rgba(30,41,59,0.5)', color: active ? C.indigoLight : C.muted, border: `1px solid ${active ? 'rgba(99,102,241,0.3)' : C.border2}`, fontSize: '10px', textTransform: 'uppercase', letterSpacing: '0.08em' }}><Icon size={20} />{label}</button>
                  ))}
                </div>
              </div>
              <div><label style={{ ...lbl }}>Message</label><textarea rows={5} placeholder="Enter your announcement..." style={{ ...inp, resize: 'none', display: 'block' }} /></div>
              <button style={{ ...btn, background: C.indigo, color: 'white', padding: '14px', fontSize: '12px', textTransform: 'uppercase', letterSpacing: '0.12em', border: 'none' }}>Send Campaign Now</button>
            </div>
          </div>
          <div style={{ ...cs, padding: '20px' }}>
            <h4 style={{ color: C.muted, fontSize: '11px', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.1em', margin: '0 0 16px' }}>Campaign Stats</h4>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
              {[{ label: 'Emails Sent', value: '24,810', change: '+12%', up: true }, { label: 'Open Rate', value: '38.4%', change: '+2.1%', up: true }, { label: 'Click Rate', value: '9.2%', change: '-0.4%', up: false }, { label: 'Unsubscribes', value: '142', change: '+8', up: false }].map((s, i) => (
                <div key={i} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <span style={{ color: C.muted, fontSize: '13px', fontWeight: 500 }}>{s.label}</span>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                    <span style={{ color: 'white', fontWeight: 700, fontSize: '14px' }}>{s.value}</span>
                    <span style={{ fontSize: '10px', fontWeight: 700, padding: '2px 6px', background: s.up ? 'rgba(16,185,129,0.1)' : 'rgba(244,63,94,0.1)', color: s.up ? C.greenLight : C.redLight }}>{s.change}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      );
      case 'customer-care': return <CustomerCareSection />;
      case 'system-monitor': return <SystemMonitorSection />;
      default: return <div style={{ padding: '48px', textAlign: 'center', color: C.muted, fontStyle: 'italic' }}>Section coming soon...</div>;
    }
  };

  return (
    <RoleContext.Provider value={{ role: currentRole, can }}>
    <div style={{ display: 'flex', height: '100vh', background: C.bg, color: C.text, overflow: 'hidden', fontFamily: FONT }}>
      <style>{`
        * { box-sizing: border-box; scrollbar-width: none; }
        *::-webkit-scrollbar { display: none; }
      `}</style>

      {/* Mobile overlay backdrop */}
      {isMobile && sidebarOpen && (
        <div onClick={() => setSidebarOpen(false)} style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.6)', zIndex: 30 }} />
      )}

      {/* SIDEBAR — drawer on mobile, fixed on desktop */}
      <aside style={{
        width: isMobile ? '240px' : (collapsed ? '68px' : '240px'),
        background: C.sidebar,
        borderRight: `1px solid ${C.border}`,
        display: 'flex',
        flexDirection: 'column',
        flexShrink: 0,
        height: '100vh',
        position: isMobile ? 'fixed' : 'relative',
        top: 0,
        left: isMobile ? (sidebarOpen ? 0 : '-240px') : 0,
        zIndex: isMobile ? 40 : 'auto',
        transition: isMobile ? 'left 0.25s ease' : 'width 0.25s ease',
      }}>
        {/* Desktop collapse toggle button */}
        {!isMobile && (
          <button onClick={() => setCollapsed(p => !p)} style={{ position: 'absolute', right: '-12px', top: '72px', zIndex: 20, width: '24px', height: '24px', background: C.border, border: `1px solid ${C.border2}`, display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer', color: C.muted }}>
            <svg viewBox="0 0 24 24" style={{ width: '12px', height: '12px', transform: collapsed ? 'rotate(0deg)' : 'rotate(180deg)', transition: 'transform 0.3s' }} fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
        )}
        <SidebarContent />
      </aside>

      {/* MAIN */}
      <main style={{ flex: 1, overflowY: 'auto', minWidth: 0, background: 'radial-gradient(ellipse at top, #0f172a 0%, #020617 60%)' }}>
        {/* Header */}
        <header style={{ position: 'sticky', top: 0, zIndex: 10, background: 'rgba(2,6,23,0.9)', backdropFilter: 'blur(12px)', borderBottom: `1px solid ${C.border}`, padding: '12px 16px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '12px' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '12px', minWidth: 0 }}>
            {isMobile && (
              <button onClick={() => setSidebarOpen(true)} style={{ ...btn, background: 'transparent', color: C.muted, border: 'none', padding: '4px', display: 'flex', flexShrink: 0 }}>
                <Menu size={22} />
              </button>
            )}
            <h1 style={{ color: 'white', fontWeight: 700, fontSize: isMobile ? '15px' : '20px', fontFamily: FONT, letterSpacing: '0.02em', margin: 0, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{PAGE_TITLES[activeTab] || activeTab}</h1>
          </div>

          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexShrink: 0 }}>
            {/* Role Switcher */}
            <div style={{ display: 'flex', background: C.card, border: `1px solid ${C.border}`, overflow: 'hidden' }}>
              {Object.entries(ROLES).map(([key, r]) => (
                <button
                  key={key}
                  onClick={() => setCurrentRole(key)}
                  style={{ ...btn, display: 'flex', alignItems: 'center', gap: '6px', padding: isMobile ? '6px 10px' : '7px 14px', background: currentRole === key ? r.accentBg : 'transparent', color: currentRole === key ? r.accentColor : C.muted, border: 'none', fontSize: '11px', fontWeight: 700, borderRight: key === 'admin' ? `1px solid ${C.border}` : 'none', transition: 'all 0.2s' }}
                >
                  <div style={{ width: '6px', height: '6px', borderRadius: '50%', background: currentRole === key ? r.accentColor : C.dim, flexShrink: 0 }} />
                  {!isMobile && r.label}
                </button>
              ))}
            </div>

            {[Mail, Bell].map((Icon, i) => (
              <button key={i} style={{ ...btn, position: 'relative', background: 'transparent', color: C.muted, border: 'none', padding: '8px' }}>
                <Icon size={18} />
                <span style={{ position: 'absolute', top: '6px', right: '6px', width: '7px', height: '7px', borderRadius: '50%', background: C.red, border: `2px solid ${C.bg}` }} />
              </button>
            ))}
          </div>
        </header>

        {/* Bottom nav on mobile for quick access */}
        {isMobile && (
          <nav style={{ position: 'fixed', bottom: 0, left: 0, right: 0, zIndex: 20, background: C.sidebar, borderTop: `1px solid ${C.border}`, display: 'flex', padding: '0' }}>
            {[...NAV.slice(0, 3), ...(OPS.length > 0 ? [OPS[0]] : [])].filter(Boolean).map(item => (
              <button key={item.id} onClick={() => handleNavClick(item.id)} style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '4px', padding: '10px 4px', background: 'transparent', border: 'none', cursor: 'pointer', fontFamily: FONT, position: 'relative' }}>
                <item.icon size={20} style={{ color: activeTab === item.id ? C.indigoLight : C.muted }} />
                <span style={{ color: activeTab === item.id ? C.indigoLight : C.muted, fontSize: '9px', fontWeight: 600, textTransform: 'uppercase', letterSpacing: '0.05em' }}>{item.label.split(' ')[0]}</span>
                {item.badge > 0 && <span style={{ position: 'absolute', top: '6px', right: '22%', background: C.red, color: 'white', fontSize: '8px', fontWeight: 700, padding: '1px 4px', borderRadius: '999px' }}>{item.badge}</span>}
              </button>
            ))}
          </nav>
        )}

        <section style={{ padding: isMobile ? '16px 12px 80px' : '24px 28px' }}>
          {renderContent()}
        </section>
      </main>
    </div>
    </RoleContext.Provider>
  );
}
