  const completedTabs = {
    post:   !!form.title.trim(),
    signal: !!(form.signal.pair && form.signal.entry && form.signal.sl && form.signal.tp1),
    author: !!form.authorName.trim(),
    media:  !!form.youtubeUrl.trim(),
    share:  form.shareOn.length > 0,
