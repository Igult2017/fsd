                <div className={`px-5 py-3 flex items-center justify-between ${isBuy ? 'bg-emerald-500/10' : 'bg-rose-500/10'}`}>
                  <div className="flex items-center gap-3">
                    <span className={`text-xl font-black tracking-tight ${isBuy ? 'text-emerald-400' : 'text-rose-400'}`}>{sig.pair}</span>
                    <span className={`text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest ${isBuy ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white'}`}>{sig.action}</span>
                    <span className="text-[10px] text-slate-500 font-bold bg-slate-800 px-2 py-0.5 rounded">{sig.timeframe}</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className={`text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border ${post.status === 'Published' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' : 'bg-slate-700 text-slate-400 border-slate-600'}`}>{post.status}</span>
                    <span className="text-xs text-slate-600">{post.date}</span>
                  </div>
                </div>

                <div className="p-5">
                  {/* Entry / SL / TP grid */}
                  <div className="grid grid-cols-4 gap-2 mb-4">
                    {[
                      { label: 'Entry', value: sig.entry, color: 'text-white' },
                      { label: 'Stop Loss', value: sig.sl, color: 'text-rose-400' },
                      { label: 'TP 1', value: sig.tp1, color: 'text-emerald-400' },
                      { label: 'TP 2', value: sig.tp2 || '—', color: sig.tp2 ? 'text-emerald-300' : 'text-slate-600' },
                    ].map(({ label, value, color }) => (
                      <div key={label} className="bg-slate-800/60 rounded-lg px-3 py-2.5 text-center">
                        <p className="text-[9px] font-black uppercase tracking-widest text-slate-500 mb-1">{label}</p>
                        <p className={`text-sm font-black ${color}`}>{value}</p>
