                  {tab.label}
                  {completedTabs[tab.id] && (
                    <span className="absolute -top-1 -right-1 w-3 h-3 bg-emerald-500 rounded-full border-2 border-slate-900" />
                  )}
                </button>
              ))}
            </div>

            {/* Scrollable body */}
            <div className="flex-1 overflow-y-auto px-7 py-6 min-h-0">

              {/* ── TAB: POST ── */}
              {modalTab === 'post' && (
                <div className="space-y-5">
                  <div>
                    <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Post Title</label>
                    <input value={f('title')} onChange={e => set('title', e.target.value)}
                      className="w-full bg-slate-800 border border-slate-700 focus:border-indigo-500 outline-none text-white rounded-lg px-4 py-3 text-sm font-semibold placeholder:text-slate-600"
                      placeholder={f('section') === 'trade-signals' ? 'e.g. EUR/USD Buy Signal — H4 Breakout' : 'Enter post title...'} />
                  </div>
                  <div>
                    <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Publish Destination</label>
                    <div className="grid grid-cols-1 gap-3">
                      {Object.entries(SECTION_META).map(([key, meta]) => (
                        <button key={key} onClick={() => handleSectionChange(key)}
                          className={`flex items-center gap-3 p-4 rounded-xl border text-left transition-all ${f('section') === key ? `${meta.bg} ${meta.border} ${meta.color}` : 'bg-slate-800/50 border-slate-700 text-slate-400 hover:border-slate-500'}`}>
                          <div className={`w-2.5 h-2.5 rounded-full flex-shrink-0 ${meta.dot}`} />
                          <div className="flex-1">
                            <p className="text-xs font-black">{meta.label}</p>
                            <p className="text-[10px] opacity-60 mt-0.5">
                              {key === 'blog' ? 'General articles & market recaps' : key === 'verified-strategies' ? 'Curated trade strategies' : 'Live BUY / SELL trade signals'}
                            </p>
                          </div>
                          {f('section') === key && <CheckCircle size={14} className="ml-auto flex-shrink-0" />}
                        </button>
                      ))}
                    </div>
                  </div>
                  <div>
                    <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Publish Status</label>
                    <div className="flex gap-3">
                      {['Draft', 'Published'].map(s => (
                        <button key={s} onClick={() => set('status', s)}
                          className={`flex-1 py-2.5 rounded-lg text-xs font-black uppercase tracking-widest border transition-all ${f('status') === s
                            ? s === 'Published' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-slate-700 border-slate-600 text-white'
                            : 'bg-transparent border-slate-700 text-slate-500 hover:border-slate-500'}`}>{s}</button>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {/* ── TAB: SIGNAL ── */}
              {modalTab === 'signal' && (
                <div className="space-y-5">
                  {/* BUY / SELL toggle */}
                  <div>
                    <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Signal Direction</label>
                    <div className="grid grid-cols-2 gap-3">
                      {['BUY', 'SELL'].map(action => (
                        <button key={action} onClick={() => setSignal('action', action)}
                          className={`py-4 rounded-xl border font-black text-lg tracking-tight transition-all ${sg('action') === action
                            ? action === 'BUY' ? 'bg-emerald-500/15 border-emerald-500/40 text-emerald-400' : 'bg-rose-500/15 border-rose-500/40 text-rose-400'
                            : 'bg-slate-800/50 border-slate-700 text-slate-500 hover:border-slate-600'}`}>
                          {action === 'BUY' ? '▲ BUY' : '▼ SELL'}
                        </button>
                      ))}
                    </div>
                  </div>

                  {/* Pair + Market + Timeframe row */}
                  <div className="grid grid-cols-3 gap-3">
                    <div>
                      <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Pair / Asset</label>
                      <input value={sg('pair')} onChange={e => setSignal('pair', e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 focus:border-indigo-500 outline-none text-white rounded-lg px-3 py-2.5 text-sm font-bold placeholder:text-slate-600 uppercase"
                        placeholder="EUR/USD" />
                    </div>
                    <div>
                      <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Market</label>
                      <select value={sg('market')} onChange={e => setSignal('market', e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 focus:border-indigo-500 outline-none text-white rounded-lg px-3 py-2.5 text-sm font-bold">
                        {['Forex', 'Crypto', 'Stocks', 'Commodities', 'Indices'].map(m => <option key={m}>{m}</option>)}
                      </select>
                    </div>
                    <div>
                      <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Timeframe</label>
                      <select value={sg('timeframe')} onChange={e => setSignal('timeframe', e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 focus:border-indigo-500 outline-none text-white rounded-lg px-3 py-2.5 text-sm font-bold">
                        {['M5','M15','M30','H1','H4','D1','W1'].map(t => <option key={t}>{t}</option>)}
                      </select>
                    </div>
                  </div>

                  {/* Entry / SL */}
                  <div className="grid grid-cols-2 gap-3">
                    <div>
                      <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Entry Price</label>
                      <input value={sg('entry')} onChange={e => setSignal('entry', e.target.value)}
                        className="w-full bg-slate-800 border border-slate-700 focus:border-indigo-500 outline-none text-white rounded-lg px-3 py-2.5 text-sm font-mono font-bold placeholder:text-slate-600"
                        placeholder="1.0632" />
                    </div>
                    <div>
                      <label className="block text-[10px] font-black uppercase tracking-widest text-rose-500/70 mb-2">Stop Loss</label>
                      <input value={sg('sl')} onChange={e => setSignal('sl', e.target.value)}
                        className="w-full bg-slate-800 border border-rose-500/20 focus:border-rose-500 outline-none text-rose-300 rounded-lg px-3 py-2.5 text-sm font-mono font-bold placeholder:text-slate-600"
                        placeholder="1.0589" />
                    </div>
                  </div>

                  {/* TP 1 / 2 / 3 */}
                  <div>
                    <label className="block text-[10px] font-black uppercase tracking-widest text-emerald-500/70 mb-2">Take Profit Levels</label>
                    <div className="grid grid-cols-3 gap-3">
                      {['tp1','tp2','tp3'].map((tp, i) => (
                        <div key={tp}>
                          <label className="block text-[9px] font-black uppercase text-slate-600 mb-1">TP {i+1}{i > 0 ? ' (opt)' : ' *'}</label>
                          <input value={sg(tp)} onChange={e => setSignal(tp, e.target.value)}
                            className="w-full bg-slate-800 border border-emerald-500/20 focus:border-emerald-500 outline-none text-emerald-300 rounded-lg px-3 py-2.5 text-sm font-mono font-bold placeholder:text-slate-600"
                            placeholder={i === 0 ? '1.0685' : i === 1 ? '1.0740' : '1.0800'} />
                        </div>
