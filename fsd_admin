                      <div className={`w-2 h-2 mt-1.5 rounded-full ${act.type === 'error' ? 'bg-rose-500' : 'bg-indigo-500'}`} />
                      <div>
                        <p className="text-slate-300 font-medium">{act.text}</p>
                        <p className="text-slate-500 text-xs mt-0.5">{act.time}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        );

      case 'users':
        return (
          <div className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
            <div className="p-6 border-b border-slate-800 flex flex-col md:flex-row justify-between gap-4">
              <div className="relative">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" size={18} />
                <input type="text" placeholder="Search traders..." className="bg-slate-800 text-white pl-10 pr-4 py-2 rounded-lg border border-slate-700 focus:outline-none focus:border-indigo-500 w-full md:w-64 text-sm font-medium" />
              </div>
              <button className="flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg transition-colors text-sm font-bold">
                <UserPlus size={18} /> Add User
              </button>
            </div>
            <table className="w-full text-left">
              <thead className="bg-slate-800/50 text-slate-400 text-[11px] uppercase font-bold tracking-widest">
                <tr>
                  <th className="px-6 py-4">User</th><th className="px-6 py-4">Plan</th><th className="px-6 py-4">Status</th>
                  <th className="px-6 py-4 text-center">Win Rate</th><th className="px-6 py-4">Last Login</th><th className="px-6 py-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800">
                {MOCK_USERS.map(user => (
                  <tr key={user.id} className="text-slate-300 hover:bg-slate-800/30 transition-colors">
                    <td className="px-6 py-4"><div className="font-semibold text-white text-sm">{user.name}</div><div className="text-xs text-slate-500 mt-0.5">{user.email}</div></td>
                    <td className="px-6 py-4"><span className={`px-2 py-0.5 rounded text-[10px] font-black uppercase ${user.plan === 'Enterprise' ? 'bg-amber-500/10 text-amber-400' : 'bg-slate-700 text-slate-300'}`}>{user.plan}</span></td>
                    <td className="px-6 py-4"><div className="flex items-center gap-2 text-xs font-bold uppercase"><div className={`w-1.5 h-1.5 rounded-full ${user.status === 'Active' ? 'bg-emerald-500' : user.status === 'Banned' ? 'bg-rose-500' : 'bg-slate-500'}`} />{user.status}</div></td>
                    <td className="px-6 py-4 font-mono text-sm text-center font-bold text-indigo-400">{user.winRate}</td>
                    <td className="px-6 py-4 text-slate-500 text-xs font-medium">{user.lastLogin}</td>
                    <td className="px-6 py-4 text-right"><button className="text-slate-500 hover:text-white"><MoreVertical size={18} /></button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );

      case 'blog':
        return <BlogSection />;


      case 'marketing':
        return (
          <div className="max-w-4xl space-y-8">
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-8">
              <h3 className="text-xl font-black text-white mb-6 flex items-center gap-2 tracking-tight"><Megaphone className="text-indigo-400" /> Multi-Channel Broadcast</h3>
              <div className="space-y-4">
                <div>
                  <label className="block text-xs font-black uppercase tracking-widest text-slate-500 mb-2">Target Audience</label>
                  <select className="w-full bg-slate-800 border border-slate-700 text-white rounded-lg p-3 outline-none focus:border-indigo-500 text-sm font-bold">
                    <option>All Users (12,842)</option><option>Free Plan Only</option><option>Inactive Users</option><option>Pro Traders</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-black uppercase tracking-widest text-slate-500 mb-2">Communication Method</label>
                  <div className="grid grid-cols-3 gap-3">
                    <button className="flex flex-col items-center gap-2 p-4 border border-indigo-500/50 bg-indigo-500/10 rounded-xl text-indigo-400"><Mail size={24} /><span className="text-[10px] font-black uppercase tracking-widest">Email</span></button>
                    <button className="flex flex-col items-center gap-2 p-4 border border-slate-700 bg-slate-800/50 rounded-xl text-slate-400 hover:border-slate-500"><AlertCircle size={24} /><span className="text-[10px] font-black uppercase tracking-widest">Push</span></button>
                    <button className="flex flex-col items-center gap-2 p-4 border border-slate-700 bg-slate-800/50 rounded-xl text-slate-400 hover:border-slate-500"><ShieldCheck size={24} /><span className="text-[10px] font-black uppercase tracking-widest">In-App</span></button>
                  </div>
                </div>
                <div>
                  <label className="block text-xs font-black uppercase tracking-widest text-slate-500 mb-2">Message Content</label>
                  <textarea rows="4" className="w-full bg-slate-800 border border-slate-700 text-white rounded-lg p-3 outline-none focus:border-indigo-500 placeholder:text-slate-600 text-sm font-medium" placeholder="Enter your announcement or promo code here..."></textarea>
                </div>
                <button className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-lg shadow-lg transition-all uppercase tracking-[0.2em] text-xs">Send Campaign Now</button>
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="bg-slate-900/50 border border-slate-800 p-6 rounded-xl flex items-center justify-between hover:border-slate-600 transition-colors cursor-pointer group">
                <div><h4 className="text-white font-bold">Active Promos</h4><p className="text-slate-500 text-xs font-semibold">SUMMER25 - 25% off Yearly</p></div>
                <ChevronRight className="text-slate-600 group-hover:text-white transition-colors" />
              </div>
              <div className="bg-slate-900/50 border border-slate-800 p-6 rounded-xl flex items-center justify-between hover:border-slate-600 transition-colors cursor-pointer group">
                <div><h4 className="text-white font-bold">Email Templates</h4><p className="text-slate-500 text-xs font-semibold">6 Saved layouts</p></div>
                <ChevronRight className="text-slate-600 group-hover:text-white transition-colors" />
              </div>
            </div>
          </div>
        );

      case 'customer-care':
        return <CustomerCareSection />;

      case 'system-monitor':
        return <SystemMonitorSection />;

      default:
        return <div className="p-12 text-center text-slate-500 italic font-medium">Section coming soon...</div>;
    }
  };

  const pageTitle = {
    dashboard: 'Overview', users: 'User Accounts', analytics: 'Trade Analysis',
    blog: 'Blogpost', marketing: 'Marketing', 'customer-care': 'Customer Care',
    'system-monitor': 'System Monitor', settings: 'System Settings'
  };

  return (
    <div className="flex h-screen bg-slate-950 text-slate-100 overflow-hidden" style={{ fontFamily: "'Inter', ui-sans-serif, system-ui, sans-serif" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
        * { scrollbar-width: none; -ms-overflow-style: none; }
        *::-webkit-scrollbar { display: none; }
      `}</style>

      {/* Sidebar */}
      <aside className="w-64 bg-slate-900 border-r border-slate-800 flex flex-col flex-shrink-0 h-screen">
        {/* Logo — fixed at top */}
        <div className="flex-shrink-0 px-6 pt-6 pb-4">
          <div className="flex items-center gap-3">
            <div className="bg-indigo-600 p-2 rounded-lg shadow-inner"><LayoutDashboard size={24} className="text-white" /></div>
            <span className="font-black text-xl tracking-tighter text-white uppercase">FSD ADMIN</span>
          </div>
        </div>

        {/* Nav — scrollable middle */}
        <div className="flex-1 overflow-y-auto px-6 py-2 min-h-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          <nav className="space-y-1">
            <SidebarItem id="dashboard" label="Overview" icon={LayoutDashboard} active={activeTab === 'dashboard'} onClick={setActiveTab} />
            <SidebarItem id="users" label="User Accounts" icon={Users} active={activeTab === 'users'} onClick={setActiveTab} />
            <SidebarItem id="analytics" label="Trade Analysis" icon={LineChart} active={activeTab === 'analytics'} onClick={setActiveTab} />
            <SidebarItem id="blog" label="Blogpost" icon={FileText} active={activeTab === 'blog'} onClick={setActiveTab} />
            <SidebarItem id="marketing" label="Marketing" icon={Megaphone} active={activeTab === 'marketing'} onClick={setActiveTab} />

            <div className="pt-3 pb-1"><div className="h-px bg-slate-800" /></div>
            <p className="text-[9px] font-black uppercase tracking-widest text-slate-600 px-4 pb-1">Operations</p>

            <SidebarItem id="customer-care" label="Customer Care" icon={HeadphonesIcon} active={activeTab === 'customer-care'} onClick={setActiveTab} badge={openTickets} />
            <SidebarItem id="system-monitor" label="System Monitor" icon={Activity} active={activeTab === 'system-monitor'} onClick={setActiveTab} />

            <div className="pt-3 pb-1"><div className="h-px bg-slate-800" /></div>

            <SidebarItem id="settings" label="System Settings" icon={Settings} active={activeTab === 'settings'} onClick={setActiveTab} />
          </nav>
        </div>

        {/* Admin profile — always pinned at bottom */}
        <div className="flex-shrink-0 p-4 border-t border-slate-800 bg-slate-900">
          <div className="flex items-center gap-3 p-3 bg-slate-800 hover:bg-slate-700/80 rounded-xl cursor-pointer transition-colors group">
            <div className="relative flex-shrink-0">
              <div className="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center font-black text-xs text-white shadow-lg">AD</div>
              <div className="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full border-2 border-slate-800" />
            </div>
            <div className="flex-1 min-w-0">
              <p className="text-sm font-bold text-white truncate">Admin User</p>
              <p className="text-[10px] text-indigo-400 font-black uppercase tracking-widest">Super Admin</p>
            </div>
            <Settings size={14} className="text-slate-600 group-hover:text-slate-400 transition-colors flex-shrink-0" />
          </div>
        </div>
      </aside>

      {/* Main */}
      <main className="flex-1 overflow-y-auto bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-slate-950">
        <header className="sticky top-0 z-10 bg-slate-950/80 backdrop-blur-md border-b border-slate-800 px-8 py-4 flex justify-between items-center">
          <h1 className="text-xl font-black capitalize tracking-tight">{pageTitle[activeTab] || activeTab}</h1>
          <div className="flex items-center gap-4">
            <button className="relative p-2 text-slate-400 hover:text-white transition-colors">
              <Mail size={20} />
              <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-rose-500 rounded-full border-2 border-slate-950" />
            </button>
            <button className="relative p-2 text-slate-400 hover:text-white transition-colors">
              <Bell size={20} />
              <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-rose-600 rounded-full border-2 border-slate-950" />
            </button>
          </div>
        </header>
        <section className="p-8">{renderContent()}</section>
      </main>
    </div>
  );
}
