              </div>
            </div>
          );

          if (isSignalCard) {
            const isBuy = sig.action === 'BUY';
            return (
              <div key={post.id} className={`bg-slate-900 border hover:border-slate-600 rounded-xl overflow-hidden transition-all group ${isBuy ? 'border-emerald-500/20' : 'border-rose-500/20'}`}>
