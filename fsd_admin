            {tab.id !== 'all' && <div className={`w-1.5 h-1.5 rounded-full ${SECTION_META[tab.id]?.dot}`} />}
            {tab.label}
            <span className={`text-[10px] font-black px-1.5 py-0.5 rounded-full ${activeSection === tab.id ? 'bg-white/20 text-white' : 'bg-slate-800 text-slate-500'}`}>{tab.count}</span>
          </button>
