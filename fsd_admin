                        <span className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm font-black">1:</span>
                        <input value={sg('rr')} onChange={e => setSignal('rr', e.target.value)}
                          className="w-full bg-slate-800 border border-slate-700 focus:border-indigo-500 outline-none text-indigo-300 rounded-lg pl-8 pr-3 py-2.5 text-sm font-mono font-bold placeholder:text-slate-600"
                          placeholder="2.5" />
                      </div>
                    </div>
                    <div>
                      <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Confidence Level</label>
                      <div className="grid grid-cols-3 gap-1">
                        {['High','Medium','Low'].map(c => (
                          <button key={c} onClick={() => setSignal('confidence', c)}
                            className={`py-2.5 rounded-lg text-[10px] font-black uppercase tracking-wide border transition-all ${sg('confidence') === c
                              ? c === 'High' ? 'bg-emerald-500/15 border-emerald-500/40 text-emerald-400'
                                : c === 'Medium' ? 'bg-amber-500/15 border-amber-500/40 text-amber-400'
                                : 'bg-slate-700 border-slate-600 text-slate-300'
                              : 'bg-transparent border-slate-700 text-slate-500 hover:border-slate-600'}`}>{c}</button>
                        ))}
                      </div>
                    </div>
                  </div>

                  {/* Rationale */}
                  <div>
                    <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Trade Rationale</label>
