                  {(sg('pair') || sg('entry')) && (
                    <div>
                      <label className="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Preview</label>
                      <div className={`rounded-xl overflow-hidden border ${sg('action') === 'BUY' ? 'border-emerald-500/20' : 'border-rose-500/20'}`}>
                        <div className={`px-4 py-2.5 flex items-center gap-3 ${sg('action') === 'BUY' ? 'bg-emerald-500/10' : 'bg-rose-500/10'}`}>
                          <span className={`font-black ${sg('action') === 'BUY' ? 'text-emerald-400' : 'text-rose-400'}`}>{sg('pair') || '—'}</span>
                          <span className={`text-xs font-black px-2 py-0.5 rounded-full uppercase ${sg('action') === 'BUY' ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white'}`}>{sg('action')}</span>
                          <span className="text-[10px] text-slate-500 bg-slate-800 px-2 py-0.5 rounded font-bold">{sg('timeframe')}</span>
                        </div>
                        <div className="px-4 py-3 grid grid-cols-4 gap-2 bg-slate-900">
                          {[['Entry', sg('entry'), 'text-white'], ['SL', sg('sl'), 'text-rose-400'], ['TP1', sg('tp1'), 'text-emerald-400'], ['R:R', sg('rr') ? '1:'+sg('rr') : '—', 'text-indigo-400']].map(([l,v,c]) => (
                            <div key={l} className="text-center">
                              <p className="text-[9px] text-slate-600 font-black uppercase">{l}</p>
                              <p className={`text-sm font-black ${c}`}>{v || '—'}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
