                  </div>

                  {/* R:R + Confidence + Market row */}
                  <div className="flex items-center gap-3 mb-3">
                    <div className="flex items-center gap-1.5 bg-slate-800 px-3 py-1.5 rounded-lg">
                      <span className="text-slate-500 text-[10px] font-black uppercase">R:R</span>
                      <span className="text-indigo-400 font-black text-sm">1:{sig.rr}</span>
                    </div>
                    <div className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-wider
                      ${sig.confidence === 'High' ? 'bg-emerald-500/10 text-emerald-400' : sig.confidence === 'Medium' ? 'bg-amber-500/10 text-amber-400' : 'bg-slate-700 text-slate-400'}`}>
                      <div className={`w-1.5 h-1.5 rounded-full ${sig.confidence === 'High' ? 'bg-emerald-500' : sig.confidence === 'Medium' ? 'bg-amber-500' : 'bg-slate-500'}`} />
