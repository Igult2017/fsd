          <span className={`font-black text-sm uppercase tracking-widest ${overallHealth ? 'text-emerald-400' : 'text-rose-400'}`}>
            {overallHealth ? 'All Systems Operational' : 'Degraded Performance Detected'}
          </span>
        </div>
        <div className="flex items-center gap-3">
          <span className="text-slate-500 text-xs font-bold">Uptime: <span className="text-emerald-400">{metrics.uptime}%</span></span>
          <button onClick={() => setIsLive(p => !p)}
            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-widest transition-all ${isLive ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-slate-800 text-slate-400 border border-slate-700'}`}>
            <RefreshCw size={11} className={isLive ? 'animate-spin' : ''} style={{ animationDuration: '3s' }} />
            {isLive ? 'Live' : 'Paused'}
          </button>
        </div>
      </div>

      {/* Primary Metrics Grid */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { label: 'CPU Usage', value: metrics.cpu, unit: '%', history: history.cpu, icon: Cpu, danger: metrics.cpu > 80 },
          { label: 'Memory', value: metrics.memory, unit: '%', history: history.memory, icon: Database, danger: metrics.memory > 85 },
          { label: 'Avg Latency', value: metrics.latency, unit: 'ms', history: history.latency, icon: Zap, danger: metrics.latency > 100 },
          { label: 'Requests/sec', value: metrics.requestsPerSec, unit: '', history: history.requests, icon: Activity, danger: false },
        ].map((m, i) => (
          <div key={i} className={`bg-slate-900 border rounded-xl p-5 ${m.danger ? 'border-rose-500/30' : 'border-slate-800'}`}>
            <div className="flex items-center justify-between mb-3">
              <div className={`p-2 rounded-lg ${m.danger ? 'bg-rose-500/10' : 'bg-slate-800'}`}>
                <m.icon size={16} className={m.danger ? 'text-rose-400' : 'text-slate-400'} />
              </div>
              <div className="relative flex items-center justify-center">
                <GaugeRing value={m.unit === '%' ? m.value : Math.min((m.value / (m.label === 'Avg Latency' ? 200 : 2000)) * 100, 100)} color="#6366f1" size={44} strokeWidth={5} />
                <span className={`absolute text-[9px] font-black ${m.danger ? 'text-rose-400' : 'text-slate-400'}`}>
                  {m.unit === '%' ? m.value : ''}
                </span>
              </div>
            </div>
            <p className={`text-2xl font-black tracking-tight ${m.danger ? 'text-rose-400' : 'text-white'}`}>
              {m.value}<span className="text-sm font-bold ml-0.5 text-slate-500">{m.unit}</span>
            </p>
            <p className="text-slate-500 text-[10px] font-black uppercase tracking-widest mt-1">{m.label}</p>
            <div className="mt-3">
              <Sparkline data={m.history} danger={m.danger} />
            </div>
          </div>
        ))}
      </div>

      {/* Secondary Metrics + Services */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-1 space-y-3">
          <h3 className="text-white font-black text-sm uppercase tracking-widest">Service Status</h3>
          {[
            { name: 'Trade Engine', status: 'operational', latency: '18ms' },
            { name: 'Binance API', status: 'degraded', latency: '340ms' },
            { name: 'Auth Service', status: 'operational', latency: '12ms' },
            { name: 'Payment SVC', status: 'degraded', latency: '210ms' },
            { name: 'DB Cluster', status: 'operational', latency: '8ms' },
            { name: 'Cache Layer', status: 'operational', latency: '2ms' },
            { name: 'CDN Edge', status: 'operational', latency: '6ms' },
          ].map((svc, i) => (
            <div key={i} className={`flex items-center justify-between px-4 py-2.5 rounded-lg border ${svc.status === 'degraded' ? 'bg-amber-500/5 border-amber-500/20' : 'bg-slate-900 border-slate-800'}`}>
              <div className="flex items-center gap-2.5">
                <div className={`w-1.5 h-1.5 rounded-full ${svc.status === 'operational' ? 'bg-emerald-500' : svc.status === 'degraded' ? 'bg-amber-500 animate-pulse' : 'bg-rose-500 animate-pulse'}`} />
                <span className="text-slate-300 text-xs font-semibold">{svc.name}</span>
              </div>
              <div className="flex items-center gap-2">
                <span className="text-slate-600 text-[10px] font-mono">{svc.latency}</span>
                <span className={`text-[9px] font-black uppercase ${svc.status === 'operational' ? 'text-emerald-500' : 'text-amber-500'}`}>{svc.status}</span>
              </div>
            </div>
          ))}
          {/* Extra mini-metrics */}
          <div className="grid grid-cols-2 gap-3 pt-2">
            {[
              { label: 'Error Rate', value: metrics.errorRate + '%', ok: metrics.errorRate < 1 },
              { label: 'DB Query', value: metrics.dbQueryTime + 'ms', ok: metrics.dbQueryTime < 50 },
              { label: 'Connections', value: metrics.activeConnections.toLocaleString(), ok: true },
              { label: 'Active Logs', value: errorCount + ' err', ok: errorCount === 0 },
            ].map((m, i) => (
              <div key={i} className="bg-slate-900 border border-slate-800 rounded-lg px-3 py-2.5">
                <p className={`text-base font-black tracking-tight ${m.ok ? 'text-white' : 'text-rose-400'}`}>{m.value}</p>
                <p className="text-slate-600 text-[9px] font-black uppercase tracking-widest mt-0.5">{m.label}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Live Log Feed */}
        <div className="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
          <div className="px-5 py-4 border-b border-slate-800 flex items-center justify-between">
            <div className="flex items-center gap-3">
              <h3 className="text-white font-black tracking-tight">Live Event Log</h3>
              {errorCount > 0 && <span className="bg-rose-500/15 text-rose-400 border border-rose-500/20 text-[9px] font-black uppercase px-2 py-0.5 rounded-full">{errorCount} errors</span>}
              {warnCount > 0 && <span className="bg-amber-500/15 text-amber-400 border border-amber-500/20 text-[9px] font-black uppercase px-2 py-0.5 rounded-full">{warnCount} warnings</span>}
            </div>
            <button onClick={clearResolved} className="text-slate-500 hover:text-slate-300 text-[10px] font-black uppercase tracking-widest flex items-center gap-1 transition-colors">
              <Trash2 size={11} /> Clear Resolved
            </button>
          </div>
          <div className="h-[420px] overflow-y-auto font-mono">
            {logs.filter(l => !resolvedIds.has(l.id)).map(log => (
              <div key={log.id} className={`flex items-start gap-3 px-5 py-3 border-b border-slate-800/60 hover:bg-slate-800/20 transition-colors group`}>
                <div className={`w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0 ${levelDot[log.level]} ${log.level !== 'info' ? 'animate-pulse' : ''}`} />
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-2 mb-0.5">
                    <span className="text-slate-600 text-[10px]">{log.time}</span>
                    <span className={`text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded ${levelStyle[log.level]}`}>{log.level}</span>
                    <span className="text-slate-500 text-[10px] font-bold">{log.service}</span>
                  </div>
                  <p className="text-slate-300 text-xs leading-relaxed">{log.message}</p>
                </div>
                {log.level !== 'info' && (
                  <button onClick={() => resolveLog(log.id)}
                    className="opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0 p-1 text-slate-600 hover:text-emerald-400 rounded hover:bg-emerald-500/10"
                    title="Mark resolved">
                    <CheckCircle size={14} />
                  </button>
                )}
              </div>
            ))}
            {logs.filter(l => !resolvedIds.has(l.id)).length === 0 && (
              <div className="flex flex-col items-center justify-center h-32 text-slate-700">
                <CheckCircle size={28} className="text-emerald-700 mb-2" />
                <p className="text-sm font-bold text-slate-600">All clear — no active incidents</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};

