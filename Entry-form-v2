  screenshot: null,
  screenshotTimestamp: '',
  instrument: '',
  direction: 'Long',
  lotSize: '',
  entryPrice: '',
  stopLoss: '',
  stopLossDistancePips: '',
  takeProfit: '',
  takeProfitDistancePips: '',
  entryTime: '',
  exitTime: '',
  tradeDuration: '',
  dayOfWeek: 'Monday',
  outcome: 'Win',
  profitLoss: '',
  accountBalance: '',
