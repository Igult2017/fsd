        {LOT_MODES.map(m => (
          <LotModeBtn
            key={m.key} label={m.label} desc={m.desc}
            selected={mode === m.key}
            onClick={() => setData({ ...data, lotMode: m.key })}
          />
        ))}
      </div>

      {mode === "multiplier" && (
        <div style={css.field}>
          <label style={css.label}>Lot Multiplier</label>
          <div style={{ display: "flex", alignItems: "center", gap: 14 }}>
            <input
              type="range" min={0.01} max={5} step={0.01}
              value={data.lotMult || 1}
              onChange={e => setData({ ...data, lotMult: parseFloat(e.target.value) })}
              style={{ flex: 1 }}
            />
            <span style={{
              fontFamily: T.mono, fontWeight: 800, fontSize: 17,
              minWidth: 52, color: T.cyan, textAlign: "right",
            }}>
              {(data.lotMult || 1).toFixed(2)}x
            </span>
          </div>
          <div style={{ fontSize: 11, color: T.muted, marginTop: 6 }}>
            Master trades 1.00 lot → Slave trades {(data.lotMult || 1).toFixed(2)} lot
          </div>
        </div>
      )}

      {mode === "fixed" && (
        <div style={css.field}>
          <label style={css.label}>Fixed Lot Size</label>
          <input
            type="number" style={css.input} min={0.01} step={0.01} placeholder="0.10"
            value={data.fixedLot || ""}
            onChange={e => setData({ ...data, fixedLot: e.target.value })}
          />
        </div>
      )}

      {(mode === "risk_pct" || mode === "risk_sl") && (
        <div style={css.field}>
          <label style={css.label}>Risk % per trade (of slave balance)</label>
          <div style={{ display: "flex", gap: 12, alignItems: "center" }}>
            <input
              type="number" style={css.input} min={0.1} max={10} step={0.1} placeholder="1.0"
              value={data.riskPct || ""}
              onChange={e => setData({ ...data, riskPct: e.target.value })}
            />
            <span style={{ lineHeight: "38px", color: T.dimmed, fontWeight: 600 }}>%</span>
          </div>
        </div>
      )}

      {mode === "proportional" && (
        <div style={css.info}>
          The copier automatically scales lot sizes based on the balance ratio between slave and master accounts.
          E.g. if master is $10,000 and slave is $5,000, lots are halved.
        </div>
      )}

      <div style={css.divider} />
      <div style={css.sectionTitle}>Risk Guardrails</div>

      <div style={css.row3}>
        {[
          { label: "Max Open Trades",   key: "maxTrades", placeholder: "10",  help: "Max simultaneous copied trades" },
          { label: "Max Lot per Trade", key: "maxLot",    placeholder: "1.00", help: "Single trade size ceiling" },
          { label: "Max Daily Loss ($)",key: "maxLoss",   placeholder: "200",  help: "Auto-pause when hit" },
        ].map(f => (
          <div key={f.key} style={css.field}>
            <label style={css.label}>{f.label}</label>
            <input
              type="number" style={css.input} placeholder={f.placeholder}
              value={data[f.key] || ""}
              onChange={e => setData({ ...data, [f.key]: e.target.value })}
            />
            <div style={{ fontSize: 10, color: T.muted, marginTop: 5 }}>{f.help}</div>
          </div>
        ))}
      </div>

      <div style={css.field}>
        <label style={css.label}>Copy Direction</label>
        <select
          style={css.select}
          value={data.copyDir || "all"}
          onChange={e => setData({ ...data, copyDir: e.target.value })}
        >
          <option value="all">Copy All — BUY and SELL</option>
          <option value="buy">BUY orders only</option>
          <option value="sell">SELL orders only</option>
          <option value="reverse">Reverse copy (BUY→SELL, SELL→BUY)</option>
        </select>
      </div>

      <div style={{ borderTop: `1px solid ${T.border}`, paddingTop: 16 }}>
        <Toggle
          label="Copy Stop Loss & Take Profit"
          sub="Replicate SL/TP exactly from master"
          on={data.copySLTP !== false}
          onChange={v => setData({ ...data, copySLTP: v })}
        />
        <Toggle
          label="Copy Pending Orders (Limit / Stop)"
          sub="Also copy limit and stop pending orders"
          on={data.copyPending || false}
          onChange={v => setData({ ...data, copyPending: v })}
        />
        <Toggle
          label="Sync partial closes"
          sub="Close partial positions when master does"
          on={data.syncPartial !== false}
          onChange={v => setData({ ...data, syncPartial: v })}
        />
      </div>
    </div>
  );
}

/* ── STEP 5 — FILTERS & PROTECTION ────────────────────────── */
function StepProtect({ data, setData }) {
  const [symInput, setSymInput] = useState("");

  const addSym = () => {
    if (!symInput.trim()) return;
    const list = data.symList || [];
    if (!list.includes(symInput.trim().toUpperCase())) {
      setData({ ...data, symList: [...list, symInput.trim().toUpperCase()] });
    }
    setSymInput("");
  };

  const removeSym = (s) =>
    setData({ ...data, symList: (data.symList || []).filter(x => x !== s) });

  return (
    <div>
      <div style={css.panelTitle}>Filters & Account Protection</div>
      <div style={css.panelSub}>
        Control which symbols get copied and protect your slave account equity from large drawdowns.
      </div>

      <div style={css.sectionTitle}>Symbol Filter</div>
      <div style={css.field}>
        <label style={css.label}>Filter Mode</label>
        <div style={{ display: "flex", gap: 10, marginBottom: 16 }}>
          {["Off", "Whitelist (allow only)", "Blacklist (block)"].map((m, i) => {
            const val = ["off", "whitelist", "blacklist"][i];
            const active = (data.symFilter || "off") === val;
            return (
              <div
                key={val} onClick={() => setData({ ...data, symFilter: val })}
                style={{
                  flex: 1, textAlign: "center", padding: "10px 12px", borderRadius: 10,
                  cursor: "pointer",
                  background: active ? `${T.blue}22` : T.surface,
                  border: active ? `1px solid ${T.blue}` : `1px solid ${T.border}`,
                  fontSize: 12, fontWeight: 700,
                  color: active ? T.text : T.muted, transition: "all 0.15s",
                }}
              >{m}</div>
            );
          })}
        </div>
      </div>

      {(data.symFilter === "whitelist" || data.symFilter === "blacklist") && (
        <div style={css.field}>
          <label style={css.label}>
            {data.symFilter === "whitelist" ? "Allowed symbols" : "Blocked symbols"}
          </label>
          <div style={{ display: "flex", gap: 8, marginBottom: 12 }}>
            <input
              style={{ ...css.input, flex: 1, textTransform: "uppercase" }}
              placeholder="e.g. EURUSD, XAUUSD"
              value={symInput}
              onChange={e => setSymInput(e.target.value)}
              onKeyDown={e => e.key === "Enter" && addSym()}
            />
            <button style={css.btnPrimary} onClick={addSym}>Add</button>
          </div>
          <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
            {(data.symList || []).map(s => (
              <div
                key={s}
                style={{
                  display: "flex", alignItems: "center", gap: 6,
                  background: T.surface, border: `1px solid ${T.border}`,
                  borderRadius: 20, padding: "4px 12px", fontSize: 12, fontWeight: 700,
                }}
              >
                <span style={{ fontFamily: T.mono, color: T.cyan }}>{s}</span>
                <span
                  onClick={() => removeSym(s)}
                  style={{ color: T.red, cursor: "pointer", fontSize: 15, lineHeight: 1, fontWeight: 900 }}
                >×</span>
              </div>
            ))}
            {!(data.symList?.length) && (
              <span style={{ fontSize: 12, color: T.muted }}>No symbols added yet</span>
            )}
          </div>
        </div>
      )}

      <div style={{ marginBottom: 14 }}>
        <label style={css.label}>Symbol Prefix / Suffix mapping (if brokers use different names)</label>
        <div style={css.row2}>
          <div style={css.field}>
            <label style={{ ...css.label, textTransform: "none", fontSize: 11 }}>Slave symbol prefix</label>
            <input
              style={css.input} placeholder='e.g. "c" for cEURUSD'
              value={data.symPrefix || ""}
              onChange={e => setData({ ...data, symPrefix: e.target.value })}
            />
          </div>
          <div style={css.field}>
            <label style={{ ...css.label, textTransform: "none", fontSize: 11 }}>Slave symbol suffix</label>
            <input
              style={css.input} placeholder='e.g. ".m" for EURUSD.m'
              value={data.symSuffix || ""}
              onChange={e => setData({ ...data, symSuffix: e.target.value })}
            />
          </div>
        </div>
      </div>

      <div style={css.divider} />
      <div style={css.sectionTitle}>Global Account Protection</div>
      <div style={css.notice(T.amber)}>
        If equity hits these levels the copier will trigger the selected action on your slave account.
      </div>

      <div style={css.row3}>
        <div style={css.field}>
          <label style={css.label}>Equity Stop Loss ($)</label>
          <input
            type="number" style={css.input} placeholder="e.g. 4500"
            value={data.eqSL || ""}
            onChange={e => setData({ ...data, eqSL: e.target.value })}
          />
        </div>
        <div style={css.field}>
          <label style={css.label}>Equity Take Profit ($)</label>
          <input
            type="number" style={css.input} placeholder="e.g. 8000"
            value={data.eqTP || ""}
            onChange={e => setData({ ...data, eqTP: e.target.value })}
          />
        </div>
        <div style={css.field}>
          <label style={css.label}>Protection Action</label>
          <select
            style={css.select}
            value={data.protectMode || "frozen"}
            onChange={e => setData({ ...data, protectMode: e.target.value })}
          >
            <option value="frozen">Freeze — stop copying</option>
            <option value="close_only">Close Only — no new copies</option>
            <option value="sell_out">Sell Out — close all & stop</option>
          </select>
        </div>
      </div>

      <div style={css.divider} />
      <div style={css.sectionTitle}>Notifications</div>
      <Toggle
        label="Alert on disconnection"
        sub="Email when master or slave loses connection"
        on={data.notifDisconnect !== false}
        onChange={v => setData({ ...data, notifDisconnect: v })}
      />
      <Toggle
        label="Alert when trade fails to copy"
        sub="Email on order rejection or copy error"
        on={data.notifFail !== false}
        onChange={v => setData({ ...data, notifFail: v })}
      />
      <Toggle
        label="Daily P&L summary email"
        sub="End-of-day report on copied trades"
        on={data.notifDaily || false}
        onChange={v => setData({ ...data, notifDaily: v })}
      />
    </div>
  );
}

/* ── STEP 6 — GO LIVE ──────────────────────────────────────── */
function StepDone({ data }) {
  const [status, setStatus] = useState("connecting");

  useEffect(() => {
    const t1 = setTimeout(() => setStatus("verifying"), 1200);
    const t2 = setTimeout(() => setStatus("live"), 2800);
    return () => { clearTimeout(t1); clearTimeout(t2); };
  }, []);

  const stages = [
    { key: "connecting", label: "Connecting to broker server…" },
    { key: "verifying",  label: "Verifying credentials…" },
    { key: "live",       label: "Account live & copying" },
  ];
  const idx = stages.findIndex(s => s.key === status);

  return (
    <div style={{ textAlign: "center" }}>
      <div style={{ fontSize: 44, marginBottom: 14, animation: status !== "live" ? "pulse 1.2s ease-in-out infinite" : "none" }}>
        {status === "live" ? "✅" : "🔄"}
      </div>
      <div style={{ ...css.panelTitle, textAlign: "center" }}>
        {status === "live" ? "You're Live!" : "Setting up your copier…"}
      </div>
      <div style={{ ...css.panelSub, maxWidth: 460, margin: "0 auto 32px", textAlign: "center" }}>
        {status === "live"
          ? "Your copier is active. Trades from the master account will now be copied automatically."
          : "Please wait while we establish a secure connection to your broker."}
      </div>

      <div style={{ maxWidth: 420, margin: "0 auto 36px", textAlign: "left" }}>
        {stages.map((s, i) => (
          <div
            key={s.key}
            style={{
              display: "flex", alignItems: "center", gap: 14,
              padding: "12px 0",
              borderBottom: i < 2 ? `1px solid ${T.border}` : "none",
            }}
          >
            <div style={{
              width: 24, height: 24, borderRadius: "50%", flexShrink: 0,
              background: i < idx ? T.green : i === idx ? T.blue : T.border,
              display: "flex", alignItems: "center", justifyContent: "center",
              fontSize: 10, color: i < idx ? "#000" : "#fff", fontWeight: 800,
              transition: "background 0.4s",
            }}>
              {i < idx ? "✓" : i + 1}
            </div>
            <span style={{ fontSize: 13, fontWeight: i <= idx ? 600 : 400, color: i <= idx ? T.text : T.muted }}>
              {s.label}
            </span>
            {i === idx && status !== "live" && (
              <div style={{
                width: 16, height: 16, borderRadius: "50%",
                border: `2px solid ${T.blue}`, borderTopColor: "transparent",
                animation: "spin 0.75s linear infinite", marginLeft: "auto",
              }} />
            )}
          </div>
        ))}
      </div>

      {status === "live" && (
        <div style={{
          background: T.surface, border: `1px solid ${T.border}`,
          borderRadius: 14, padding: "22px 28px", maxWidth: 500,
          margin: "0 auto", textAlign: "left",
          animation: "fadeUp 0.4s ease",
        }}>
          <div style={{
            fontSize: 11, fontWeight: 800, color: T.muted,
            textTransform: "uppercase", letterSpacing: "0.07em", marginBottom: 16,
          }}>
            Setup Summary
          </div>
          {[
            ["Role", data.role === "provider" ? "Signal Provider (Master)" : data.role === "follower" ? "Follower (Slave)" : "Self-Copy (Both)"],
            ["Platform", data.platform || "MT5"],
            ["Account", data.accountName || "—"],
            ["Server", data.server || "—"],
            ["Lot Mode", LOT_MODES.find(m => m.key === (data.lotMode || "multiplier"))?.label || "—"],
            ["Copy Direction", { all: "BUY + SELL", buy: "BUY only", sell: "SELL only", reverse: "Reverse" }[data.copyDir || "all"]],
          ].map(([k, v]) => (
            <div
              key={k}
              style={{
                display: "flex", justifyContent: "space-between",
                padding: "8px 0", borderBottom: `1px solid ${T.border}`, fontSize: 13,
              }}
            >
              <span style={{ color: T.muted, fontWeight: 500 }}>{k}</span>
              <span style={{ fontWeight: 700, color: T.text }}>{v}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

/* ── MAIN APP ───────────────────────────────────────────────── */
export default function TradeCopierSetup() {
  const [step, setStep] = useState(0);
  const [data, setData] = useState({
    role: null, platform: "MT5",
    lotMode: "multiplier", lotMult: 1, copyDir: "all",
  });

  const canNext = () => {
    if (step === 0) return !!data.role;
    if (step === 1) return !!(data.login && data.password && data.server);
    return true;
  };

  const stepComponents = [
    <StepRole     data={data} setData={setData} />,
    <StepConnect  data={data} setData={setData} />,
    <StepLink     data={data} setData={setData} />,
    <StepCopy     data={data} setData={setData} />,
    <StepProtect  data={data} setData={setData} />,
    <StepDone     data={data} />,
  ];

  return (
    <div style={css.wrap}>

      {/* ── Header ── */}
      <div style={css.header}>
        <div style={css.logoBox}>TS</div>
        <div style={{ display: "flex", alignItems: "baseline", gap: 6 }}>
          <span style={css.logoName}>TradeSync</span>
          <span style={css.logoTag}>Copier Setup</span>
        </div>
      </div>

      {/* ── Stepper ── */}
      <div style={css.stepper}>
        {STEPS.map((s, i) => (
          <div
            key={s.id}
            style={css.stepBtn(i === step, i < step)}
            onClick={() => i < step && setStep(i)}
          >
            <div style={css.stepNum(i === step, i < step)}>
              {i < step ? "✓" : i + 1}
            </div>
            <div style={css.stepLabel(i === step)}>{s.label}</div>
          </div>
        ))}
      </div>

      {/* ── Panel ── */}
      <div style={css.panel} key={step}>
        {stepComponents[step]}

        {step < STEPS.length - 1 && (
          <div style={css.btnRow}>
            <button
              style={{ ...css.btnGhost, opacity: step === 0 ? 0.4 : 1 }}
              onClick={() => step > 0 && setStep(step - 1)}
              disabled={step === 0}
            >
              ← Back
            </button>
            <button
              style={{ ...css.btnPrimary, opacity: canNext() ? 1 : 0.35 }}
              onClick={() => canNext() && setStep(step + 1)}
            >
              {step === STEPS.length - 2 ? "Go Live →" : "Continue →"}
            </button>
          </div>
        )}
      </div>

      {/* ── Progress dots ── */}
      <div style={{ display: "flex", gap: 7, marginTop: 22 }}>
        {STEPS.map((_, i) => (
          <div
            key={i}
            style={{
              width: i === step ? 24 : 7, height: 7, borderRadius: 4,
              background: i <= step ? T.blue : T.border,
              transition: "all 0.35s ease",
            }}
          />
        ))}
      </div>

    </div>
  );
}
