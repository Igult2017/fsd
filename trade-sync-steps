/* ── TOGGLE ─────────────────────────────────────────────────── */
function Toggle({ on, onChange, label, sub }) {
  return (
    <div style={{
      display: "flex", justifyContent: "space-between", alignItems: "center",
      padding: "13px 0", borderBottom: `1px solid ${T.border}`,
    }}>
      <div>
        <div style={{ fontSize: 13, fontWeight: 600 }}>{label}</div>
        {sub && <div style={{ fontSize: 11, color: T.muted, marginTop: 3, fontWeight: 400 }}>{sub}</div>}
      </div>
      <div
        onClick={() => onChange(!on)}
        style={{
          width: 44, height: 25, borderRadius: 13,
          background: on ? T.blue : T.border,
          cursor: "pointer", position: "relative",
          transition: "background 0.25s", flexShrink: 0, marginLeft: 16,
