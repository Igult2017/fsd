import React, { useState } from 'react';
import { 
  Shield, 
  Settings2, 
  Link2, 
  Globe, 
  User, 
  ChevronRight, 
  ChevronLeft, 
  Plus, 
  X, 
  CheckCircle2, 
  Zap,
  Activity,
  Cpu,
  BarChart3,
  Lock
} from 'lucide-react';

/* ── UI CONSTANTS ─────────────────────────────────────────── */
const STEPS = [
  { id: "identity", label: "Identity", icon: User },
  { id: "broker", label: "Broker", icon: Globe },
  { id: "link", label: "Linkage", icon: Link2 },
  { id: "engine", label: "Engine", icon: Settings2 },
  { id: "shield", label: "Shield", icon: Shield },
  { id: "deploy", label: "Deploy", icon: Zap },
];

/* ── ATOMS ────────────────────────────────────────────────── */

const GlowButton = ({ children, onClick, active, danger }) => (
  <button 
    onClick={onClick}
    className={`relative px-6 py-3 rounded-sm font-bold text-[10px] uppercase tracking-[0.2em] transition-all duration-500 overflow-hidden border
      ${active 
        ? 'bg-blue-600 border-blue-400 text-white shadow-[0_0_20px_rgba(37,99,235,0.4)]' 
        : 'bg-transparent border-white/10 text-slate-400 hover:border-white/30 hover:text-white'
      } ${danger ? 'hover:border-red-500 hover:text-red-500' : ''}`}
  >
    <div className="relative z-10 flex items-center gap-2">{children}</div>
  </button>
);

const TerminalInput = ({ label, ...props }) => (
  <div className="group space-y-2">
    <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest group-focus-within:text-blue-500 transition-colors">
      {label}
    </label>
    <input 
      {...props}
      className="w-full bg-white/[0.01] border-b border-white/10 py-3 text-sm font-medium text-white placeholder:text-slate-700 focus:outline-none focus:border-blue-500 transition-all font-mono"
    />
  </div>
);

const FeatureCard = ({ title, sub, icon: Icon, active, onClick }) => (
  <div 
    onClick={onClick}
    className={`relative p-8 border cursor-pointer transition-all duration-700 group
      ${active ? 'bg-blue-600/5 border-blue-500/50 shadow-[inset_0_0_40px_rgba(37,99,235,0.05)]' : 'bg-transparent border-white/5 hover:border-white/20'}`}
  >
    <div className={`mb-6 transition-transform duration-500 ${active ? 'scale-110' : 'group-hover:scale-105'}`}>
      <Icon size={28} className={active ? 'text-blue-400' : 'text-slate-600'} />
    </div>
    <h3 className={`text-lg font-light tracking-tight mb-2 ${active ? 'text-white' : 'text-slate-400'}`}>{title}</h3>
    <p className="text-xs text-slate-500 leading-relaxed font-light">{sub}</p>
    {active && <div className="absolute bottom-0 left-0 h-[2px] bg-blue-500 w-full shadow-[0_0_15px_rgba(37,99,235,1)]" />}
  </div>
);

/* ── VIEWS ────────────────────────────────────────────────── */

const IdentityView = ({ data, setData }) => (
  <div className="grid grid-cols-1 md:grid-cols-3 gap-0 border border-white/5 divide-x divide-white/5">
    <FeatureCard 
      icon={Activity} title="Signal Master" active={data.role === 'master'} onClick={() => setData({...data, role: 'master'})}
      sub="Broadcast your algorithmic or manual executions to a secure cloud network."
    />
    <FeatureCard 
      icon={Cpu} title="Execution Node" active={data.role === 'node'} onClick={() => setData({...data, role: 'node'})}
      sub="Receive and execute trades with sub-millisecond latency from a master source."
    />
    <FeatureCard 
      icon={BarChart3} title="Hybrid Link" active={data.role === 'hybrid'} onClick={() => setData({...data, role: 'hybrid'})}
      sub="Complex internal routing between multiple self-owned accounts."
    />
  </div>
);

const ShieldView = ({ data, setData }) => (
  <div className="space-y-12 max-w-2xl">
    <div className="grid grid-cols-2 gap-x-12 gap-y-8">
      <TerminalInput label="Global Drawdown (%)" placeholder="5.0" type="number" />
      <TerminalInput label="Max Daily Loss ($)" placeholder="1000" type="number" />
      <TerminalInput label="Symbol Prefix" placeholder="e.g. .m" />
      <TerminalInput label="Symbol Suffix" placeholder="e.g. +f" />
    </div>
    <div className="space-y-4">
      <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Auto-Killswitch Actions</label>
      <div className="flex gap-4">
        {['Freeze', 'Close Only', 'Liquidate'].map(action => (
          <button 
            key={action}
            onClick={() => setData({...data, action})}
            className={`px-4 py-2 border text-[10px] font-bold uppercase tracking-widest transition-all 
              ${data.action === action ? 'bg-white text-black border-white' : 'border-white/10 text-slate-500 hover:border-white/30'}`}
          >
            {action}
          </button>
        ))}
      </div>
    </div>
  </div>
);

/* ── MAIN TERMINAL ─────────────────────────────────────────── */

export default function App() {
  const [step, setStep] = useState(0);
  const [data, setData] = useState({ role: 'node', action: 'Freeze' });

  return (
    <div className="min-h-screen bg-[#020203] text-white selection:bg-blue-500/40 font-light overflow-hidden">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;600&family=JetBrains+Mono:wght@400;700&display=swap');
        body { font-family: 'Inter', sans-serif; letter-spacing: -0.01em; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .gradient-line { background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent); height: 1px; width: 100%; }
      `}</style>

      {/* SCANLINE EFFECT */}
      <div className="fixed inset-0 pointer-events-none z-50 opacity-[0.03] bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]" />

      <div className="flex h-screen">
        
        {/* LEFT NAV - MINIMALIST */}
        <aside className="w-20 md:w-24 border-r border-white/5 flex flex-col items-center py-8 gap-12 bg-black/40 backdrop-blur-xl">
          <div className="w-10 h-10 border border-blue-500 flex items-center justify-center relative">
            <div className="absolute inset-0 bg-blue-500/20 blur-md" />
            <Zap size={18} className="text-blue-400 relative z-10" />
          </div>
          
          <nav className="flex-1 flex flex-col gap-8">
            {STEPS.map((s, i) => {
              const Icon = s.icon;
              return (
                <div key={s.id} className="relative group flex items-center justify-center">
                  <Icon 
                    size={20} 
                    className={`transition-all duration-500 cursor-pointer ${i <= step ? 'text-blue-400 shadow-[0_0_10px_rgba(37,99,235,0.5)]' : 'text-slate-700 hover:text-slate-400'}`}
                    onClick={() => i < step && setStep(i)}
                  />
                  {i === step && <div className="absolute -right-[1px] w-[2px] h-8 bg-blue-500 shadow-[0_0_15px_rgba(37,99,235,1)]" />}
                </div>
              );
            })}
          </nav>

          <div className="text-[10px] font-mono text-slate-700 vertical-text origin-center rotate-180 uppercase tracking-widest">
            v2.4.0_STABLE
          </div>
        </aside>

        {/* MAIN TERMINAL AREA */}
        <main className="flex-1 flex flex-col overflow-hidden bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.03),transparent_40%)]">
          
          {/* TOP STATUS BAR */}
          <header className="h-20 border-b border-white/5 flex items-center justify-between px-12">
            <div className="flex items-center gap-8">
              <div>
                <span className="text-[10px] font-bold text-slate-500 uppercase tracking-widest mr-4">Node Status</span>
                <span className="text-[10px] font-mono text-blue-400">READY_FOR_HANDSHAKE</span>
              </div>
              <div className="w-px h-4 bg-white/10" />
              <div>
                <span className="text-[10px] font-bold text-slate-500 uppercase tracking-widest mr-4">Session ID</span>
                <span className="text-[10px] font-mono text-slate-400">0xCF42...E9A</span>
              </div>
            </div>
            <div className="flex items-center gap-4 text-slate-500">
               <Lock size={14} />
               <span className="text-[10px] font-bold uppercase tracking-widest">AES-256 Encrypted</span>
            </div>
          </header>

          {/* CONTENT AREA */}
          <section className="flex-1 overflow-y-auto p-12 md:p-20">
            <div className="max-w-6xl">
              <div className="mb-16">
                <span className="text-blue-500 font-mono text-xs mb-2 block tracking-widest">0{step + 1} // {STEPS[step].id.toUpperCase()}</span>
                <h1 className="text-5xl font-extralight tracking-tighter mb-4">
                  {step === 0 && "Initialize Network Role"}
                  {step === 1 && "Secure Broker Gateway"}
                  {step === 4 && "System Hardening"}
                  {step === 5 && "Deployment Protocol"}
                  {step !== 0 && step !== 1 && step !== 4 && step !== 5 && STEPS[step].label}
                </h1>
                <div className="w-24 h-[1px] bg-blue-500/50" />
              </div>

              <div className="animate-in fade-in slide-in-from-bottom-4 duration-1000">
                {step === 0 && <IdentityView data={data} setData={setData} />}
                
                {step === 1 && (
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-16 max-w-4xl">
                    <div className="space-y-8">
                       <TerminalInput label="Broker Server Address" placeholder="Access code or hostname..." />
                       <TerminalInput label="Account Number" placeholder="882901..." />
                       <TerminalInput label="Security Token" type="password" placeholder="••••••••••••" />
                    </div>
                    <div className="p-8 border border-white/5 bg-white/[0.01] flex flex-col justify-center">
                       <p className="text-xs text-slate-500 leading-relaxed italic">
                         "Connect via our secure bridge. Your primary trading password is never stored; only execution tokens are utilized for the copy protocol."
                       </p>
                    </div>
                  </div>
                )}

                {step === 4 && <ShieldView data={data} setData={setData} />}

                {step === 5 && (
                  <div className="border border-white/5 p-20 flex flex-col items-center justify-center text-center space-y-8">
                     <div className="w-32 h-32 rounded-full border border-blue-500/20 flex items-center justify-center relative">
                        <div className="absolute inset-0 bg-blue-500/10 blur-2xl animate-pulse" />
                        <Zap size={48} className="text-blue-500" />
                     </div>
                     <h2 className="text-3xl font-light">Node Deployment Ready</h2>
                     <p className="text-slate-500 text-sm max-w-md">Configuration validated. Initializing secure handshake with TradeSync cluster in Frankfurt (AWS-EU1).</p>
                     <GlowButton active onClick={() => alert("System Online")}>Execute Launch Protocol</GlowButton>
                  </div>
                )}
              </div>
            </div>
          </section>

          {/* DYNAMIC FOOTER */}
          <footer className="h-24 border-t border-white/5 bg-black/40 flex items-center justify-between px-12">
            <button 
              onClick={() => setStep(s => Math.max(0, s-1))}
              className={`text-[10px] font-bold uppercase tracking-[0.3em] text-slate-600 hover:text-white transition-colors ${step === 0 ? 'opacity-0' : ''}`}
            >
              [ Previous ]
            </button>

            <div className="flex gap-4">
               {step < 5 && (
                 <GlowButton onClick={() => setStep(s => s + 1)}>
                   Next Phase <ChevronRight size={14} />
                 </GlowButton>
               )}
            </div>
          </footer>

        </main>
      </div>
    </div>
  );
}
