import React, { useState } from 'react';
import { 
  Shield, 
  Settings2, 
  Link2, 
  Globe, 
  User, 
  ChevronRight, 
  CheckCircle2, 
  Bell,
  ArrowRight,
  Radio,
  Users,
  GitFork,
  Scale,
  Anchor,
  TrendingUp,
  Rocket,
} from 'lucide-react';

const ALL_STEPS = [
  { id: "role", label: "Identity", icon: User },
  { id: "connect", label: "Broker", icon: Globe },
  { id: "link", label: "Linkage", icon: Link2 },
  { id: "copy", label: "Engine", icon: Settings2 },
  { id: "protect", label: "Shield", icon: Shield },
  { id: "go-live", label: "Live", icon: Rocket },
];

const GlowButton = ({ children, onClick, active, danger }) => (
  <button 
    onClick={onClick}
    className={`relative px-6 py-3 rounded-sm font-bold text-[10px] uppercase tracking-[0.2em] transition-all duration-500 overflow-hidden border
      ${active 
        ? 'bg-blue-600 border-blue-400 text-white shadow-[0_0_20px_rgba(37,99,235,0.4)]' 
        : 'bg-transparent border-white/10 text-slate-400 hover:border-white/30 hover:text-white'
      } ${danger ? 'hover:border-red-500 hover:text-red-500' : ''}`}
  >
    <div className="relative z-10 flex items-center gap-2">{children}</div>
  </button>
);

const TerminalInput = ({ label, ...props }) => (
  <div className="group space-y-2">
    <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest group-focus-within:text-blue-500 transition-colors">
      {label}
    </label>
    <input 
      {...props}
      className="w-full bg-white/[0.01] border-b border-white/10 py-3 text-sm font-medium text-white placeholder:text-slate-700 focus:outline-none focus:border-blue-500 transition-all font-mono"
    />
  </div>
);

const FeatureCard = ({ title, sub, icon: Icon, active, onClick }) => (
  <div 
    onClick={onClick}
    className={`relative p-8 border cursor-pointer transition-all duration-700 group
      ${active ? 'bg-blue-600/5 border-blue-500/50 shadow-[inset_0_0_40px_rgba(37,99,235,0.05)]' : 'bg-transparent border-white/5 hover:border-white/20'}`}
  >
    <div className={`mb-6 transition-transform duration-500 ${active ? 'scale-110' : 'group-hover:scale-105'}`}>
      <Icon size={28} className={active ? 'text-blue-400' : 'text-slate-600'} strokeWidth={1.5} />
    </div>
    <h3 className={`text-lg font-light tracking-tight mb-2 ${active ? 'text-white' : 'text-slate-400'}`}>{title}</h3>
    <p className="text-xs text-slate-500 leading-relaxed font-light">{sub}</p>
    {active && <div className="absolute bottom-0 left-0 h-[2px] bg-blue-500 w-full shadow-[0_0_15px_rgba(37,99,235,1)]" />}
  </div>
);

const Toggle = ({ label, sub, on, onChange }) => (
  <div className="flex items-center justify-between p-4 border border-white/5 bg-white/[0.01] mb-3">
    <div>
      <div className="text-xs font-bold text-slate-300 tracking-tight">{label}</div>
      <div className="text-[10px] text-slate-500 font-light">{sub}</div>
    </div>
    <button 
      onClick={() => onChange(!on)}
      className={`relative w-10 h-5 rounded-full transition-colors duration-300 ${on ? 'bg-blue-600' : 'bg-slate-800'}`}
    >
      <div className={`absolute top-1 w-3 h-3 bg-white rounded-full transition-all duration-300 ${on ? 'left-6' : 'left-1'}`} />
    </button>
  </div>
);

const StepRole = ({ data, setData }) => (
  <div className="grid grid-cols-1 md:grid-cols-3 gap-0 border border-white/5 divide-x divide-white/5">
    <FeatureCard 
      icon={Radio} title="Signal Provider" active={data.role === 'provider'}
      onClick={() => setData({...data, role: 'provider'})}
      sub="Master account. Your trades are broadcast to followers instantly."
    />
    <FeatureCard 
      icon={Users} title="Follower" active={data.role === 'follower'}
      onClick={() => setData({...data, role: 'follower'})}
      sub="Slave account. Copy trades instantly from a master source."
    />
    <FeatureCard 
      icon={GitFork} title="Self-Copy" active={data.role === 'self'}
      onClick={() => setData({...data, role: 'self'})}
      sub="Internal linkage. Duplicate trades between your own accounts."
    />
  </div>
);

const StepProtect = ({ data, setData }) => (
  <div className="space-y-12 max-w-2xl">
    <div className="grid grid-cols-2 gap-x-12 gap-y-8">
      <TerminalInput label="Global Drawdown (%)" placeholder="5.0" type="number" />
      <TerminalInput label="Max Daily Loss ($)" placeholder="1000" type="number" />
      <TerminalInput label="Symbol Prefix" placeholder="e.g. .m" />
      <TerminalInput label="Symbol Suffix" placeholder="e.g. +f" />
    </div>
    <div className="space-y-6">
      <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Safety Notifications</label>
      <div className="grid md:grid-cols-2 gap-4">
        <Toggle 
          label="Disconnection Alert" 
          sub="Alert if servers lose bridge connection" 
          on={data.notif1 ?? true} 
          onChange={v => setData({...data, notif1: v})} 
        />
        <Toggle 
          label="Execution Fail" 
          sub="Alert when an order is rejected" 
          on={data.notif2 ?? true} 
          onChange={v => setData({...data, notif2: v})} 
        />
      </div>
    </div>
  </div>
);

export default function App() {
  const [step, setStep] = useState(0);
  const [isDeployed, setIsDeployed] = useState(false);
  const [data, setData] = useState({ role: 'follower', platform: 'MT5', lotMode: 'mult', riskAmount: '1' });

  const getVisibleSteps = () => {
    if (data.role === 'provider') return ALL_STEPS.filter(s => ['role', 'connect', 'go-live'].includes(s.id));
    if (data.role === 'self') return ALL_STEPS.filter(s => ['role', 'connect', 'copy', 'protect', 'go-live'].includes(s.id));
    return ALL_STEPS;
  };

  const visibleSteps = getVisibleSteps();
  const currentStepData = visibleSteps[step] || visibleSteps[0];

  const handleNext = () => { if (step < visibleSteps.length - 1) setStep(step + 1); };
  const handlePrev = () => { if (step > 0) setStep(step - 1); };

  if (isDeployed) {
    return (
      <div className="min-h-screen bg-[#020203] text-white flex items-center justify-center p-6 text-center">
        <style>{`
          @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap');
          body { font-family: 'Plus Jakarta Sans', sans-serif; }
        `}</style>
        <div className="max-w-xl space-y-8 animate-in zoom-in-95 fade-in duration-1000">
          <div className="relative inline-block">
            <div className="absolute inset-0 bg-blue-600 blur-3xl opacity-20 animate-pulse" />
            <div className="w-24 h-24 border border-blue-500 rounded-full flex items-center justify-center mx-auto relative z-10">
              <CheckCircle2 size={48} className="text-blue-400" />
            </div>
          </div>
          <div className="space-y-4">
            <h1 className="text-4xl font-extralight tracking-tighter">Terminal Live</h1>
            <p className="text-slate-500 font-light leading-relaxed">
              Link established successfully. Your account is now monitoring the 
              <span className="text-blue-400 font-mono mx-1">@TradeSync_Main_Bridge</span> 
              for real-time executions.
            </p>
          </div>
          <div className="pt-8 flex flex-col items-center gap-4">
            <GlowButton active onClick={() => window.location.reload()}>
              Go To Dashboard <ArrowRight size={14} />
            </GlowButton>
            <button className="text-[10px] uppercase tracking-widest text-slate-700 hover:text-slate-400 transition-colors">
              View Bridge Logs
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#020203] text-white selection:bg-blue-500/40 font-light overflow-hidden">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.01em; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        .vertical-text { writing-mode: vertical-rl; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
      `}</style>

      <div className="fixed inset-0 pointer-events-none z-50 opacity-[0.03] bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]" />

      <div className="flex h-screen flex-row-reverse">

        {/* RIGHT SIDEBAR */}
        <aside className="w-20 md:w-24 border-l border-white/5 flex flex-col items-center py-8 gap-12 bg-black/40 backdrop-blur-xl z-20 overflow-y-auto hide-scrollbar">
          <nav className="flex-1 flex flex-col gap-8 justify-center">
            {visibleSteps.map((s, i) => {
              const Icon = s.icon;
              return (
                <div key={s.id} className="relative group flex items-center justify-center">
                  <Icon 
                    size={20}
                    strokeWidth={1.5}
                    className={`transition-all duration-500 cursor-pointer ${i <= step ? 'text-blue-400' : 'text-slate-700 hover:text-slate-400'}`}
                    onClick={() => i < step && setStep(i)}
                  />
                  {i === step && <div className="absolute -left-[1px] w-[2px] h-8 bg-blue-500 shadow-[0_0_15px_rgba(37,99,235,1)]" />}
                </div>
              );
            })}
          </nav>
        </aside>

        {/* MAIN TERMINAL AREA */}
        <main className="flex-1 flex flex-col overflow-hidden bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.03),transparent_40%)]">

          <header className="h-20 border-b border-white/5" />

          {/* CONTENT AREA */}
          <section className="flex-1 overflow-y-auto p-12 md:p-20 hide-scrollbar">
            <div className="max-w-6xl">
              <div className="mb-16">
                <span className="text-blue-500 font-mono text-xs mb-2 block tracking-widest">0{step + 1} // {currentStepData.id.toUpperCase()}</span>
                <h1 className="text-5xl font-extralight tracking-tighter mb-4">
                  {currentStepData.id === 'role' && "Define your role."}
                  {currentStepData.id === 'connect' && "Terminal Access"}
                  {currentStepData.id === 'link' && "Bridge Linkage"}
                  {currentStepData.id === 'copy' && "Lot Engine"}
                  {currentStepData.id === 'protect' && "Protection Shield"}
                  {currentStepData.id === 'go-live' && "Deployment Protocol"}
                </h1>
                <div className="w-24 h-[1px] bg-blue-500/50" />
              </div>

              <div className="animate-in fade-in slide-in-from-bottom-4 duration-1000">
                {currentStepData.id === 'role' && <StepRole data={data} setData={(newData) => { setData(newData); setStep(0); }} />}

                {currentStepData.id === 'connect' && (
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-16 max-w-4xl">
                    <div className="space-y-8">
                      <div className="space-y-2">
                        <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Platform Type</label>
                        <div className="grid grid-cols-2 gap-3">
                          {["MT4", "MT5", "cTrader", "Proprietary"].map(p => (
                            <button 
                              key={p} onClick={() => setData({...data, platform: p})}
                              className={`px-4 py-3 border text-[10px] font-bold uppercase tracking-widest transition-all flex items-center justify-between ${data.platform === p ? 'bg-white text-black border-white' : 'border-white/10 text-slate-500 hover:border-white/30'}`}
                            >
                              {p}
                              {data.platform === p && <CheckCircle2 size={12} />}
                            </button>
                          ))}
                        </div>
                      </div>
                      {data.platform === 'Proprietary' ? (
                        <div className="animate-in fade-in slide-in-from-left-2 duration-500 space-y-8">
                          <TerminalInput label="Broker Platform Name" placeholder="e.g. ThinkTrader, Oanda Desktop" />
                          <TerminalInput label="API Endpoint (Optional)" placeholder="https://api.broker.com/v1" />
                          <div className="grid grid-cols-2 gap-8">
                            <TerminalInput label="API Key" type="password" placeholder="pk_live_..." />
                            <TerminalInput label="Secret" type="password" placeholder="••••••••" />
                          </div>
                        </div>
                      ) : (
                        <div className="animate-in fade-in duration-500 space-y-8">
                          <TerminalInput label="Friendly Name" placeholder="Personal Live Account" />
                          <TerminalInput label="Broker Server" placeholder="IC-Markets-Live-02" />
                          <div className="grid grid-cols-2 gap-8">
                            <TerminalInput label="Login ID" placeholder="1029384" />
                            <TerminalInput label="Investor Password" type="password" placeholder="••••••••" />
                          </div>
                        </div>
                      )}
                    </div>
                    <div className="flex flex-col justify-end pb-2">
                      <div className="p-8 border border-white/5 bg-white/[0.01]">
                        <div className="flex items-center gap-3 mb-4 text-blue-400">
                          <Shield size={18} />
                          <span className="text-[10px] font-bold uppercase tracking-widest">Security Protocol</span>
                        </div>
                        <p className="text-xs text-slate-500 leading-relaxed italic">
                          TradeSync uses isolated bridge technology to monitor your margin and mirror executions. No withdrawal or sensitive personal data permissions are ever required.
                          {data.platform === 'Proprietary' && " Proprietary connections may require manual API token generation from your broker dashboard."}
                        </p>
                      </div>
                    </div>
                  </div>
                )}

                {currentStepData.id === 'link' && (
                  <div className="max-w-2xl space-y-12">
                    <TerminalInput label="Master Search ID" placeholder="Enter Provider UUID or Account ID..." />
                    <div className="space-y-4">
                      <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Verified Providers</label>
                      {["Quantum Core (Live-01)", "Titanium Scalp v4", "Black Edge HFT"].map(v => (
                        <div key={v} className="flex justify-between items-center p-6 border border-white/5 bg-white/[0.01] hover:border-blue-500/30 transition-all cursor-pointer">
                          <span className="font-light tracking-tight">{v}</span>
                          <span className="text-[10px] font-mono text-blue-500 border border-blue-500/20 px-2 py-1">PUBLIC</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {currentStepData.id === 'copy' && (
                  <div className="space-y-12">
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-0 border border-white/5 divide-x divide-white/5">
                      <FeatureCard 
                        icon={Scale} title="Balance Multiplier" active={data.lotMode === 'mult'}
                        onClick={() => setData({...data, lotMode: 'mult'})}
                        sub="Scale based on relative account size. Safest for most users."
                      />
                      <FeatureCard 
                        icon={Anchor} title="Fixed Lot Size" active={data.lotMode === 'fixed'}
                        onClick={() => setData({...data, lotMode: 'fixed'})}
                        sub="Ignores master lot; always opens set value (e.g. 0.01)."
                      />
                      <FeatureCard 
                        icon={TrendingUp} title="Equity Risk %" active={data.lotMode === 'risk'}
                        onClick={() => setData({...data, lotMode: 'risk'})}
                        sub="Dynamic sizing based on current free margin per trade."
                      />
                    </div>
                    {data.lotMode === 'risk' && (
                      <div className="max-w-md animate-in slide-in-from-top-4 duration-500">
                        <TerminalInput 
                          label="Risk Amount Per Trade (%)" 
                          type="number" 
                          value={data.riskAmount}
                          onChange={(e) => setData({...data, riskAmount: e.target.value})}
                          placeholder="1.0" 
                        />
                        <p className="mt-4 text-[10px] text-slate-500 uppercase tracking-widest flex items-center gap-2">
                          <Bell size={12} className="text-blue-500" />
                          Engine will auto-calculate lot size based on stop-loss distance.
                        </p>
                      </div>
                    )}
                  </div>
                )}

                {currentStepData.id === 'protect' && <StepProtect data={data} setData={setData} />}

                {currentStepData.id === 'go-live' && (
                  <div className="border border-white/5 p-20 flex flex-col items-center justify-center text-center space-y-8">
                    <div className="w-32 h-32 rounded-full border border-blue-500/20 flex items-center justify-center relative">
                      <div className="absolute inset-0 bg-blue-500/10 blur-2xl animate-pulse" />
                      <Rocket size={48} className="text-blue-500" strokeWidth={1.5} />
                    </div>
                    <h2 className="text-3xl font-light">System Ready</h2>
                    <p className="text-slate-500 text-sm max-w-md">
                      {data.role === 'provider' ? "Your master signal is ready to broadcast." : "All nodes are synchronized. Your trades will now mirror in real-time."}
                    </p>
                    <GlowButton active onClick={() => setIsDeployed(true)}>DEPLOY TERMINAL</GlowButton>
                  </div>
                )}
              </div>
            </div>
          </section>

          {/* FOOTER */}
          <footer className="h-24 border-t border-white/5 bg-black/40 flex items-center justify-between px-12">
            <button 
              onClick={handlePrev}
              className={`text-[10px] font-bold uppercase tracking-[0.3em] text-slate-600 hover:text-white transition-colors ${step === 0 ? 'opacity-0 pointer-events-none' : ''}`}
            >
              [ Previous ]
            </button>
            <div className="flex gap-4">
              {step < visibleSteps.length - 1 && (
                <GlowButton onClick={handleNext}>
                  Proceed <ChevronRight size={14} />
                </GlowButton>
              )}
            </div>
          </footer>

        </main>
      </div>
    </div>
  );
}
