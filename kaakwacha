            <div style={{ maxWidth: 1100, margin: "0 auto" }}>
              <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", marginBottom: 28, flexWrap: "wrap", gap: 12 }}>
                <h2 className="section-hd" style={{ fontSize: 28 }}>Customer <span className="accent">Favourites</span></h2>
                <button className="btn btn-ghost" style={{ fontSize: 13 }} onClick={() => setPage("menu")}>Full Menu →</button>
              </div>
              <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(210px, 1fr))", gap: 16 }}>
                {MENU.filter(m => m.popular).map(item => (
                  <div key={item.id} className="card">
                    <img src={item.img} alt={item.name} style={{ width: "100%", height: 148, objectFit: "cover" }} />
                    <div style={{ padding: 16 }}>
                      <div className="serif" style={{ fontSize: 15, fontWeight: 700, marginBottom: 4, color: C.text }}>{item.name}</div>
                      <div className="f" style={{ fontSize: 12, color: C.textLight, marginBottom: 12, lineHeight: 1.5 }}>{item.desc}</div>
                      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                        <span className="f" style={{ color: C.orange, fontWeight: 700, fontSize: 16 }}>KSh {item.price}</span>
                        <button className="btn btn-primary" style={{ padding: "7px 14px", fontSize: 12, borderRadius: 8 }} onClick={() => addToCart(item)}>Add +</button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Testimonials */}
          <div style={{ maxWidth: 1100, margin: "0 auto", padding: "60px 20px" }}>
            <h2 className="section-hd" style={{ fontSize: 28, textAlign: "center", marginBottom: 6 }}>What Our <span className="accent">Guests Say</span></h2>
            <p className="f" style={{ textAlign: "center", color: C.textLight, marginBottom: 36, fontSize: 14 }}>Real reviews from real Kenyans</p>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(260px, 1fr))", gap: 18 }}>
              {TESTIMONIALS.map((t, i) => (
                <div key={i} className="card" style={{ padding: 22 }}>
                  <div className="stars" style={{ marginBottom: 10 }}>{"★".repeat(t.rating)}</div>
                  <p style={{ fontFamily: "'Georgia', serif", fontSize: 13.5, color: C.textMid, lineHeight: 1.72, fontStyle: "italic", marginBottom: 16 }}>"{t.text}"</p>
                  <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                    <div className="avatar">{t.avatar}</div>
                    <div>
                      <div className="f" style={{ fontWeight: 700, fontSize: 13, color: C.text }}>{t.name}</div>
                      <div className="f" style={{ fontSize: 11, color: C.textLight }}>{t.role}</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Contact footer */}
          <div style={{ background: C.orange, padding: "40px 20px", textAlign: "center" }}>
            <h3 className="serif" style={{ fontSize: 22, color: "#fff", marginBottom: 6, fontWeight: 900 }}>Find Us on Odera Street</h3>
            <p className="f" style={{ fontSize: 13, color: "rgba(255,255,255,0.8)", marginBottom: 22 }}>Mon–Sun · 7:00 AM – 10:00 PM · Kisumu, Kenya</p>
            <div style={{ display: "flex", gap: 12, justifyContent: "center", flexWrap: "wrap" }}>
              <a href="tel:0728462418" style={{ textDecoration: "none" }}><button className="btn" style={{ background: "#fff", color: C.orange, fontFamily: "'DM Sans',sans-serif", fontWeight: 700 }}>📞 0728 462 418</button></a>
              <a href="tel:0727911548" style={{ textDecoration: "none" }}><button className="btn" style={{ background: "rgba(255,255,255,0.15)", color: "#fff", border: "1.5px solid rgba(255,255,255,0.4)", fontFamily: "'DM Sans',sans-serif", fontWeight: 700 }}>📞 0727 911 548</button></a>
              <a href="mailto:info@HangoverKaakwacha.co.ke" style={{ textDecoration: "none" }}><button className="btn" style={{ background: "rgba(255,255,255,0.15)", color: "#fff", border: "1.5px solid rgba(255,255,255,0.4)", fontFamily: "'DM Sans',sans-serif", fontWeight: 700 }}>✉ Email Us</button></a>
            </div>
          </div>
        </div>
      )}

      {/* ===== MENU ===== */}
      {page === "menu" && (
        <div style={{ maxWidth: 1100, margin: "0 auto", padding: "40px 20px" }}>
          <div style={{ marginBottom: 28 }}>
            <h2 className="section-hd" style={{ fontSize: 34, marginBottom: 6 }}>Our <span className="accent">Menu</span></h2>
            <p className="f" style={{ color: C.textLight, fontSize: 14 }}>Freshly prepared, local flavours — tap any dish to add to your order</p>
          </div>
          <div className="scroll-x" style={{ marginBottom: 28 }}>
            {CATEGORIES.map(cat => (
              <button key={cat} className={`cat-btn${menuCat === cat ? " active" : ""}`} onClick={() => setMenuCat(cat)}>{cat}</button>
            ))}
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(210px, 1fr))", gap: 18 }}>
            {filteredMenu.map(item => (
              <div key={item.id} className="card">
                <div style={{ position: "relative" }}>
                  <img src={item.img} alt={item.name} style={{ width: "100%", height: 172, objectFit: "cover" }} />
                  {item.popular && <div className="tag tag-hot" style={{ position: "absolute", top: 10, left: 10 }}>⭐ Popular</div>}
                </div>
                <div style={{ padding: 16 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 6 }}>
                    <div className="serif" style={{ fontSize: 14, fontWeight: 700, color: C.text, flex: 1, lineHeight: 1.3 }}>{item.name}</div>
                    <div className="f" style={{ fontWeight: 700, fontSize: 15, color: C.orange, marginLeft: 8, flexShrink: 0 }}>KSh {item.price}</div>
                  </div>
                  <p className="f" style={{ fontSize: 12, color: C.textLight, lineHeight: 1.55, marginBottom: 14 }}>{item.desc}</p>
                  <button className="btn btn-primary" style={{ width: "100%", padding: "9px", fontSize: 13, borderRadius: 8 }} onClick={() => addToCart(item)}>
                    + Add to Order
                  </button>
                </div>
              </div>
            ))}
          </div>
          {cart.length > 0 && (
            <div style={{ position: "fixed", bottom: 24, right: 24, zIndex: 40 }}>
              <button className="btn btn-primary" style={{ padding: "14px 22px", fontSize: 14, borderRadius: 14, boxShadow: "0 8px 28px rgba(232,82,58,0.35)" }} onClick={() => setCheckoutOpen(true)}>
                🛒 View Order · KSh {total.toLocaleString()}
              </button>
            </div>
          )}
        </div>
      )}

      {/* ===== SPECIAL OFFERS ===== */}
      {page === "offers" && (
        <div style={{ maxWidth: 1100, margin: "0 auto", padding: "40px 20px" }}>
          <h2 className="section-hd" style={{ fontSize: 34, marginBottom: 6 }}>Special <span className="accent">Offers</span></h2>
          <p className="f" style={{ color: C.textLight, marginBottom: 40, fontSize: 14 }}>Crafted deals to make every visit extraordinary</p>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(280px, 1fr))", gap: 22 }}>
            {SPECIAL_OFFERS.map(offer => (
              <div key={offer.id} style={{ background: "#fff", borderRadius: 16, overflow: "hidden", border: `1px solid ${C.border}`, boxShadow: "0 2px 12px rgba(232,82,58,0.06)", transition: "transform 0.2s, box-shadow 0.2s" }}
                onMouseEnter={e => { e.currentTarget.style.transform = "translateY(-3px)"; e.currentTarget.style.boxShadow = "0 10px 32px rgba(232,82,58,0.14)"; }}
                onMouseLeave={e => { e.currentTarget.style.transform = ""; e.currentTarget.style.boxShadow = "0 2px 12px rgba(232,82,58,0.06)"; }}>
                <div style={{ position: "relative" }}>
                  <img src={offer.img} alt={offer.title} style={{ width: "100%", height: 158, objectFit: "cover" }} />
                  <div style={{ position: "absolute", top: 12, left: 12, background: offer.accent, color: "#fff", padding: "4px 12px", borderRadius: 20, fontSize: 11, fontFamily: "'DM Sans', sans-serif", fontWeight: 700, letterSpacing: "0.04em" }}>
                    {offer.badge}
                  </div>
                </div>
                <div style={{ padding: 22 }}>
                  <h3 className="serif" style={{ fontSize: 19, fontWeight: 700, marginBottom: 10, lineHeight: 1.3, color: C.text }}>{offer.title}</h3>
                  <p className="f" style={{ fontSize: 13, color: C.textMid, lineHeight: 1.65, marginBottom: 16 }}>{offer.desc}</p>
                  <div className="divider" />
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
                    <div>
                      <div className="f" style={{ fontSize: 10, color: C.textLight, textTransform: "uppercase", letterSpacing: "0.05em" }}>Valid</div>
                      <div className="f" style={{ fontSize: 13, color: C.text, fontWeight: 700 }}>{offer.valid}</div>
                    </div>
                    <div className="tag tag-save">{offer.saving}</div>
                  </div>
                  <button className="btn btn-primary" style={{ width: "100%", padding: 10 }} onClick={() => setPage("menu")}>Order Now & Claim →</button>
                </div>
              </div>
            ))}
          </div>
          <div style={{ marginTop: 48, background: `linear-gradient(120deg, #FFF3F1, #FFEDE6)`, border: `1.5px solid ${C.orangeMid}`, borderRadius: 16, padding: 32, textAlign: "center" }}>
            <div style={{ fontSize: 36, marginBottom: 12 }}>🎂</div>
            <h3 className="section-hd" style={{ fontSize: 22, marginBottom: 10 }}>Celebrating Something <span className="accent">Special?</span></h3>
            <p className="f" style={{ fontSize: 14, color: C.textMid, marginBottom: 20, maxWidth: 460, margin: "0 auto 20px" }}>
              Book your birthday, anniversary, or corporate event. Get a personalised table, 10% off the bill, and a complimentary surprise.
            </p>
            <a href="tel:0728462418"><button className="btn btn-primary" style={{ padding: "12px 28px" }}>📞 Book an Event</button></a>
          </div>
        </div>
      )}

      {/* ===== UPCOMING EVENTS ===== */}
      {page === "upcoming" && (
        <div style={{ maxWidth: 1100, margin: "0 auto", padding: "40px 20px" }}>
          <h2 className="section-hd" style={{ fontSize: 34, marginBottom: 6 }}>Upcoming <span className="accent">Events</span></h2>
          <p className="f" style={{ color: C.textLight, marginBottom: 40, fontSize: 14 }}>Don't miss what's coming — mark your calendar</p>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(280px, 1fr))", gap: 22 }}>
            {UPCOMING_OFFERS.map(ev => (
              <div key={ev.id} className="card">
                <div style={{ position: "relative" }}>
                  <img src={ev.img} alt={ev.title} style={{ width: "100%", height: 168, objectFit: "cover" }} />
                  <div className="countdown" style={{ position: "absolute", top: 12, right: 12 }}>{ev.daysLeft} days away</div>
                </div>
                <div style={{ padding: 22 }}>
                  <div className="f" style={{ fontSize: 12, color: C.orange, fontWeight: 700, textTransform: "uppercase", letterSpacing: "0.06em", marginBottom: 8 }}>📅 {ev.date}</div>
                  <h3 className="serif" style={{ fontSize: 18, fontWeight: 700, marginBottom: 10, lineHeight: 1.35, color: C.text }}>{ev.title}</h3>
                  <p className="f" style={{ fontSize: 13, color: C.textMid, lineHeight: 1.65, marginBottom: 16 }}>{ev.desc}</p>
                  <a href="tel:0728462418" style={{ textDecoration: "none" }}>
                    <button className="btn btn-outline" style={{ width: "100%", padding: 9 }}>Register Interest</button>
                  </a>
                </div>
              </div>
            ))}
          </div>
          <div style={{ marginTop: 48, textAlign: "center", padding: "32px 20px", background: C.surfaceAlt, borderRadius: 16, border: `1px solid ${C.border}` }}>
            <p className="f" style={{ fontSize: 14, color: C.textMid, marginBottom: 18 }}>Save our number to be first to know about new events and daily specials.</p>
            <div style={{ display: "flex", gap: 12, justifyContent: "center", flexWrap: "wrap" }}>
              <a href="tel:0728462418" style={{ textDecoration: "none" }}><button className="btn btn-primary">📞 Save Our Number</button></a>
              <a href="https://facebook.com" target="_blank" rel="noreferrer" style={{ textDecoration: "none" }}><button className="btn btn-ghost">👍 Follow on Facebook</button></a>
            </div>
          </div>
        </div>
      )}

      {/* ===== ROOMS ===== */}
      {page === "rooms" && (
        <div style={{ maxWidth: 1100, margin: "0 auto", padding: "40px 20px" }}>
          {checkinDone ? (
            <div className="success-box" style={{ maxWidth: 500, margin: "40px auto", textAlign: "center" }}>
              <div style={{ fontSize: 52, marginBottom: 16 }}>🏨</div>
              <h3 className="section-hd" style={{ fontSize: 26, marginBottom: 10 }}>Booking <span className="accent">Confirmed!</span></h3>
              <p className="f" style={{ fontSize: 14, color: C.textMid, marginBottom: 6 }}>
                Thank you, <strong>{checkinForm.name}</strong>! Your check-in request for the <strong style={{ color: C.orange }}>{checkinRoom?.name}</strong> has been received.
              </p>
              <p className="f" style={{ fontSize: 13, color: C.textLight, marginBottom: 24 }}>We'll call you on <strong>{checkinForm.phone}</strong> to confirm your reservation.</p>
              <button className="btn btn-primary" onClick={() => { setCheckinDone(false); setCheckinRoom(null); setCheckinForm({ name: "", phone: "", checkin: "", checkout: "", guests: 1 }); }}>
                Browse More Rooms
              </button>
            </div>
          ) : (
            <>
              <h2 className="section-hd" style={{ fontSize: 34, marginBottom: 6 }}>Stay With <span className="accent">Us</span></h2>
              <p className="f" style={{ color: C.textLight, marginBottom: 36, fontSize: 14 }}>Comfortable rooms above Kisumu's favourite eatery — wake up to breakfast downstairs</p>
              <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(270px, 1fr))", gap: 22 }}>
                {ROOMS.map(room => (
                  <div key={room.id} className="card" style={{ opacity: room.available ? 1 : 0.65 }}>
                    <div style={{ position: "relative" }}>
                      <img src={room.img} alt={room.name} style={{ width: "100%", height: 178, objectFit: "cover" }} />
                      {room.popular && <div className="tag tag-hot" style={{ position: "absolute", top: 10, left: 10 }}>⭐ Most Popular</div>}
                      {!room.available && (
                        <div style={{ position: "absolute", inset: 0, background: "rgba(255,243,240,0.75)", display: "flex", alignItems: "center", justifyContent: "center" }}>
                          <div className="f" style={{ fontWeight: 700, fontSize: 15, color: C.orange, background: "#fff", padding: "8px 20px", borderRadius: 8, border: `1.5px solid ${C.orangeMid}` }}>Fully Booked</div>
                        </div>
                      )}
                    </div>
                    <div style={{ padding: 22 }}>
                      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 8 }}>
                        <h3 className="serif" style={{ fontSize: 17, fontWeight: 700, color: C.text }}>{room.name}</h3>
                        <div style={{ textAlign: "right" }}>
                          <div className="f" style={{ fontWeight: 700, fontSize: 17, color: C.orange }}>KSh {room.price.toLocaleString()}</div>
                          <div className="f" style={{ fontSize: 10, color: C.textLight }}>per night</div>
                        </div>
                      </div>
                      <p className="f" style={{ fontSize: 13, color: C.textMid, marginBottom: 14, lineHeight: 1.6 }}>{room.desc}</p>
                      <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginBottom: 18 }}>
                        {room.amenities.map(a => <span key={a} className="amenity">{a}</span>)}
                      </div>
                      <button
                        className={`btn ${room.available ? "btn-primary" : "btn-ghost"}`}
                        style={{ width: "100%", padding: 10 }}
                        disabled={!room.available}
                        onClick={() => room.available && setCheckinRoom(room)}
                      >
                        {room.available ? "Book This Room →" : "Unavailable"}
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>
      )}

      {/* CHECK-IN MODAL */}
      {checkinRoom && !checkinDone && (
        <div className="overlay" onClick={e => e.target.className === "overlay" && setCheckinRoom(null)}>
          <div className="modal">
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
              <h3 className="section-hd" style={{ fontSize: 20 }}>Book <span className="accent">{checkinRoom.name}</span></h3>
              <button onClick={() => setCheckinRoom(null)} style={{ background: "none", border: "none", color: C.textLight, cursor: "pointer", fontSize: 22 }}>✕</button>
            </div>
            <div style={{ background: C.surfaceAlt, borderRadius: 10, padding: "12px 14px", marginBottom: 20, display: "flex", justifyContent: "space-between" }}>
              <span className="f" style={{ fontSize: 13, color: C.textLight }}>Rate per night</span>
              <span className="f" style={{ fontSize: 17, fontWeight: 700, color: C.orange }}>KSh {checkinRoom.price.toLocaleString()}</span>
            </div>
            <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
              {[["Full Name", "name", "text", "Your full name"], ["Phone Number", "phone", "tel", "0700 000 000"]].map(([label, key, type, ph]) => (
                <div key={key}>
                  <label className="f" style={{ fontSize: 12, color: C.textLight, textTransform: "uppercase", letterSpacing: "0.05em", display: "block", marginBottom: 6 }}>{label}</label>
                  <input className="inp" type={type} placeholder={ph} value={checkinForm[key]} onChange={e => setCheckinForm(p => ({ ...p, [key]: e.target.value }))} />
                </div>
              ))}
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
                {[["Check-in", "checkin"], ["Check-out", "checkout"]].map(([label, key]) => (
                  <div key={key}>
                    <label className="f" style={{ fontSize: 12, color: C.textLight, textTransform: "uppercase", letterSpacing: "0.05em", display: "block", marginBottom: 6 }}>{label}</label>
                    <input className="inp" type="date" value={checkinForm[key]} onChange={e => setCheckinForm(p => ({ ...p, [key]: e.target.value }))} />
                  </div>
                ))}
              </div>
              <div>
                <label className="f" style={{ fontSize: 12, color: C.textLight, textTransform: "uppercase", letterSpacing: "0.05em", display: "block", marginBottom: 6 }}>Guests</label>
                <select className="inp" value={checkinForm.guests} onChange={e => setCheckinForm(p => ({ ...p, guests: e.target.value }))}>
                  {[1, 2, 3, 4].map(n => <option key={n} value={n}>{n} Guest{n > 1 ? "s" : ""}</option>)}
                </select>
              </div>
              <button className="btn btn-primary" style={{ padding: 14, fontSize: 14, borderRadius: 10, marginTop: 4 }} onClick={submitCheckin}>Confirm Booking</button>
              <p className="f" style={{ fontSize: 11, color: C.textLight, textAlign: "center" }}>We'll call you within 1 hour to confirm your reservation.</p>
            </div>
          </div>
        </div>
      )}

      {/* CART MODAL */}
      {checkoutOpen && (
        <div className="overlay" onClick={e => { if (e.target.className === "overlay") setCheckoutOpen(false); }}>
          <div className="modal">
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
              <h3 className="section-hd" style={{ fontSize: 20 }}>Your <span className="accent">Order</span></h3>
              <button onClick={() => setCheckoutOpen(false)} style={{ background: "none", border: "none", color: C.textLight, cursor: "pointer", fontSize: 22 }}>✕</button>
            </div>
            {orderPlaced ? (
              <div className="success-box">
                <div style={{ fontSize: 44, marginBottom: 12 }}>✅</div>
                <h4 className="section-hd" style={{ fontSize: 20, marginBottom: 8 }}>Order <span className="accent">Received!</span></h4>
                <p className="f" style={{ fontSize: 13, color: C.textMid }}>Thank you, {orderForm.name}! We'll prepare your order and call {orderForm.phone} to confirm.</p>
                <button className="btn btn-primary" style={{ marginTop: 18 }} onClick={() => { setOrderPlaced(false); setCheckoutOpen(false); setOrderForm({ name: "", phone: "", notes: "" }); }}>Done</button>
              </div>
            ) : cart.length === 0 ? (
              <div style={{ textAlign: "center", padding: "40px 0", color: C.textLight }}>
                <div style={{ fontSize: 44, marginBottom: 12 }}>🛒</div>
                <p className="f" style={{ fontSize: 14, marginBottom: 20 }}>Your cart is empty. Add something delicious!</p>
                <button className="btn btn-primary" onClick={() => { setCheckoutOpen(false); setPage("menu"); }}>Browse Menu</button>
              </div>
            ) : (
              <>
                <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 18 }}>
                  {cart.map(item => (
                    <div key={item.id} style={{ display: "flex", alignItems: "center", gap: 12, background: C.surfaceAlt, borderRadius: 10, padding: 12, border: `1px solid ${C.border}` }}>
                      <img src={item.img} alt={item.name} style={{ width: 50, height: 50, borderRadius: 8, objectFit: "cover", flexShrink: 0 }} />
                      <div style={{ flex: 1, minWidth: 0 }}>
                        <div className="f" style={{ fontWeight: 700, fontSize: 13, color: C.text }}>{item.name}</div>
                        <div className="f" style={{ fontSize: 12, color: C.orange }}>KSh {item.price} each</div>
                      </div>
                      <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
                        <button className="qty-btn" onClick={() => updateQty(item.id, -1)}>−</button>
                        <span className="f" style={{ fontWeight: 700, fontSize: 14, minWidth: 18, textAlign: "center" }}>{item.qty}</span>
                        <button className="qty-btn" onClick={() => updateQty(item.id, 1)}>+</button>
                        <button onClick={() => removeFromCart(item.id)} style={{ background: "none", border: "none", color: C.textLight, cursor: "pointer", fontSize: 15, marginLeft: 2 }}>✕</button>
                      </div>
                    </div>
                  ))}
                </div>
                <div style={{ background: C.orangeLight, borderRadius: 10, padding: "14px 16px", marginBottom: 18, display: "flex", justifyContent: "space-between", border: `1px solid ${C.orangeMid}` }}>
                  <span className="f" style={{ fontSize: 14, color: C.textMid }}>Total ({cartCount} items)</span>
                  <span className="f" style={{ fontSize: 20, fontWeight: 700, color: C.orange }}>KSh {total.toLocaleString()}</span>
                </div>
                <div className="divider" />
                <p className="f" style={{ fontSize: 13, color: C.textLight, marginBottom: 12 }}>Your details for confirmation</p>
                <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 16 }}>
                  <input className="inp" placeholder="Your Name *" value={orderForm.name} onChange={e => setOrderForm(p => ({ ...p, name: e.target.value }))} />
                  <input className="inp" placeholder="Phone Number *" type="tel" value={orderForm.phone} onChange={e => setOrderForm(p => ({ ...p, phone: e.target.value }))} />
                  <textarea className="inp" placeholder="Special requests (optional)" rows={2} style={{ resize: "none" }} value={orderForm.notes} onChange={e => setOrderForm(p => ({ ...p, notes: e.target.value }))} />
                </div>
                <button className="btn btn-primary" style={{ width: "100%", padding: 14, fontSize: 14, borderRadius: 10 }} onClick={placeOrder}>
                  Place Order · KSh {total.toLocaleString()}
                </button>
              </>
            )}
          </div>
        </div>
      )}

      <div style={{ background: C.orange, padding: "18px 20px", textAlign: "center" }}>
        <p className="f" style={{ fontSize: 11, color: "rgba(255,255,255,0.7)" }}>
          © 2026 HangoverKaakwacha Restaurant Odera · Odera Street, Kisumu, Kenya · info@HangoverKaakwacha.co.ke
        </p>
      </div>
    </div>
  );
}
