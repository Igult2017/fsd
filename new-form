      <div className="tj-score-grid">
        {SCORES.map(([k, name]) => <Dots key={k} name={name} value={d[k]} onChange={v => f(k)(v)} />)}
      </div>
    </div>
  </>;
}

// ─── Step 4 ───────────────────────────────────────────────────────────────────
function Step4({ d, set }) {
  const f = k => v => set({ ...d, [k]: v });
  return <>
    <div className="tj-section"><div className="tj-section-label">Trader State</div>
      <div className="tj-grid tj-g2" style={{ gap: 16 }}>
        <Tags label="Emotional State" options={EMOTIONS_LIST} value={d.emotionalState} onChange={f('emotionalState')} />
        <Tags label="Post-Trade Emotion" options={POST_EMOTIONS} value={d.postEmotion} onChange={f('postEmotion')} />
        <Slider label="Confidence Level" min={1} max={5} value={d.confidence} onChange={f('confidence')} suffix="/5" />
        <Slider label="Energy Level" min={1} max={5} value={d.energy} onChange={f('energy')} suffix="/5" />
        <Slider label="Focus Level" min={1} max={5} value={d.focus} onChange={f('focus')} suffix="/5" />
        <Slider label="Confidence at Entry" min={1} max={5} value={d.confidenceEntry} onChange={f('confidenceEntry')} suffix="/5" />
        <Slider label="Focus / Stress Index" min={1} max={10} value={d.stressLevel} onChange={f('stressLevel')} suffix="/10" />
        <Radio label="External Distractions" options={['Yes','No']} value={d.externalDistractions} onChange={f('externalDistractions')} />
      </div>
    </div>
    <div className="tj-section"><div className="tj-section-label">Discipline Review</div>
      <div className="tj-grid tj-g2" style={{ gap: 16 }}>
        <Slider label="Rules Followed" min={0} max={100} step={5} value={d.rulesFollowed} onChange={f('rulesFollowed')} suffix="%" />
        <Radio label="Setup Fully Valid" options={['Yes','No','Partial']} value={d.setupValid} onChange={f('setupValid')} />
        <Radio label="Any Rule Broken" options={['Yes','No']} value={d.ruleBroken} onChange={f('ruleBroken')} />
        {d.ruleBroken === 'Yes' && <Inp label="Which Rule?" placeholder="Describe the rule that was broken..." value={d.whichRule} onChange={f('whichRule')} />}
        <Radio label="Worth Repeating" options={['Yes','No','Conditionally']} value={d.worthRepeating} onChange={f('worthRepeating')} />
        <div className="tj-grid" style={{ gap: 12 }}>
          <Flags label="Bias Flags" options={['Flag Recency Bias']} value={d.recencyBias ? ['Flag Recency Bias'] : []} onChange={v => f('recencyBias')(v.length > 0)} />
          <Inp label="Consecutive Trade Count" type="number" placeholder="3" value={d.consecutiveTrades} onChange={f('consecutiveTrades')} />
        </div>
      </div>
    </div>
    <div className="tj-section"><div className="tj-section-label">Trade Debrief</div>
      <div className="tj-grid" style={{ gap: 12 }}>
        <Txt label="What Worked" value={d.whatWorked} onChange={f('whatWorked')} placeholder="Describe what went well in this trade..." />
        <Txt label="What Failed" value={d.whatFailed} onChange={f('whatFailed')} placeholder="Describe what went wrong or could be improved..." />
        <Txt label="Adjustments to Make" value={d.adjustments} onChange={f('adjustments')} placeholder="What would you do differently next time?" />
        <Txt label="Notes" rows={5} value={d.notes} onChange={f('notes')} placeholder="Any additional observations, ideas, market context, or lessons learned..." />
      </div>
    </div>
  </>;
}

// ─── Main ─────────────────────────────────────────────────────────────────────
const STEPS = [
  { n: 1, label: 'Decision',  Component: Step1, key: 'step1' },
  { n: 2, label: 'Execution', Component: Step2, key: 'step2' },
  { n: 3, label: 'Context',   Component: Step3, key: 'step3' },
  { n: 4, label: 'Review',    Component: Step4, key: 'step4' },
];

export default function TradingJournal({ onSave, trades: initialTrades = [] }) {
  const [step, setStep] = useState(1);
  const [data, setData] = useState({ step1: {}, step2: {}, step3: {}, step4: {} });
  const [savedTrades, setSavedTrades] = useState(initialTrades);

  const setStepData = useCallback(key => val => setData(prev => ({ ...prev, [key]: val })), []);

  const handleExport = () => {
    const e = { timestamp: new Date().toISOString(), ...data.step1, ...data.step2, ...data.step3, ...data.step4 };
    delete e.entryScreenshot; delete e.exitScreenshot;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([JSON.stringify(e, null, 2)], { type: 'application/json' }));
    a.download = `trade-${e.instrument || 'journal'}-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
  };

  const handleSave = () => {
    const entry = { ...data.step1, ...data.step2, ...data.step3, ...data.step4 };
    setSavedTrades(prev => [...prev, entry]);
    if (onSave) onSave(data);
    setData({ step1: {}, step2: {}, step3: {}, step4: {} });
    setStep(1);
  };

  const cur = STEPS[step - 1];

  return (
    <div className="tj-root">
      <Inj css={CSS} />
      <div className="tj-page">

        {/* Form */}
        <div className="tj-shell">
          <div className="tj-progress-bar">
            <div className="tj-progress-fill" style={{ width: `${(step / STEPS.length) * 100}%` }} />
          </div>
          <div className="tj-tabs">
            {STEPS.map(s => (
              <button key={s.n} className={`tj-tab${step === s.n ? ' active' : ''}${step > s.n ? ' done' : ''}`} onClick={() => setStep(s.n)}>
                <span className="tj-tab-num">{step > s.n ? '✓' : s.n}</span>{s.label}
              </button>
            ))}
          </div>
          <div className="tj-body">
            <cur.Component d={data[cur.key]} set={setStepData(cur.key)} />
          </div>
          <div className="tj-nav">
            {step > 1 ? <button className="tj-btn" onClick={() => setStep(s => s - 1)}>← Previous</button> : <div />}
            <div className="tj-btn-row">

              {step < STEPS.length
                ? <button className="tj-btn primary" onClick={() => setStep(s => s + 1)}>Next →</button>
                : <button className="tj-btn primary" onClick={handleSave}>✓ Save Entry</button>
              }
            </div>
          </div>
        </div>

        {/* Stats Sidebar */}
        <Sidebar trades={savedTrades} />

      </div>
    </div>
  );
}
