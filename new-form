// ─── Main Component ───────────────────────────────────────────────────────────
const STEPS = [
  { n: 1, label: 'Decision',  Component: Step1, key: 'step1' },
  { n: 2, label: 'Execution', Component: Step2, key: 'step2' },
  { n: 3, label: 'Context',   Component: Step3, key: 'step3' },
  { n: 4, label: 'Review',    Component: Step4, key: 'step4' },
];

export default function TradingJournal({ onSave }) {
  const [step, setStep] = useState(1);
  const [data, setData] = useState({ step1: {}, step2: {}, step3: {}, step4: {} });

  const setStepData = useCallback((key) => (val) => {
    setData(prev => ({ ...prev, [key]: val }));
  }, []);

  const handleExport = () => {
    const exportData = {
      timestamp: new Date().toISOString(),
      ...data.step1,
      ...data.step2,
      ...data.step3,
      ...data.step4,
    };
    // Remove file objects (not serializable)
    delete exportData.entryScreenshot;
    delete exportData.exitScreenshot;

    const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `trade-${exportData.instrument || 'journal'}-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const handleSave = () => {
    if (onSave) onSave(data);
    else alert('Entry saved! Connect an onSave handler to persist data.');
  };

  const cur = STEPS[step - 1];
  const pct = (step / STEPS.length) * 100;
  const stepLabels = ['Decision', 'Execution', 'Context', 'Review'];

  return (
    <div className="tj-root">
      <Inj css={CSS} />
      <div className="tj-shell">

        {/* Header */}
        <div className="tj-header">
          <div>
            <div className="tj-header-eyebrow">◈ Trade Journal</div>
            <div className="tj-header-title">New Entry</div>
          </div>
          <div className="tj-header-right">
            <div className="tj-header-step-label">{stepLabels[step - 1]}</div>
            <div>Step {step} of {STEPS.length}</div>
          </div>
        </div>

        {/* Progress */}
        <div className="tj-progress-bar">
          <div className="tj-progress-fill" style={{ width: `${pct}%` }} />
        </div>

        {/* Tabs */}
        <div className="tj-tabs">
          {STEPS.map(s => (
            <button
              key={s.n}
              className={`tj-tab${step === s.n ? ' active' : ''}${step > s.n ? ' done' : ''}`}
              onClick={() => setStep(s.n)}
            >
              <span className="tj-tab-num">{step > s.n ? '✓' : s.n}</span>
              {s.label}
            </button>
          ))}
        </div>

        {/* Form Body */}
        <div className="tj-body">
          <cur.Component d={data[cur.key]} set={setStepData(cur.key)} />
        </div>

        {/* Navigation */}
        <div className="tj-nav">
          {step > 1
            ? <button className="tj-btn" onClick={() => setStep(s => s - 1)}>← Previous</button>
            : <div />
          }
          <div className="tj-btn-row">
            {step === STEPS.length && (
              <button className="tj-btn export" onClick={handleExport}>↓ Export JSON</button>
            )}
            {step < STEPS.length
              ? <button className="tj-btn primary" onClick={() => setStep(s => s + 1)}>Next →</button>
              : <button className="tj-btn primary" onClick={handleSave}>✓ Save Entry</button>
            }
          </div>
        </div>

      </div>
    </div>
  );
}
