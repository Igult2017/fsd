// ─── Constants ───────────────────────────────────────────────────────────────
const SETUP_TAGS = ['Breakout','Pullback','Reversal','Continuation','Range','VWAP Reclaim','EMA Bounce','Structure Break','Liquidity Sweep','Fair Value Gap','Supply/Demand','News Play','OB Rejection','Imbalance Fill'];
const SIGNAL_TAGS = ['EMA Cross','RSI Divergence','MACD Signal','Volume Spike','Price Action','Support/Resistance','Fibonacci','Trendline Break','Order Block','Imbalance','CHoCH','BOS','VWAP','Delta Divergence'];
const CANDLE_PATTERNS = ['Engulfing','Pin Bar','Inside Bar','Doji','Hammer','Shooting Star','Morning Star','Evening Star','Marubozu','Three Soldiers','Dark Cloud','Harami','Tweezer Top','Tweezer Bottom'];
const EMOTIONS_LIST = ['Calm','Confident','Anxious','Excited','Hesitant','Overconfident','Frustrated','Focused','Distracted','Fearful','Greedy','Neutral','Rushed','Patient'];
const POST_EMOTIONS = ['Satisfied','Frustrated','Relieved','Regret','Proud','Neutral','Angry','Overjoyed','Indifferent','Motivated'];

// ─── Primitive Components ─────────────────────────────────────────────────────

const Inj = ({ css }) => <style dangerouslySetInnerHTML={{ __html: css }} />;

function Field({ label, sub, children }) {
  return (
    <div className="tj-field">
      <div className="tj-label">{label}</div>
      {sub && <div className="tj-sub">{sub}</div>}
      {children}
    </div>
  );
}

function Inp({ label, sub, type = 'text', placeholder, value, onChange }) {
  return (
    <Field label={label} sub={sub}>
      <input className="tj-input" type={type} placeholder={placeholder || ''} value={value || ''} onChange={e => onChange(e.target.value)} />
    </Field>
  );
}

function Sel({ label, sub, options, value, onChange }) {
  return (
    <Field label={label} sub={sub}>
      <select className="tj-select" value={value || ''} onChange={e => onChange(e.target.value)}>
        <option value="">— select —</option>
        {options.map(o => <option key={o} value={o}>{o}</option>)}
      </select>
    </Field>
  );
}

function Txt({ label, value, onChange, placeholder, rows = 3 }) {
  return (
    <Field label={label}>
      <textarea className="tj-textarea" rows={rows} placeholder={placeholder || ''} value={value || ''} onChange={e => onChange(e.target.value)} />
    </Field>
  );
}

function Radio({ label, options, value, onChange }) {
  return (
    <Field label={label}>
      <div className="tj-radio-group">
        {options.map(o => (
          <div key={o} className={`tj-radio${value === o ? ' sel' : ''}`} onClick={() => onChange(o)}>{o}</div>
        ))}
      </div>
    </Field>
  );
}

function Tags({ label, options, value = [], onChange }) {
  const toggle = o => onChange(value.includes(o) ? value.filter(x => x !== o) : [...value, o]);
  return (
    <Field label={label}>
      <div className="tj-tag-row">
        {options.map(o => (
          <div key={o} className={`tj-tag${value.includes(o) ? ' sel' : ''}`} onClick={() => toggle(o)}>{o}</div>
        ))}
      </div>
    </Field>
  );
}

function Flags({ label, options, value = [], onChange }) {
  const toggle = o => onChange(value.includes(o) ? value.filter(x => x !== o) : [...value, o]);
  return (
    <Field label={label}>
      <div className="tj-flag-row">
        {options.map(o => (
          <div key={o} className={`tj-flag${value.includes(o) ? ' sel' : ''}`} onClick={() => toggle(o)}>{o}</div>
        ))}
      </div>
    </Field>
  );
}

function Stars({ label, value = 0, onChange, max = 5 }) {
  return (
    <Field label={label}>
      <div className="tj-stars">
        {Array.from({ length: max }).map((_, i) => (
          <span key={i} className={`tj-star${i < value ? ' lit' : ''}`} onClick={() => onChange(i + 1)}>★</span>
        ))}
      </div>
    </Field>
  );
}

function Dots({ name, value = 0, onChange, max = 5 }) {
  return (
    <div className="tj-score-row">
      <div className="tj-score-name">{name}</div>
      <div className="tj-dots">
        {Array.from({ length: max }).map((_, i) => (
          <div key={i} className={`tj-dot${i < value ? ' lit' : ''}`} onClick={() => onChange(i + 1)} />
        ))}
      </div>
    </div>
  );
}

function Slider({ label, min = 1, max = 5, step = 1, value, onChange, suffix = '' }) {
  return (
    <Field label={label}>
      <div className="tj-slider-row">
        <input className="tj-slider" type="range" min={min} max={max} step={step} value={value || min} onChange={e => onChange(Number(e.target.value))} />
        <div className="tj-slider-val">{value || min}{suffix}</div>
      </div>
    </Field>
  );
}

function Upload({ label, value, onChange }) {
  const handleFile = e => {
    const file = e.target.files[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    onChange({ file, url, name: file.name });
  };
  return (
    <Field label={label}>
      <div className="tj-upload">
        <input type="file" accept="image/*" onChange={handleFile} />
        {!value ? (
          <>
            <div className="tj-upload-icon">↑</div>
            <div>Click to upload screenshot</div>
          </>
        ) : (
          <>
            <img className="tj-upload-thumb" src={value.url} alt="screenshot" />
            <div className="tj-upload-name">{value.name}</div>
          </>
        )}
      </div>
    </Field>
  );
}

function Triplet({ label, fields, data = {}, onChange }) {
  return (
    <Field label={label}>
      <div className="tj-triplet">
        {fields.map(f => (
          <div key={f.key}>
            <input
              className="tj-input"
              type={f.type || 'text'}
              placeholder={f.ph || ''}
              value={data[f.key] || ''}
              onChange={e => onChange({ ...data, [f.key]: e.target.value })}
            />
            <div className="tj-triplet-sub">{f.label}</div>
          </div>
        ))}
      </div>
    </Field>
  );
}

// ─── Step 1: Decision ─────────────────────────────────────────────────────────
function Step1({ d, set }) {
  const f = k => v => set({ ...d, [k]: v });
  return (
    <>
      <div className="tj-section">
        <div className="tj-section-label">Thesis &amp; Logic</div>
        <div className="tj-grid" style={{ gap: 12 }}>
          <Txt label="Trade Thesis" value={d.thesis} onChange={f('thesis')} placeholder="What is the core reasoning behind this trade?" rows={3} />
          <div className="tj-grid tj-g2">
            <Txt label="Trigger" value={d.trigger} onChange={f('trigger')} placeholder="What triggered your entry?" rows={2} />
            <Txt label="Invalidation Logic" value={d.invalidation} onChange={f('invalidation')} placeholder="What would make this setup invalid?" rows={2} />
          </div>
          <Txt label="Expected Behavior" value={d.expected} onChange={f('expected')} placeholder="How do you expect price to move?" rows={2} />
        </div>
      </div>

      <div className="tj-section">
