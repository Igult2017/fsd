// ─── Form primitives ──────────────────────────────────────────────────────────
const Inj = ({ css }) => <style dangerouslySetInnerHTML={{ __html: css }} />;

function Field({ label, sub, children }) {
  return <div className="tj-field"><div className="tj-label">{label}</div>{sub && <div className="tj-sub">{sub}</div>}{children}</div>;
}
function Inp({ label, sub, type = 'text', placeholder, value, onChange }) {
  return <Field label={label} sub={sub}><input className="tj-input" type={type} placeholder={placeholder || ''} value={value || ''} onChange={e => onChange(e.target.value)} /></Field>;
}
function Sel({ label, sub, options, value, onChange }) {
  return <Field label={label} sub={sub}><select className="tj-select" value={value || ''} onChange={e => onChange(e.target.value)}><option value="">— select —</option>{options.map(o => <option key={o} value={o}>{o}</option>)}</select></Field>;
}
function Txt({ label, value, onChange, placeholder, rows = 3 }) {
  return <Field label={label}><textarea className="tj-textarea" rows={rows} placeholder={placeholder || ''} value={value || ''} onChange={e => onChange(e.target.value)} /></Field>;
}
function Radio({ label, options, value, onChange }) {
  return <Field label={label}><div className="tj-radio-group">{options.map(o => <div key={o} className={`tj-radio${value === o ? ' sel' : ''}`} onClick={() => onChange(o)}>{o}</div>)}</div></Field>;
}
function Tags({ label, options, value = [], onChange }) {
  const toggle = o => onChange(value.includes(o) ? value.filter(x => x !== o) : [...value, o]);
  return <Field label={label}><div className="tj-tag-row">{options.map(o => <div key={o} className={`tj-tag${value.includes(o) ? ' sel' : ''}`} onClick={() => toggle(o)}>{o}</div>)}</div></Field>;
}
function Flags({ label, options, value = [], onChange }) {
  const toggle = o => onChange(value.includes(o) ? value.filter(x => x !== o) : [...value, o]);
  return <Field label={label}><div className="tj-flag-row">{options.map(o => <div key={o} className={`tj-flag${value.includes(o) ? ' sel' : ''}`} onClick={() => toggle(o)}>{o}</div>)}</div></Field>;
}
function Dots({ name, value = 0, onChange, max = 5 }) {
  return <div className="tj-score-row"><div className="tj-score-name">{name}</div><div className="tj-dots">{Array.from({ length: max }).map((_, i) => <div key={i} className={`tj-dot${i < value ? ' lit' : ''}`} onClick={() => onChange(i + 1)} />)}</div></div>;
}
function Slider({ label, min = 1, max = 5, step = 1, value, onChange, suffix = '' }) {
  return <Field label={label}><div className="tj-slider-row"><input className="tj-slider" type="range" min={min} max={max} step={step} value={value || min} onChange={e => onChange(Number(e.target.value))} /><div className="tj-slider-val">{value || min}{suffix}</div></div></Field>;
}
function Upload({ label, value, onChange }) {
  const handleFile = e => { const f = e.target.files[0]; if (f) onChange({ file: f, url: URL.createObjectURL(f), name: f.name }); };
  return <Field label={label}><div className="tj-upload"><input type="file" accept="image/*" onChange={handleFile} />{!value ? <><div className="tj-upload-icon">↑</div><div>Click to upload screenshot</div></> : <><img className="tj-upload-thumb" src={value.url} alt="" /><div className="tj-upload-name">{value.name}</div></>}</div></Field>;
}
function Triplet({ label, fields, data = {}, onChange }) {
  return <Field label={label}><div className="tj-triplet">{fields.map(f => <div key={f.key}><input className="tj-input" type={f.type || 'text'} placeholder={f.ph || ''} value={data[f.key] || ''} onChange={e => onChange({ ...data, [f.key]: e.target.value })} /><div className="tj-triplet-sub">{f.label}</div></div>)}</div></Field>;
}

