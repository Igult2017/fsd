// ─── Constants ────────────────────────────────────────────────────────────────
const SETUP_TAGS = ['Breakout','Pullback','Reversal','Continuation','Range','VWAP Reclaim','EMA Bounce','Structure Break','Liquidity Sweep','Fair Value Gap','Supply/Demand','News Play','OB Rejection','Imbalance Fill'];
const SIGNAL_TAGS = ['EMA Cross','RSI Divergence','MACD Signal','Volume Spike','Price Action','Support/Resistance','Fibonacci','Trendline Break','Order Block','Imbalance','CHoCH','BOS','VWAP','Delta Divergence'];
const CANDLE_PATTERNS = ['Engulfing','Pin Bar','Inside Bar','Doji','Hammer','Shooting Star','Morning Star','Evening Star','Marubozu','Three Soldiers','Dark Cloud','Harami','Tweezer Top','Tweezer Bottom'];
const EMOTIONS_LIST = ['Calm','Confident','Anxious','Excited','Hesitant','Overconfident','Frustrated','Focused','Distracted','Fearful','Greedy','Neutral','Rushed','Patient'];
const POST_EMOTIONS = ['Satisfied','Frustrated','Relieved','Regret','Proud','Neutral','Angry','Overjoyed','Indifferent','Motivated'];

// ─── Stats computation ────────────────────────────────────────────────────────
function computeStats(trades) {
  if (!trades.length) return null;
  const wins = trades.filter(t => t.outcome === 'Win');
  const losses = trades.filter(t => t.outcome === 'Loss');
  const pnls = trades.map(t => parseFloat(t.pnl) || 0);
  const netPnL = pnls.reduce((a, b) => a + b, 0);
  const winPnLs = wins.map(t => parseFloat(t.pnl) || 0);
  const lossPnLs = losses.map(t => parseFloat(t.pnl) || 0);
  const bestTrade = pnls.length ? Math.max(...pnls) : 0;
  const worstTrade = pnls.length ? Math.min(...pnls) : 0;
  const grossWin = winPnLs.reduce((a, b) => a + b, 0);
  const grossLoss = Math.abs(lossPnLs.reduce((a, b) => a + b, 0));
  const profitFactor = grossLoss > 0 ? grossWin / grossLoss : grossWin > 0 ? 999 : 0;
  const winRate = trades.length > 0 ? (wins.length / trades.length) * 100 : 0;
  const commissions = trades.reduce((a, t) => a + (parseFloat(t.commission) || 0), 0);
  const startBalance = parseFloat(trades[0]?.balance) || 0;
  const endBalance = parseFloat(trades[trades.length - 1]?.balance) || 0;
  const growth = startBalance > 0 ? ((endBalance - startBalance) / startBalance) * 100 : 0;
  const rrTrades = trades.filter(t => t.achievedRR);
  const avgRR = rrTrades.length ? rrTrades.reduce((a, t) => a + (parseFloat(t.achievedRR) || 0), 0) / rrTrades.length : 0;
  const avgWin = wins.length ? grossWin / wins.length : 0;
  const avgLoss = losses.length ? grossLoss / losses.length : 0;
  const expectancy = (winRate / 100) * avgWin - (1 - winRate / 100) * avgLoss;
  return {
    netPnL, winRate, wins: wins.length, losses: losses.length,
    total: trades.length, bestTrade, worstTrade,
    profitFactor: profitFactor.toFixed(2), commissions,
    startBalance, endBalance, growth,
    avgRR: avgRR.toFixed(2), expectancy: expectancy.toFixed(2),
    buys: trades.filter(t => t.direction === 'Long').length,
    sells: trades.filter(t => t.direction === 'Short').length,
  };
}

const fmtUsd = n => (n >= 0 ? '+' : '-') + '$' + Math.abs(n).toFixed(2);

// ─── Sidebar ──────────────────────────────────────────────────────────────────
function Sidebar({ trades }) {
  const stats = useMemo(() => computeStats(trades), [trades]);
  const has = trades.length > 0;
  const pnlCls = stats ? (stats.netPnL > 0 ? 'pos' : stats.netPnL < 0 ? 'neg' : '') : '';
  const growthCls = stats ? (stats.growth > 0 ? '' : stats.growth < 0 ? 'neg' : 'zero') : 'zero';

  return (
    <div className="tj-sidebar">
      <div className="sb-eyebrow">Session</div>

      <div className="sb-growth-row">
        <span className="sb-growth-label">Portfolio growth</span>
        <span className={`sb-growth-val ${growthCls}`}>
          {stats ? (stats.growth >= 0 ? '+' : '') + stats.growth.toFixed(1) + '%' : '+0.0%'}
        </span>
      </div>

      <div className="sb-card">
