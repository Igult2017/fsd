                {['EUR/USD', 'GBP/JPY', 'BTC/USD', 'XAU/USD'].map(t => (
                  <div key={t} className="flex items-center gap-4">
                    <span className="text-[10px] font-black text-white w-16 tracking-tighter italic">{t}</span>
                    <div className="flex-1 h-0.5 bg-[#161b22] rounded-full overflow-hidden">
                      <div className="h-full bg-sky-500 rounded-full" style={{ width: t === 'EUR/USD' ? '85%' : t === 'GBP/JPY' ? '60%' : t === 'BTC/USD' ? '50%' : '40%' }}></div>
                    </div>
                    <span className="text-[9px] font-black text-slate-600 tabular-nums w-4 text-right">{t === 'EUR/USD' ? '18' : '12'}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Trade Log & Calendar */}
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <div className="lg:col-span-7 bg-[#0d1117] border border-white/10 rounded-2xl overflow-hidden shadow-xl flex flex-col">
              <div className="p-4 border-b border-white/10 flex items-center justify-between">
                <span className="text-[11px] font-black uppercase tracking-[0.2em] text-sky-400 italic">RECENT TRADE LOG</span>
                <Activity size={14} strokeWidth={3} className="text-sky-400 opacity-30" />
              </div>
              <div className="overflow-x-auto flex-1">
                <table className="w-full text-left border-collapse">
                  <thead className="bg-[#161b22]/50 text-[8px] text-slate-600 uppercase font-black">
                    <tr>
                      <th className="px-5 py-3 tracking-[0.2em]">INSTRUMENT</th>
                      <th className="px-5 py-3 text-center tracking-[0.2em]">ACTION</th>
                      <th className="px-5 py-3 text-right tracking-[0.2em]">NET P&L</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-white/5">
                    {TRADES.map(t => (
                      <tr key={t.id} className="group hover:bg-white/[0.01] transition-colors">
                        <td className="px-5 py-3">
                          <div className="font-black text-white text-[11px] tracking-tight">{t.ticker}</div>
                          <div className="text-[8px] font-black text-slate-600 tabular-nums tracking-widest uppercase">{t.date}</div>
                        </td>
                        <td className="px-5 py-3 text-center">
                          <span className={`inline-block px-3 py-0.5 rounded-sm text-[8px] font-black tracking-[0.2em] ${t.type === 'LONG' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/10' : 'bg-rose-500/10 text-rose-400 border border-rose-500/10'}`}>
                            {t.type}
                          </span>
                        </td>
                        <td className="px-5 py-3 text-right">
                          <span className={`font-black text-[11px] tabular-nums tracking-tight ${t.status === 'profit' ? 'text-emerald-400' : 'text-rose-400'}`}>
                            {t.status === 'profit' ? '+' : '-'}${Math.abs(t.pnl).toFixed(2)}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="lg:col-span-5 bg-[#0d1117] border border-white/10 p-5 rounded-2xl shadow-xl">
              <div className="flex items-center justify-between mb-6">
                <div className="flex items-center gap-2">
                  <div className="w-7 h-7 flex items-center justify-center bg-sky-500/10 rounded text-sky-400 border border-sky-500/10">
                    <Activity size={14} strokeWidth={3} />
                  </div>
                  <h2 className="text-[11px] font-black text-sky-400 uppercase tracking-[0.2em]">ACTIVITY</h2>
                </div>
              </div>
              <div className="text-center font-black text-white text-[10px] mb-4 uppercase tracking-[0.3em]">OCTOBER 2023</div>
              <div className="grid grid-cols-7 gap-1.5">
                {['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'].map(d => (
                  <div key={`header-${d}`} className="text-[8px] font-black text-slate-700 text-center tracking-tighter">{d[0]}</div>
                ))}
                {heatmapDays.map(d => (
                  <div key={`day-${d.day}`} className={`aspect-square flex items-center justify-center rounded-sm text-[10px] font-black border transition-all tabular-nums ${
                    d.status === 'profit' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/20' :
                    d.status === 'loss' ? 'bg-rose-500/20 text-rose-400 border-rose-500/20' :
                    'bg-[#161b22] text-slate-700 border-transparent opacity-40'
                  }`}>
                    {d.day}
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>
      </main>
    </div>
  );
}
