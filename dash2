// Catmull-Rom to cubic bezier path
function catmullRomPath(points) {
  if (points.length < 2) return '';
  let d = `M ${points[0].x},${points[0].y}`;
  for (let i = 0; i < points.length - 1; i++) {
    const p0 = points[Math.max(i - 1, 0)];
    const p1 = points[i];
    const p2 = points[i + 1];
    const p3 = points[Math.min(i + 2, points.length - 1)];
    const cp1x = p1.x + (p2.x - p0.x) / 6;
    const cp1y = p1.y + (p2.y - p0.y) / 6;
    const cp2x = p2.x - (p3.x - p1.x) / 6;
    const cp2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${cp1x},${cp1y} ${cp2x},${cp2y} ${p2.x},${p2.y}`;
  }
  return d;
}

const NeonLineChart = ({ data, view }) => {
  const W = 600, H = 260;
  const padL = 36, padR = 16, padT = 20, padB = 32;
  const innerW = W - padL - padR;
  const innerH = H - padT - padB;

  const minVal = 0;
  const maxVal = Math.max(...data.map(d => d.pnl)) * 1.15;

  const pts = data.map((d, i) => ({
    x: padL + (i / (data.length - 1)) * innerW,
    y: padT + innerH - ((d.pnl - minVal) / (maxVal - minVal)) * innerH,
    label: d.label,
    pnl: d.pnl,
  }));

  const linePath = catmullRomPath(pts);
  const areaPath = linePath + ` L ${pts[pts.length-1].x},${padT + innerH} L ${pts[0].x},${padT + innerH} Z`;

  // Grid lines (4 horizontal)
  const gridLines = [0.25, 0.5, 0.75, 1].map(t => ({
    y: padT + innerH * (1 - t),
    val: Math.round(minVal + (maxVal - minVal) * t),
  }));

  const lastPt = pts[pts.length - 1];

  return (
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" height="100%" style={{ overflow: 'visible' }}>
      <defs>
        <linearGradient id="neonFill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor="#7c3aed" stopOpacity="0.45" />
          <stop offset="60%" stopColor="#4f46e5" stopOpacity="0.15" />
          <stop offset="100%" stopColor="#1e1b4b" stopOpacity="0" />
        </linearGradient>
        <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3.5" result="blur1" />
          <feGaussianBlur stdDeviation="7" result="blur2" />
          <feMerge>
            <feMergeNode in="blur2"/>
            <feMergeNode in="blur1"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
        <filter id="dotGlow">
          <feGaussianBlur stdDeviation="3" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>

      {/* Horizontal dashed grid */}
      {gridLines.map((g, i) => (
        <g key={i}>
          <line x1={padL} y1={g.y} x2={W - padR} y2={g.y}
            stroke="rgba(99,120,180,0.18)" strokeWidth="1" strokeDasharray="3 6" />
          <text x={padL - 6} y={g.y + 4} textAnchor="end"
            fill="rgba(99,120,180,0.45)" fontSize="8" fontFamily="Montserrat,sans-serif" fontWeight="900">
            {g.val > 999 ? `${(g.val/1000).toFixed(1)}k` : g.val}
          </text>
        </g>
      ))}

      {/* Area fill */}
      <path d={areaPath} fill="url(#neonFill)" />

      {/* Glow line (thick, blurred) */}
      <path d={linePath} fill="none" stroke="#7c6fff" strokeWidth="6" strokeLinecap="round" strokeLinejoin="round"
        style={{ filter: 'blur(6px)', opacity: 0.55 }} />

      {/* Core neon line */}
      <path d={linePath} fill="none" stroke="#a78bfa" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"
        filter="url(#glow)" />

      {/* Bright inner line */}
      <path d={linePath} fill="none" stroke="#c4b5fd" strokeWidth="1.2" strokeLinecap="round" strokeLinejoin="round" />

      {/* X-axis labels */}
      {pts.filter((_, i) => i % Math.ceil(pts.length / 6) === 0 || i === pts.length - 1).map((p, i) => (
        <text key={i} x={p.x} y={H - 6} textAnchor="middle"
          fill="rgba(99,120,180,0.5)" fontSize="8" fontFamily="Montserrat,sans-serif" fontWeight="900">
          {p.label}
        </text>
      ))}

      {/* End dot with glow */}
      <circle cx={lastPt.x} cy={lastPt.y} r="7" fill="#1e1b4b" stroke="#7c6fff" strokeWidth="1.5"
        style={{ filter: 'drop-shadow(0 0 6px #7c6fff)' }} />
      <circle cx={lastPt.x} cy={lastPt.y} r="3.5" fill="#c4b5fd"
        style={{ filter: 'drop-shadow(0 0 4px #c4b5fd)' }} />
    </svg>
  );
};

