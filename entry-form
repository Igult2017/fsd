                        <div className="relative group">
                          <img src={formData.screenshot} alt="Trade Evidence" className="w-full h-auto max-h-[400px] object-contain rounded-2xl" />
                          <div className="absolute inset-0 bg-slate-950/70 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all flex items-center justify-center gap-4">
                            <label htmlFor="chart-upload" className="p-4 bg-blue-600 rounded-2xl cursor-pointer hover:bg-blue-500 transition-all shadow-xl">
                              <RefreshCcw className="w-6 h-6 text-white" />
                            </label>
                            <button onClick={() => updateField('screenshot', null)} className="p-4 bg-rose-600 rounded-2xl hover:bg-rose-500 transition-all shadow-xl">
                              <Trash2 className="w-6 h-6 text-white" />
                            </button>
                          </div>
                        </div>
                      ) : (
                        <label htmlFor="chart-upload" className="flex flex-col items-center justify-center p-10 md:p-14 cursor-pointer">
                          <div className="w-16 h-16 bg-slate-900/60 rounded-2xl flex items-center justify-center mb-5 group-hover:scale-110 group-hover:bg-blue-600/10 transition-all border-2 border-slate-800/60">
                            <Camera className="w-7 h-7 text-slate-500 group-hover:text-blue-400" />
                          </div>
                          <span className="text-sm font-bold text-slate-300">Visual Evidence Required</span>
                          <span className="text-[9px] text-slate-600 font-black uppercase tracking-[0.12em] mt-1">Attach Final Position Chart</span>
                        </label>
                      )}
                    </div>
                  </div>

                  <InputField label="Screenshot Time" field="screenshotTimestamp" type="time" />
                  <InputField label="Instrument / Pair" field="instrument" placeholder="e.g. BTCUSD, XAUUSD" />
                  <SelectField label="Direction" field="direction" options={['Long', 'Short']} />
                  
                  <InputField label="Entry Date/Time" field="entryTime" type="datetime-local" />
                  <InputField label="Exit Date/Time" field="exitTime" type="datetime-local" />
                  <SelectField label="Day of Week" field="dayOfWeek" options={['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']} />
                  
                  <InputField label="Trade Duration" field="tradeDuration" placeholder="e.g. 2h 30m" />
                  <InputField label="Lot Size / Units" field="lotSize" placeholder="0.01" />
                  <SelectField label="Order Type" field="orderType" options={['Market', 'Limit', 'Stop', 'Stop-Limit']} />
                  
                  <InputField label="Entry Price" field="entryPrice" type="number" placeholder="0.00" />
                  <InputField label="Stop-Loss" field="stopLoss" type="number" />
                  <InputField label="SL (Pips)" field="stopLossDistancePips" type="number" />
                  
                  <InputField label="Take-Profit" field="takeProfit" type="number" />
                  <InputField label="TP (Pips)" field="takeProfitDistancePips" type="number" />
                  <InputField label="Risk %" field="riskPercent" type="number" />
                  
                  <InputField label="Pips G/L" field="pipsGainedLost" type="number" />
                  <InputField label="P/L ($)" field="profitLoss" type="number" />
                  <SelectField label="Outcome" field="outcome" options={['Win', 'Loss', 'BE']} />
                  
                  <SelectField label="Entry TF" field="entryTF" options={['1M', '3M', '5M', '15M']} />
                  <SelectField label="Analysis TF" field="analysisTF" options={['15M', '30MIN', '1HR', '2HR', '4HR']} />
                  <SelectField label="Context TF" field="contextTF" options={['1W', '1D', '4HR']} />
                </div>
              </div>
            )}

            {/* STEP 3: MARKET CONTEXT (Original Step 2) */}
            {step === 3 && (
              <div className="space-y-10">
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-10">
                  <div className="space-y-8">
                    <SectionHeader icon={Boxes} title="Environment Map" color="indigo" />
                    <div className="grid grid-cols-2 gap-4">
                      <SelectField label="Market Regime" field="marketRegime" options={['Trending', 'Ranging']} />
                      <SelectField label="Trend Direction" field="trendDirection" options={['Bullish', 'Bearish', 'Sideways']} />
                      <SelectField label="Volatility State" field="volatilityState" options={['Low', 'Normal', 'High']} />
                      <SelectField label="Liquidity" field="liquidity" options={['Low', 'Normal', 'High']} />
                    </div>

                    <div className="col-span-2 p-6 bg-slate-950/40 border-2 border-slate-800/60 rounded-2xl space-y-4">
                      <InputField 
                        label="Bias & Liquidity Targets" 
                        field="liquidityTargets" 
                        rows={3}
                        placeholder="Where are major liquidity pools? Stop hunts? Key psychological levels? What's the market bias?"
                      />
                      <div className="flex items-start gap-2 p-3 bg-cyan-500/5 border border-cyan-500/20 rounded-xl">
                        <Target className="w-4 h-4 text-cyan-400 mt-0.5 shrink-0" />
                        <p className="text-[10px] text-cyan-300/90 leading-relaxed">
                          <span className="font-black">Purpose:</span> Identifies where smart money is positioned and key reaction zones.
                        </p>
                      </div>
                    </div>
                    
                    <SectionHeader icon={Clock} title="Session Timing" color="indigo" />
                    <div className="grid grid-cols-2 gap-4">
                      <InputField label="Entry UTC" field="entryTimeUTC" type="time" />
                      <SelectField label="Session" field="sessionName" options={['London', 'New York', 'Tokyo', 'Sydney', 'Overlap']} />
                    </div>
                  </div>

                  <div className="space-y-8">
                    <SectionHeader icon={Gauge} title="Setup Fidelity" color="indigo" />
                    <div className="p-6 bg-slate-950/40 border-2 border-slate-800/60 rounded-3xl space-y-6">
                      <ScoreSlider label="Market Alignment" field="marketAlignment" />
                      <ScoreSlider label="Setup Clarity" field="setupClarity" />
                      <ScoreSlider label="Entry Precision" field="entryPrecision" />
                      <ScoreSlider label="Confluence" field="confluence" />
                      <ScoreSlider label="Timing Quality" field="timingQuality" />
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* STEP 4: POST-TRADE REVIEW (Original Step 3) */}
            {step === 4 && (
              <div className="space-y-10">
                <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
                  <div className="lg:col-span-2 space-y-8">
                    <SectionHeader icon={BarChart3} title="Execution Metrics" color="violet" />
                    <div className="grid grid-cols-2 sm:grid-cols-3 gap-4">
                      <InputField label="Planned RR" field="plannedRR" placeholder="1:2" />
                      <InputField label="Achieved RR" field="achievedRR" placeholder="1:1.5" />
                      <SelectField label="Risk Heat" field="riskHeat" options={['Low', 'Medium', 'High']} />
                      <InputField label="MAE (Max Adverse)" field="mae" placeholder="-15 pips" />
                      <InputField label="MFE (Max Favorable)" field="mfe" placeholder="+45 pips" />
                      <InputField label="Account Balance" field="accountBalance" type="number" />
                    </div>

                    <SectionHeader icon={BrainCircuit} title="Cognitive State" color="violet" />
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      <SelectField label="Emotional State" field="emotionalState" options={['Calm', 'Anxious', 'FOMO', 'Confident', 'Fearful', 'Neutral']} />
                      <SelectField label="Focus/Stress" field="focusStressLevel" options={['Low', 'Medium', 'High']} />
                      <InputField label="% Rules Followed" field="rulesFollowed" type="number" />
                      <InputField label="Confidence Level (1-5)" field="confidenceLevel" type="number" />
                    </div>
                  </div>

                  <div className="p-6 bg-slate-950/40 border-2 border-slate-800/60 rounded-3xl space-y-6 h-fit">
                    <SectionHeader icon={Workflow} title="Performance Review" color="violet" />
                    <div className="space-y-4">
                        <div className="space-y-2">
                            <label className="text-[9px] font-black text-slate-500 uppercase tracking-[0.12em]">What Worked</label>
                            <textarea 
                                className="w-full p-4 rounded-xl bg-slate-900/60 border-2 border-slate-800/80 text-xs text-white font-semibold outline-none focus:border-emerald-500/60 focus:ring-4 focus:ring-emerald-500/10 transition-all resize-none" 
                                rows="3"
                                placeholder="What did you execute well?"
                                value={formData.whatWorked}
                                onChange={(e) => updateField('whatWorked', e.target.value)}
                            />
                        </div>
                        <div className="space-y-2">
                            <label className="text-[9px] font-black text-slate-500 uppercase tracking-[0.12em]">What Failed</label>
                            <textarea 
                                className="w-full p-4 rounded-xl bg-slate-900/60 border-2 border-slate-800/80 text-xs text-white font-semibold outline-none focus:border-rose-500/60 focus:ring-4 focus:ring-rose-500/10 transition-all resize-none" 
                                rows="3"
                                placeholder="What went wrong?"
                                value={formData.whatFailed}
                                onChange={(e) => updateField('whatFailed', e.target.value)}
                            />
                        </div>
                        <div className="space-y-2">
                            <label className="text-[9px] font-black text-slate-500 uppercase tracking-[0.12em]">Adjustments</label>
                            <textarea 
                                className="w-full p-4 rounded-xl bg-slate-900/60 border-2 border-slate-800/80 text-xs text-white font-semibold outline-none focus:border-blue-500/60 focus:ring-4 focus:ring-blue-500/10 transition-all resize-none" 
                                rows="3"
                                placeholder="What will you change next time?"
                                value={formData.adjustments}
                                onChange={(e) => updateField('adjustments', e.target.value)}
                            />
                        </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>

          <footer className="p-6 md:p-8 border-t-2 border-slate-800/60 bg-slate-950/70 backdrop-blur-sm flex justify-between items-center mt-auto shrink-0">
            <button
              onClick={prevStep}
              className={`flex items-center gap-2 px-4 md:px-6 py-3 rounded-xl font-bold text-[10px] uppercase tracking-[0.12em] transition-all ${step === 1 ? 'opacity-0 pointer-events-none' : 'text-slate-500 hover:text-white hover:bg-slate-800'}`}
            >
              <ChevronLeft className="w-4 h-4" /> Back
            </button>
            
            {step < 4 ? (
              <button
                onClick={nextStep}
                className="group flex items-center gap-3 px-6 md:px-8 py-3 md:py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white rounded-2xl font-black text-[10px] uppercase tracking-[0.12em] shadow-xl shadow-blue-600/25 transition-all hover:-translate-y-0.5"
              >
                Next Phase <ChevronRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </button>
            ) : (
              <button
                onClick={() => {
                  console.log('Final Data:', formData);
                  setShowSuccessModal(true);
                }}
                className="flex items-center gap-3 px-8 md:px-10 py-3 md:py-4 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-white rounded-2xl font-black text-[10px] uppercase tracking-[0.12em] shadow-xl shadow-emerald-600/25 transition-all hover:-translate-y-0.5"
              >
                <Save className="w-4 h-4" /> Finalize Journal
              </button>
            )}
          </footer>
        </div>
      </div>

      {/* Success Modal */}
      {showSuccessModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/90 backdrop-blur-md">
            <div className="bg-slate-900 border-2 border-slate-800/60 rounded-[2rem] p-8 max-w-md w-full text-center shadow-2xl animate-in zoom-in-95 duration-300">
                <div className="w-20 h-20 bg-gradient-to-br from-emerald-500/20 to-green-500/20 rounded-full flex items-center justify-center mx-auto mb-6 relative">
                    <CheckCircle2 className="w-10 h-10 text-emerald-400" />
                    <div className="absolute inset-0 bg-emerald-500/20 rounded-full animate-ping" />
                </div>
                <h3 className="text-2xl font-black text-white mb-2 tracking-tight">Trade Logged Successfully</h3>
                <p className="text-slate-400 text-sm mb-8 font-semibold">Your complete decision architecture and trade data have been recorded to the console.</p>
                <button 
                    onClick={() => {
                        setShowSuccessModal(false);
                        resetForm();
                    }}
                    className="w-full py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white rounded-xl font-black text-xs uppercase tracking-[0.12em] transition-all shadow-lg shadow-blue-600/20"
                >
                    Dismiss & Reset
                </button>
            </div>
        </div>
      )}

      <style>{`
        .custom-scrollbar::-webkit-scrollbar {
          width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
          background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
          background: linear-gradient(180deg, #1e293b 0%, #334155 100%);
          border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
          background: linear-gradient(180deg, #334155 0%, #475569 100%);
        }
        .scrollbar-hide::-webkit-scrollbar {
          display: none;
        }
        .scrollbar-hide {
          -ms-overflow-style: none;
          scrollbar-width: none;
        }
        @keyframes in {
          from {
            opacity: 0;
            transform: scale(0.95);
          }
          to {
            opacity: 1;
            transform: scale(1);
          }
        }
        .animate-in {
          animation: in 0.3s ease-out;
        }
        .zoom-in-95 {
          transform: scale(0.95);
        }
      `}</style>
    </div>
  );
};

export default App;
