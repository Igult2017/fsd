import { useState } from "react";

const tabs = [
  {
    num: "01",
    label: "Strategy Audit",
    sub: "Setup & rules review",
    icon: (color) => (
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke={color} strokeWidth="1.4" strokeLinecap="round">
        <line x1="3" y1="1" x2="3" y2="3" />
        <rect x="1.5" y="3" width="3" height="5" rx="0.5" />
        <line x1="3" y1="8" x2="3" y2="10" />
        <line x1="8" y1="4" x2="8" y2="6" />
        <rect x="6.5" y="6" width="3" height="4" rx="0.5" />
        <line x1="8" y1="10" x2="8" y2="12" />
        <line x1="13" y1="2" x2="13" y2="5" />
        <rect x="11.5" y="5" width="3" height="4" rx="0.5" />
        <line x1="13" y1="9" x2="13" y2="11" />
      </svg>
    ),
  },
  {
    num: "02",
    label: "Evidence & Proof",
    sub: "Trade log & entries",
    icon: (color) => (
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke={color} strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round">
        <path d="M6 2h4a1 1 0 0 1 0 2H6a1 1 0 0 1 0-2z" />
        <path d="M4 3H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-1" />
        <path d="M5.5 9l1.5 1.5 3.5-3.5" />
      </svg>
    ),
  },
  {
    num: "03",
    label: "Diagnostics",
    sub: "Drawdown & mistakes",
    icon: (color) => (
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke={color} strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round">
        <polyline points="1,8 4,8 5.5,4 7.5,12 9.5,6 11,8 15,8" />
      </svg>
    ),
  },
  {
    num: "04",
    label: "Action & Iteration",
    sub: "Fixes & next cycle",
    icon: (color) => (
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke={color} strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round">
        <path d="M13.5 8a5.5 5.5 0 1 1-1.1-3.3" />
        <polyline points="14,2 13.5,5.5 10,5" />
      </svg>
    ),
  },
];

const GREEN = "#2ee89a";
const BLUE  = "#4f8ef7";
const MUTED = "rgba(255,255,255,0.28)";

const COLORS = {
  done:   { num: "rgba(46,232,154,0.55)",  icon: GREEN, label: "rgba(255,255,255,0.38)", sub: "rgba(46,232,154,0.45)",  border: "rgba(46,232,154,0.28)",  bg: "rgba(46,232,154,0.06)"  },
  active: { num: BLUE,                     icon: BLUE,  label: "#ffffff",                sub: "rgba(79,142,247,0.85)", border: "rgba(79,142,247,0.55)",  bg: "rgba(79,142,247,0.12)"  },
  idle:   { num: "rgba(255,255,255,0.18)", icon: MUTED, label: "rgba(255,255,255,0.3)",  sub: "rgba(255,255,255,0.18)", border: "rgba(255,255,255,0.1)",  bg: "transparent"            },
};

export default function AuditHeader({ activeIndex = 3, onChange }) {
  const [active, setActive] = useState(activeIndex);

  const handleClick = (i) => {
    setActive(i);
    onChange?.(i);
  };

  return (
    <div style={{
      background: "#0b0f1a",
      borderBottom: "1px solid rgba(255,255,255,0.06)",
      fontFamily: "'Montserrat', sans-serif",
      padding: "0 2rem",
    }}>
      <div style={{ display: "flex", alignItems: "stretch" }}>
        {tabs.map((tab, i) => {
          const state = i < active ? "done" : i === active ? "active" : "idle";
          const c = COLORS[state];
          const isActive = state === "active";

          return (
            <button
              key={i}
              onClick={() => handleClick(i)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 13,
                padding: i === 0 ? "17px 28px 17px 0" : "17px 28px",
                cursor: "pointer",
                position: "relative",
                flex: 1,
                background: "none",
                border: "none",
                borderLeft: i > 0 ? "1px solid rgba(255,255,255,0.06)" : "none",
                textAlign: "left",
              }}
            >
              {isActive && (
                <div style={{
                  position: "absolute",
                  bottom: 0, left: 0, right: 0,
                  height: 2,
                  background: BLUE,
                  borderRadius: "2px 2px 0 0",
                }} />
              )}

              <div style={{
                width: 34, height: 34,
                borderRadius: 8,
                border: `1px solid ${c.border}`,
                background: c.bg,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                flexShrink: 0,
                filter: isActive ? "drop-shadow(0 0 5px rgba(79,142,247,0.5))" : "none",
              }}>
                {tab.icon(c.icon)}
              </div>

              <div style={{ display: "flex", flexDirection: "column" }}>
                <span style={{
                  fontSize: 9,
                  fontWeight: 800,
                  color: c.num,
                  letterSpacing: "0.14em",
                  marginBottom: 3,
                }}>
                  {tab.num}
                </span>
                <span style={{
                  fontSize: 11,
                  fontWeight: 900,
                  letterSpacing: "0.08em",
                  textTransform: "uppercase",
                  color: c.label,
                  whiteSpace: "nowrap",
                }}>
                  {tab.label}
                </span>
                <span style={{
                  fontSize: 9,
                  fontWeight: 500,
                  color: c.sub,
                  letterSpacing: "0.04em",
                  marginTop: 3,
                }}>
                  {tab.sub}
                </span>
              </div>
            </button>
          );
        })}
      </div>
    </div>
  );
}
