const HeatmapCell = ({ day, status }) => {
  const baseClass = "aspect-square flex items-center justify-center rounded-lg text-[10px] font-bold transition-all cursor-pointer";
  const styles = {
    profit: "bg-emerald-500 text-white shadow-lg shadow-emerald-500/20 scale-105",
    loss: "bg-rose-500 text-white shadow-lg shadow-rose-500/20 scale-105",
    none: "bg-slate-800/40 text-slate-500 hover:bg-slate-700/50"
  };

  return (
    <div className={`${baseClass} ${styles[status]}`}>
      {day}
    </div>
  );
};

