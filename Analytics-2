      letter-spacing:0.16em;padding:7px 11px;text-align:left;border-bottom:1px solid ${P.line2};font-weight:400;}
    .dtable td{font-family:'Share Tech Mono',monospace;font-size:10px;padding:8px 11px;
      border-bottom:1px solid ${P.line};color:${P.bright};}
    .dtable tr:last-child td{border-bottom:none;}
