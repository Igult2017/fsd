      .equity-ruin-grid{grid-template-columns:1fr !important;}
      .strat-grid{grid-template-columns:1fr !important;}
    }

    /* ── Mobile ≤ 640px ── */
    @media(max-width:640px){
      .page{padding:8px 10px;gap:8px;}
      .g4{grid-template-columns:1fr;}
      .g3{grid-template-columns:1fr;}
      .g2{grid-template-columns:1fr;}

      /* KPI strip wraps to 2-col on mobile */
      .kpi-strip{grid-template-columns:repeat(2,1fr);padding:8px 10px;}
      .kpi-cell:last-child{grid-column:1/-1;}

      .scroll-body{max-height:none;}
      .dtable th,.dtable td{padding:6px 8px;font-size:9px;}
      .equity-ruin-grid{grid-template-columns:1fr !important;}
      .strat-grid{grid-template-columns:1fr !important;}
    }
  `;

  return (
    <div className="dash">
      <style>{css}</style>

      {/* ── KPI Strip ── */}
