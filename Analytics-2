          <Panel title="Drawdown" accent={P.red} tag="CURRENT PERIOD">
            <DR label="Max DD"       value="$300 (0.30%)"  vc={P.red}/>
            <DR label="Current DD"   value="0.30% · −$300" vc={P.amber}/>
            <DR label="Balance"      value="$102,100"      vc={P.green}/>
            <DR label="Period"       value="FEB 2026"      vc={P.dim}/>
            <div style={{ marginTop:10 }}>
              <div style={{ display:'flex', justifyContent:'space-between', marginBottom:4 }}>
                <Mono size={8} color={P.dim}>DD USED</Mono>
                <Mono size={8} color={P.red}>30%</Mono>
              </div>
              <div style={{ height:2, background:P.line2 }}>
                <div style={{ width:'30%', height:'100%', background:P.red }}/>
              </div>
            </div>
          </Panel>

          {/* Avg Win / Loss */}
          <Panel title="Avg Win / Loss" accent={P.green} tag="P&amp;L STATS">
            <DR label="Avg Win"          value="$1,050" vc={P.green}/>
            <DR label="Avg Loss"         value="$300"   vc={P.red}/>
            <DR label="Win / Loss Ratio" value="3.5"    vc={P.cyan}/>
            <DR label="Total Wins"       value="2"      vc={P.green}/>
            <DR label="Total Losses"     value="1"      vc={P.red}/>
          </Panel>

          {/* Streaks */}
          <Panel title="Streaks" accent={P.cyan} tag="WIN / LOSS">
            <DR label="Longest Win Streak"  value="2"      vc={P.green}/>
            <DR label="Longest Loss Streak" value="1"      vc={P.red}/>
            <DR label="Current Streak"      value="LOSS × 1" vc={P.red}/>
            <DR label="Last Win"            value="Feb 08" vc={P.muted}/>
            <DR label="Last Loss"           value="Feb 10" vc={P.muted}/>
          </Panel>

          {/* Recovery */}
          <Panel title="Recovery" accent={P.cyan} tag="POST-LOSS">
            <DR label="Win Rate After Loss"  value="0%"  vc={P.dim}/>
            <DR label="Trades After Loss"    value="0"   vc={P.dim}/>
            <DR label="Wins After Loss"      value="0"   vc={P.dim}/>
            <DR label="Avg R After Loss"     value="—"   vc={P.dim}/>
            <DR label="Recovery Status"      value="N/A" vc={P.dim}/>
          </Panel>
        </div>

        <Divider label="Equity Curve · Risk of Ruin"/>
        <div className="equity-ruin-grid" style={{ display:'grid', gridTemplateColumns:'2fr 1fr', gap:12 }}>
          <EquityChart/>
          <Panel title="Risk of Ruin" accent={P.amber} tag="ACCOUNT SAFETY">
            <DR label="Ruin Probability" value="0.8%" vc={P.green}/>
            <DR label="Win Rate"         value="67%"  vc={P.green}/>
            <DR label="Risk per Trade"   value="1.0%" vc={P.cyan}/>
            <DR label="Profit Factor"    value="8.00" vc={P.cyan}/>
            <DR label="Strategy Version" value="v2.1" vc={P.muted}/>
            <DR label="Risk Status"      value="✓" vc={P.green}/>
          </Panel>
        </div>

        <Divider label="Strategy Performance — Market Conditions"/>

        {/* Strategy Performance Table */}
        <div style={{ background:P.bg2, border:`1px solid ${P.line2}`, position:'relative' }}>
          <Corner pos="tl" color={P.cyan}/><Corner pos="tr" color={P.cyan}/>
          <Corner pos="bl" color={P.line2}/><Corner pos="br" color={P.line2}/>
          <div style={{ borderBottom:`1px solid ${P.line2}`, padding:'7px 12px', background:P.bg3,
            display:'flex', alignItems:'center', gap:8 }}>
            <div style={{ width:2,height:12,background:P.cyan }}/>
            <Cond size={11} color={P.bright} weight={700}>
              Strategy Performance — Impact on Win in Bullish, Bearish and Ranging Markets
            </Cond>
          </div>
          <div style={{ padding:12, overflowX:'auto' }}>
            <table className="dtable">
              <thead>
                <tr>
                  <th>Strategy</th>
                  <th style={{color:P.green}}>Bullish</th>
                  <th style={{color:P.red}}>Bearish</th>
                  <th style={{color:P.amber}}>Ranging</th>
                  <th style={{color:P.amber}}>Liquidity</th>
                  <th style={{color:P.cyan}}>Trend Aligned</th>
                  <th style={{textAlign:'right'}}>Net P/L</th>
                </tr>
              </thead>
              <tbody>
                {[
                  {n:'SMC Breaker',  bu:'74%',be:'29%',ra:'35%',lq:'High',al:'74%',pl:'+$900',   pc:P.green},
                  {n:'Silver Bullet',bu:'68%',be:'33%',ra:'41%',lq:'High',al:'68%',pl:'+$1,200', pc:P.green},
                ].map((r,i)=>(
                  <tr key={i}>
                    <td className="dn">{r.n}</td>
                    <td style={{color:P.green}}>{r.bu}</td>
                    <td style={{color:P.red}}>{r.be}</td>
                    <td style={{color:P.amber}}>{r.ra}</td>
                    <td style={{color:P.amber}}>{r.lq}</td>
                    <td style={{color:P.cyan}}>{r.al}</td>
                    <td style={{fontFamily:"'Barlow Condensed',sans-serif",fontSize:17,fontWeight:700,color:r.pc,textAlign:'right'}}>{r.pl}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <Divider label="Setup Occurrence Frequency"/>

        {/* Setup Frequency Table */}
        <div style={{ background:P.bg2, border:`1px solid ${P.line2}`, position:'relative', marginBottom:8 }}>
          <Corner pos="tl" color={P.amber}/><Corner pos="tr" color={P.amber}/>
          <Corner pos="bl" color={P.line2}/><Corner pos="br" color={P.line2}/>
          <div style={{ borderBottom:`1px solid ${P.line2}`, padding:'7px 12px', background:P.bg3,
            display:'flex', alignItems:'center', gap:8 }}>
            <div style={{ width:2,height:12,background:P.amber }}/>
            <Cond size={11} color={P.bright} weight={700}>Setup Occurrence Frequency — Per Day / Week / Month / Year</Cond>
          </div>
          <div style={{ padding:12, overflowX:'auto' }}>
            <table className="dtable">
              <thead>
                <tr>
                  <th>Setup</th>
                  <th style={{color:P.cyan}}>Per Day</th>
                  <th style={{color:P.cyan}}>Per Week</th>
                  <th style={{color:P.cyan}}>Per Month</th>
                  <th style={{color:P.cyan}}>Per Year</th>
                  <th style={{color:P.amber}}>Win Rate</th>
                  <th style={{textAlign:'right'}}>Best Period</th>
                </tr>
              </thead>
              <tbody>
                {[
                  {n:'Silver Bullet',d:'1–2',w:'5–8',  m:'20–32',y:'240–384',wr:'67%',best:'London Open'},
                  {n:'SMC Breaker',  d:'0–1',w:'2–4',  m:'8–16', y:'96–192', wr:'74%',best:'NY Session'},
                  {n:'Breakout',     d:'0–1',w:'1–3',  m:'4–12', y:'48–144', wr:'74%',best:'Tuesday'},
                  {n:'Pullback',     d:'1–3',w:'5–10', m:'20–40',y:'240–480',wr:'63%',best:'Monday'},
                  {n:'FVG Fill',     d:'1–3',w:'5–12', m:'20–48',y:'240–576',wr:'70%',best:'London'},
                ].map((r,i)=>(
                  <tr key={i}>
                    <td className="dn">{r.n}</td>
                    <td>{r.d}</td><td>{r.w}</td><td>{r.m}</td><td>{r.y}</td>
                    <td style={{color:P.green,fontWeight:600}}>{r.wr}</td>
                    <td style={{color:P.amber,textAlign:'right'}}>{r.best}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  );
}
