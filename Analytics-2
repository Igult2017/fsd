    .dash::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:9999;
      background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.025) 2px,rgba(0,0,0,0.025) 4px);}

    /* ── KPI Strip ── */
    .kpi-strip{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;padding:8px 20px;background:${P.bg};border-bottom:1px solid ${P.line2};}
    .kpi-cell{background:${P.bg2};border:1px solid ${P.line2};padding:10px 14px 12px;position:relative;overflow:hidden;}
    .kpi-cell::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
    .kpi-pos::before{background:linear-gradient(to right,${P.green},transparent);}
    .kpi-neg::before{background:linear-gradient(to right,${P.red},transparent);}
    .kpi-neu::before{background:linear-gradient(to right,${P.line2},transparent);}

    /* ── Layout ── */
    .page{padding:14px 20px;display:flex;flex-direction:column;gap:12px;}
    .g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
    .g3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
    .g2{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}

    /* ── Tables ── */
