// ─── CONTEXT CELL ────────────────────────────────────────────────────────────
const getCtxColor = (id, val) => {
  if (id==='bia') return val.includes('🟢') ? C.win : val.includes('🔴') ? C.loss : C.warn;
  if (id==='nws') return val.includes('🚫') ? C.loss : val.includes('📰') ? C.warn : C.win;
  if (id==='cnd') return val.includes('Uptrend')||val.includes('Breakout') ? C.win
    : val.includes('Downtrend')||val.includes('News')||val.includes('Chop') ? C.loss : C.warn;
  return C.strong;
};

const CtxCell = ({ value, id, w }) => {
  const [main, sub] = (value||'—').split(' · ');
  const col = getCtxColor(id, main);
  return (
    <td style={{
      padding:'12px 14px', verticalAlign:'middle',
      borderRight:`1px solid ${C.border}`, borderBottom:`1px solid ${C.border}`,
      minWidth:w, width:w, maxWidth:w,
    }}>
      {(id==='bia'||id==='nws'||id==='cnd') ? (
        <span style={{
          display:'inline-block',
          fontFamily: MONO, fontSize:9, fontWeight:500,
          color: col,
          background: col + '15',
          border:`1px solid ${col}28`,
          padding:'3px 9px', borderRadius:3,
          letterSpacing:'0.06em',
          whiteSpace:'nowrap',
        }}>{main}</span>
      ) : (
        <>
          <div style={{
            fontFamily: MONO, fontSize:10, fontWeight:500,
            color:C.strong, lineHeight:1.5, marginBottom: sub ? 3 : 0,
            letterSpacing:'0.04em', wordBreak:'break-word',
          }}>{main}</div>
          {sub && <div style={{
            fontFamily: SANS, fontSize:10, fontWeight:400,
            color:C.muted, lineHeight:1.5, wordBreak:'break-word',
          }}>{sub}</div>}
        </>
      )}
    </td>
  );
};

