const InsightBadge = ({ text, type = 'warning' }) => {
  const s = {
    warning: 'bg-amber-500/10 border-amber-500/30 text-amber-200',
    danger:  'bg-rose-500/10  border-rose-500/30  text-rose-200',
    success: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-200',
    info:    'bg-blue-500/10  border-blue-500/30  text-blue-200',
  };
  const icons = { warning: AlertTriangle, danger: XCircle, success: CheckCircle2, info: Lightbulb };
  const Icon = icons[type];
  return (
    <div className={`flex items-start gap-2 p-3 border ${s[type]} mt-3 rounded-sm`}>
      <Icon className="w-3 h-3 shrink-0 mt-0.5 opacity-80" />
      <p className="text-[10px] leading-relaxed font-semibold italic">{text}</p>
    </div>
  );
};

const PerfRow = ({ label, trades, wr, avgR, netPL, highlight = false, sub }) => {
  const wrCol = wr >= 75 ? 'text-emerald-400' : wr >= 58 ? 'text-amber-400' : 'text-rose-400';
  const barCol = wr >= 75 ? 'bg-emerald-500' : wr >= 58 ? 'bg-amber-500' : 'bg-rose-500';
  const plCol = netPL >= 0 ? 'text-emerald-400' : 'text-rose-400';
  return (
    <div className={`px-4 py-3 border-b border-white/[0.035] last:border-0 hover:bg-white/[0.02] transition-colors ${highlight ? 'bg-emerald-950/20' : netPL < 0 ? 'bg-rose-950/20' : ''}`}>
      <div className="flex items-center gap-3 mb-1.5">
        <span className="text-[10px] font-bold text-slate-300 w-52 shrink-0 uppercase tracking-tight">{label}</span>
        <div className="flex-1">
          <div className="w-full bg-[#0a1020] h-1.5 rounded-full">
            <div className={`h-full ${barCol} rounded-full`} style={{ width: `${wr}%` }} />
          </div>
        </div>
        <span className={`text-xs font-black mono w-10 text-right ${wrCol}`}>{wr}%</span>
        <span className={`text-[10px] font-bold mono w-12 text-right ${avgR >= 2 ? 'text-blue-400' : avgR >= 0 ? 'text-slate-500' : 'text-rose-500'}`}>{avgR > 0 ? '+' : ''}{avgR.toFixed(1)}R</span>
        <span className={`text-[10px] font-bold mono w-16 text-right ${plCol}`}>{netPL >= 0 ? '+' : ''}${netPL.toLocaleString()}</span>
        <span className="text-[9px] text-slate-700 mono w-12 text-right">{trades}tr</span>
      </div>
      {sub && <p className="text-[9px] text-slate-600 italic pl-0 mt-0.5">{sub}</p>}
    </div>
  );
};

const SectionHead = ({ icon: Icon, title, color = 'blue', badge }) => {
  const cols = {
    blue:   'text-blue-400   bg-blue-950/30   border-blue-900/50',
    emerald:'text-emerald-400 bg-emerald-950/30 border-emerald-900/50',
    amber:  'text-amber-400  bg-amber-950/30  border-amber-900/50',
    rose:   'text-rose-400   bg-rose-950/30   border-rose-900/50',
    violet: 'text-violet-400 bg-violet-950/30 border-violet-900/50',
    cyan:   'text-cyan-400   bg-cyan-950/30   border-cyan-900/50',
    indigo: 'text-indigo-400 bg-indigo-950/30 border-indigo-900/50',
  };
  const c = cols[color] || cols.blue;
  const [textC, bgC, borderC] = c.split(' ');
  return (
    <div className={`flex items-center gap-2.5 px-4 py-3 ${bgC} border-b ${borderC}`}>
      <Icon className={`w-3.5 h-3.5 ${textC} shrink-0`} />
      <h3 className={`text-[10px] font-black uppercase tracking-[0.2em] ${textC}`}>{title}</h3>
      {badge && <span className={`ml-2 px-2 py-0.5 text-[8px] font-black uppercase tracking-widest border rounded-sm ${bgC} ${borderC} ${textC}`}>{badge}</span>}
    </div>
  );
};

