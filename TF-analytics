      <CtxCell value={row.bias}      id="bia" w={105} />
      <CtxCell value={row.news}      id="nws" w={190} />
      <MomCell value={row.momentum} />
      <SampleCell trades={row.trades} wr={row.wr} />
      <PerfCell row={row} />
    </tr>
  );
};

// ─── MOBILE CARD ─────────────────────────────────────────────────────────────
const MobileCard = ({ row }) => {
  const [expanded, setExpanded] = useState(false);
  const isElite = row.wr >= 85;
  const isWeak  = row.wr < 50;
  const col     = wrC(row.wr);

  const biasL0  = (row.bias||'').split(' · ')[0];
  const newsL0  = (row.news||'').split(' · ')[0];
  const condL0  = (row.condition||'').split(' · ')[0];
  const [momMain, momSub] = row.momentum.split(' · ');

  const biasCol = getCtxColor('bia', biasL0);
  const newsCol = getCtxColor('nws', newsL0);
  const condCol = getCtxColor('cnd', condL0);

  const wins   = Math.round(row.trades * row.wr / 100);
  const losses = row.trades - wins;

  return (
    <div style={{
      margin:'0 10px 6px',
      background: isElite ? 'rgba(167,139,250,0.03)' : isWeak ? 'rgba(244,63,94,0.03)' : C.surface,
      border:`1px solid ${isElite ? C.htf+'30' : isWeak ? C.loss+'30' : C.border}`,
      borderRadius:6, overflow:'hidden',
    }}>
      {/* Card header */}
      <div
        onClick={() => setExpanded(e => !e)}
        style={{ padding:'12px 14px', cursor:'pointer', userSelect:'none' }}
      >
        {/* Top row: TF badges + WR */}
        <div style={{ display:'flex', alignItems:'flex-start', justifyContent:'space-between', marginBottom:10 }}>
          <div style={{ display:'flex', alignItems:'center', flexWrap:'wrap', gap:5, flex:1, marginRight:12 }}>
            {[{tf:row.htf,i:0},{tf:row.atf,i:1},{tf:row.etf,i:2}].map(({tf,i}) => {
              const c = roleColor[tf] || C.sub;
              return (
                <div key={i} style={{ display:'flex', alignItems:'center', gap:3 }}>
                  <span style={{
                    fontFamily:MONO, fontSize:11, fontWeight:500,
                    color:c, background:c+'14',
                    border:`1px solid ${c}22`,
                    padding:'2px 7px', borderRadius:3, letterSpacing:'0.1em',
                  }}>{tf}</span>
                  <span style={{ fontFamily:MONO, fontSize:7, color:C.sub, textTransform:'uppercase', letterSpacing:'0.1em' }}>{roleName(i)}</span>
                </div>
              );
            })}
            {(isElite||isWeak) && (
              <span style={{
                fontFamily:MONO, fontSize:7, fontWeight:500,
                letterSpacing:'0.14em', textTransform:'uppercase',
                color:isElite?C.win:C.loss,
                background:isElite?C.win+'12':C.loss+'12',
                border:`1px solid ${isElite?C.win:C.loss}25`,
                padding:'2px 7px', borderRadius:3,
              }}>{isElite?'★ ELITE':'✗ AVOID'}</span>
            )}
          </div>
          <div style={{ display:'flex', flexDirection:'column', alignItems:'flex-end', gap:3, flexShrink:0 }}>
            <span style={{ fontFamily:MONO, fontSize:16, fontWeight:500, color:col, lineHeight:1 }}>{row.wr}%</span>
            <WRBar wr={row.wr} width={60} />
          </div>
        </div>

        {/* Stats row */}
        <div style={{ display:'flex', gap:20, marginBottom:10 }}>
          {[
            { label:'AVG R',   value:`${row.avgR>0?'+':''}${row.avgR}R`,   color: row.avgR>=3?'#60a5fa':C.muted },
            { label:'NET P/L', value:`${row.netPL>=0?'+':''}$${row.netPL.toLocaleString()}`, color: row.netPL>=0?C.win:C.loss },
            { label:'SAMPLE',  value:`${row.trades} · ${wins}W/${losses}L`, color: C.strong },
          ].map(({label,value,color}) => (
            <div key={label}>
              <div style={{ fontFamily:MONO, fontSize:8, fontWeight:400, color:C.sub, textTransform:'uppercase', letterSpacing:'0.12em', marginBottom:2 }}>{label}</div>
              <div style={{ fontFamily:MONO, fontSize:11, fontWeight:500, color }}>{value}</div>
            </div>
          ))}
        </div>

        {/* Tags */}
        <div style={{ display:'flex', gap:5, flexWrap:'wrap', marginBottom:10 }}>
          {[{text:biasL0,col:biasCol},{text:condL0,col:condCol},{text:newsL0,col:newsCol}].map(({text,col}) => (
            <span key={text} style={{
              fontFamily:MONO, fontSize:9, fontWeight:500,
              color:col, background:col+'15',
              border:`1px solid ${col}28`,
              padding:'3px 9px', borderRadius:3, letterSpacing:'0.06em',
            }}>{text}</span>
          ))}
        </div>

        {/* Footer */}
        <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between' }}>
          <span style={{ fontFamily:SANS, fontSize:10, color:C.muted }}>{row.session}</span>
          <span style={{
            fontFamily:MONO, fontSize:9, fontWeight:500,
            color:C.accent, letterSpacing:'0.1em',
            background:C.accent+'15',
            padding:'2px 8px', borderRadius:3,
            border:`1px solid ${C.accent}25`,
          }}>{expanded?'▲ LESS':'▼ MORE'}</span>
        </div>
      </div>

      {/* Expanded content */}
      {expanded && (
        <div style={{ borderTop:`1px solid ${C.sep}` }}>
          {[
            { label:'HTF', tf:row.htf, color:C.htf, data:row.tf1 },
            { label:'ATF', tf:row.atf, color:C.atf, data:row.tf2 },
            { label:'ETF', tf:row.etf, color:C.etf, data:row.tf3 },
          ].map(({label,tf,color,data}) => (
            <div key={label} style={{ padding:'11px 14px', borderBottom:`1px solid ${C.border}` }}>
              <div style={{ display:'flex', alignItems:'center', gap:6, marginBottom:5 }}>
                <TierDot color={color} />
                <Badge color={color}>{tf}</Badge>
                <span style={{ fontFamily:MONO, fontSize:7, color:C.sub, textTransform:'uppercase', letterSpacing:'0.12em' }}>{label}</span>
                <span style={{ fontFamily:MONO, fontSize:10, fontWeight:500, color, letterSpacing:'0.04em' }}>{data.candle}</span>
              </div>
              <p style={{ fontFamily:SANS, fontSize:12, color:C.text, lineHeight:1.7, margin:0 }}>{data.pa}</p>
            </div>
          ))}

          <div style={{ padding:'11px 14px', borderBottom:`1px solid ${C.border}` }}>
            <div style={{ fontFamily:MONO, fontSize:8, fontWeight:500, color:C.ind, textTransform:'uppercase', letterSpacing:'0.14em', marginBottom:7 }}>
              Indicators
            </div>
            {row.indicators.split('\n').map((line,i) => (
              <div key={i} style={{ display:'flex', gap:6, marginBottom:4 }}>
                <span style={{ width:3, height:3, borderRadius:'50%', background:i===0?C.ind:C.sub, flexShrink:0, marginTop:5 }} />
                <span style={{ fontFamily:i===0?MONO:SANS, fontSize:11, color:i===0?C.strong:C.text, fontWeight:i===0?500:400, lineHeight:1.6 }}>{line}</span>
              </div>
            ))}
          </div>

          <div style={{ padding:'11px 14px', borderBottom:`1px solid ${C.border}` }}>
            <div style={{ fontFamily:MONO, fontSize:8, color:C.ctx, textTransform:'uppercase', letterSpacing:'0.14em', marginBottom:5 }}>Momentum</div>
            <div style={{ fontFamily:MONO, fontSize:13, fontWeight:500, color:C.strong }}>{momMain}</div>
            {momSub && <div style={{ fontFamily:SANS, fontSize:11, color:C.sub, marginTop:2 }}>{momSub}</div>}
          </div>

          <div style={{ padding:'11px 14px', display:'grid', gridTemplateColumns:'1fr 1fr', gap:'8px 16px' }}>
            <div>
              <div style={{ fontFamily:MONO, fontSize:8, color:C.sub, textTransform:'uppercase', letterSpacing:'0.12em', marginBottom:3 }}>Session</div>
              <div style={{ fontFamily:SANS, fontSize:11, color:C.muted, lineHeight:1.6 }}>{row.session.replace(' · ','\n')}</div>
            </div>
            <div>
              <div style={{ fontFamily:MONO, fontSize:8, color:C.sub, textTransform:'uppercase', letterSpacing:'0.12em', marginBottom:3 }}>Condition</div>
              <div style={{ fontFamily:MONO, fontSize:11, fontWeight:500, color:condCol }}>{condL0}</div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

