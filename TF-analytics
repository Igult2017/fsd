          })}
        </div>
        {(isElite || isWeak) && (
          <div style={{
            marginTop:8, paddingTop:7,
            borderTop:`1px solid ${isElite ? C.win+'20' : C.loss+'20'}`,
            fontFamily: MONO, fontSize:8, fontWeight:500,
            letterSpacing:'0.16em', textTransform:'uppercase',
