// ─── SAMPLE CELL ─────────────────────────────────────────────────────────────
const SampleCell = ({ trades, wr }) => {
  const wins = Math.round(trades * wr / 100);
  const losses = trades - wins;
  return (
    <td style={{
      padding:'12px 14px', verticalAlign:'middle', textAlign:'center',
      borderRight:`1px solid ${C.border}`, borderBottom:`1px solid ${C.border}`,
      minWidth:110, width:110,
    }}>
      <div style={{ fontFamily:MONO, fontSize:14, fontWeight:500, color:C.strong, lineHeight:1, marginBottom:6 }}>
        {trades}
      </div>
      <div style={{ display:'flex', justifyContent:'center', gap:5, marginBottom:6 }}>
        <span style={{ fontFamily:MONO, fontSize:9, fontWeight:500, color:C.win }}>{wins}W</span>
        <span style={{ fontFamily:MONO, fontSize:9, fontWeight:400, color:C.sub }}>/</span>
        <span style={{ fontFamily:MONO, fontSize:9, fontWeight:500, color:C.loss }}>{losses}L</span>
      </div>
      <WRBar wr={wr} />
    </td>
  );
};

