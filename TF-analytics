// ─── MAIN ─────────────────────────────────────────────────────────────────────
export default function TFSMatrix() {
  const [page, setPage]     = useState(1);
  const [isMobile, setMobile] = useState(false);

  useEffect(() => {
    const check = () => setMobile(window.innerWidth < 1024);
    check();
    window.addEventListener('resize', check);
    return () => window.removeEventListener('resize', check);
  }, []);

  const rows = page === 1
    ? ROWS
    : [...ROWS].filter(r => r.wr >= 78).sort((a, b) => b.wr - a.wr);

  const COLS = [
    { label:'HTF',        sub:'Pattern & Price Action', color:C.htf,  w:210, leftBorder:false },
    { label:'ATF',        sub:'Pattern & Price Action', color:C.atf,  w:210, leftBorder:false },
    { label:'ETF',        sub:'Pattern & Price Action', color:C.etf,  w:210, leftBorder:false },
    { label:'Indicators', sub:'State at entry',         color:C.ind,  w:185, leftBorder:true  },
    { label:'Session',    sub:'Time window',            color:C.ctx,  w:140, leftBorder:false },
    { label:'Condition',  sub:'Trend / Range',          color:C.ctx,  w:165, leftBorder:false },
    { label:'Bias',       sub:'Direction',              color:C.ctx,  w:105, leftBorder:false },
    { label:'News',       sub:'Event status',           color:C.ctx,  w:190, leftBorder:false },
    { label:'Momentum',   sub:'ATR / Expansion',        color:C.ctx,  w:155, leftBorder:false },
    { label:'Sample',     sub:'Dataset size',           color:C.sub,  w:110, leftBorder:false },
    { label:'Performance',sub:'WR · Avg R · P/L',       color:C.perf, w:145, leftBorder:true  },
  ];

  // Summary stats for top bar
  const allRows = ROWS;
  const eliteCount = allRows.filter(r => r.wr >= 85).length;
  const avgWR = Math.round(allRows.reduce((s,r) => s+r.wr, 0) / allRows.length);
  const bestWR = Math.max(...allRows.map(r => r.wr));

  return (
    <div style={{ minHeight:'100vh', background:C.bg, color:C.text }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500&family=Plus+Jakarta+Sans:wght@400;500;600&family=Outfit:wght@500;600;700;800&display=swap');
        *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
        body { background:#060a10; }
        ::-webkit-scrollbar { width:3px; height:4px; }
        ::-webkit-scrollbar-track { background:#050810; }
        ::-webkit-scrollbar-thumb { background:#1a2e44; border-radius:4px; }
        ::-webkit-scrollbar-thumb:hover { background:#243d55; }
        .fadein { animation:fi 0.2s ease; }
        @keyframes fi { from{opacity:0;transform:translateY(3px)} to{opacity:1;transform:translateY(0)} }
        tbody tr:hover > td { background:rgba(120,180,255,0.012) !important; }
        table { border-collapse:separate; border-spacing:0; }
        button { cursor:pointer; outline:none; }
      `}</style>

      {/* ── HEADER ── */}
      <div style={{
        position:'sticky', top:0, zIndex:100,
        background:'rgba(6,10,16,0.96)',
        backdropFilter:'blur(24px)',
        borderBottom:'1px solid rgba(120,180,255,0.08)',
      }}>
        <div style={{
          display:'flex', alignItems:'center',
          padding: isMobile ? '0 14px' : '0 22px',
          height: isMobile ? 44 : 50,
          gap:0,
        }}>
          {/* Brand */}
          <div style={{
            display:'flex', alignItems:'center', gap:10,
            paddingRight:18, borderRight:'1px solid rgba(120,180,255,0.08)',
            flexShrink:0,
          }}>
            <div style={{
              width:22, height:22, borderRadius:5,
              background:'linear-gradient(135deg, #6366f180, #38bdf840)',
              border:'1px solid rgba(120,180,255,0.2)',
              display:'flex', alignItems:'center', justifyContent:'center',
            }}>
              <span style={{ fontFamily:DISPLAY, fontSize:10, fontWeight:700, color:'#a5b4fc', letterSpacing:'-0.02em' }}>TF</span>
            </div>
            <div>
              <div style={{ fontFamily:DISPLAY, fontSize:13, fontWeight:700, color:'#c8dff2', letterSpacing:'0.06em', lineHeight:1.1 }}>
                Analytics
              </div>
              {!isMobile && (
                <div style={{ fontFamily:MONO, fontSize:8, fontWeight:400, color:C.muted, letterSpacing:'0.1em' }}>
                  MULTI-TIMEFRAME MATRIX
                </div>
              )}
            </div>
          </div>

          {/* Tabs */}
          <div style={{ display:'flex', alignItems:'stretch', height:'100%', marginRight:'auto' }}>
            {[
              { n:1, label: isMobile ? 'Matrix' : 'Full Matrix',     sub:`${ROWS.length} scenarios` },
              { n:2, label: isMobile ? 'Elite'  : 'Best Performers', sub:'WR ≥ 78%' },
            ].map(p => {
              const active = page === p.n;
              return (
                <button key={p.n} onClick={() => setPage(p.n)} style={{
                  display:'flex', alignItems:'center', gap: isMobile ? 0 : 8,
                  padding: isMobile ? '0 14px' : '0 18px',
                  background:'transparent',
                  border:'none',
                  borderBottom: active ? `2px solid ${C.accent}` : '2px solid transparent',
                  transition:'all .15s',
                }}>
                  <span style={{
                    fontFamily: MONO, fontSize:11,
                    fontWeight: active ? 500 : 400,
                    color: active ? C.bright : 'rgba(148,200,255,0.3)',
                    letterSpacing:'0.1em', textTransform:'uppercase',
                    transition:'color .15s',
                  }}>{p.label}</span>
                  {!isMobile && (
                    <span style={{
                      fontFamily:MONO, fontSize:8,
                      color: active ? 'rgba(148,200,255,0.4)' : 'rgba(148,200,255,0.15)',
                      transition:'color .15s',
                    }}>{p.sub}</span>
                  )}
                </button>
              );
            })}
          </div>

          {/* Legend */}
          {!isMobile && (
            <div style={{ display:'flex', alignItems:'center', gap:14 }}>
              {[
                {c:C.htf,l:'HTF'},{c:C.atf,l:'ATF'},{c:C.etf,l:'ETF'},
                null,
                {c:C.win,l:'≥80%'},{c:C.warn,l:'62–79%'},{c:C.loss,l:'<62%'},
              ].map((x, i) => x === null ? (
                <div key={i} style={{ width:1, height:12, background:'rgba(120,180,255,0.1)' }} />
              ) : (
                <div key={x.l} style={{ display:'flex', alignItems:'center', gap:5 }}>
                  <TierDot color={x.c} />
                  <span style={{ fontFamily:MONO, fontSize:9, color:'rgba(148,200,255,0.35)', letterSpacing:'0.08em' }}>{x.l}</span>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* Summary strip */}
        {!isMobile && (
          <div style={{
            display:'flex', alignItems:'center', gap:0,
            borderTop:'1px solid rgba(120,180,255,0.05)',
            height:28, paddingLeft:22,
            overflow:'hidden',
          }}>
            {[
              { label:'Scenarios', value:ROWS.length, color:C.strong },
              { label:'Elite (≥85%)', value:eliteCount, color:C.win },
              { label:'Avg WR', value:`${avgWR}%`, color:C.perf },
              { label:'Best WR', value:`${bestWR}%`, color:C.win },
            ].map(({label,value,color}, i) => (
              <div key={label} style={{
                display:'flex', alignItems:'center', gap:8,
                paddingRight:18, marginRight:18,
                borderRight: i<3 ? '1px solid rgba(120,180,255,0.06)' : 'none',
              }}>
                <span style={{ fontFamily:MONO, fontSize:8, fontWeight:400, color:C.sub, textTransform:'uppercase', letterSpacing:'0.12em' }}>{label}</span>
                <span style={{ fontFamily:MONO, fontSize:11, fontWeight:500, color }}>{value}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* Mobile legend */}
      {isMobile && (
        <div style={{
          display:'flex', alignItems:'center', gap:12,
          padding:'5px 14px',
          borderBottom:'1px solid rgba(120,180,255,0.05)',
          background:'rgba(6,10,16,0.7)',
        }}>
          {[{c:C.htf,l:'HTF'},{c:C.atf,l:'ATF'},{c:C.etf,l:'ETF'},{c:C.win,l:'≥80%'},{c:C.warn,l:'62-79%'},{c:C.loss,l:'<62%'}].map(x => (
            <div key={x.l} style={{ display:'flex', alignItems:'center', gap:4 }}>
              <TierDot color={x.c} />
              <span style={{ fontFamily:MONO, fontSize:9, color:'rgba(148,200,255,0.3)', letterSpacing:'0.08em' }}>{x.l}</span>
            </div>
          ))}
        </div>
      )}

      {/* Content */}
      <div className="fadein" key={`${page}-${isMobile}`} style={{ paddingBottom:28 }}>
        {isMobile ? (
          <div style={{ paddingTop:8 }}>
            {rows.map(row => <MobileCard key={row.id} row={row} />)}
          </div>
        ) : (
          <div style={{ overflowX:'auto' }}>
            <table>
              <thead>
                <tr>
                  {/* First col header */}
                  <th style={{
                    background: C.panel,
                    width:140, minWidth:140,
                    padding:'11px 13px',
                    borderRight:`1px solid ${C.sep}`,
                    borderBottom:`1px solid ${C.sep}`,
                    textAlign:'left', verticalAlign:'bottom',
                  }}>
                    <div style={{ fontFamily:MONO, fontSize:8, fontWeight:500, color:C.sub, letterSpacing:'0.18em', textTransform:'uppercase' }}>
                      MTF Combo
                    </div>
                    <div style={{ fontFamily:MONO, fontSize:7, fontWeight:400, color:C.sub, marginTop:3, letterSpacing:'0.1em', opacity:0.6 }}>
                      HTF → ATF → ETF
                    </div>
                  </th>
                  {COLS.map((col, i) => (
                    <th key={i} style={{
                      padding:'11px 14px',
                      textAlign:'left', verticalAlign:'bottom',
                      background: col.color + '08',
                      borderBottom:`1px solid ${C.sep}`,
                      borderLeft: col.leftBorder ? `1px solid ${C.sep}` : undefined,
                      borderRight:`1px solid ${C.border}`,
                      width:col.w, minWidth:col.w,
                    }}>
                      <div style={{ display:'flex', alignItems:'center', gap:6, marginBottom:3 }}>
                        <TierDot color={col.color} />
                        <span style={{
                          fontFamily:MONO, fontSize:9, fontWeight:500,
                          color:col.color, letterSpacing:'0.14em', textTransform:'uppercase',
                        }}>{col.label}</span>
                      </div>
                      <div style={{
                        fontFamily:SANS, fontSize:9, fontWeight:400,
                        color:C.sub, paddingLeft:11,
                      }}>{col.sub}</div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map((row, i) => <MatrixRow key={row.id} row={row} index={i} />)}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* Insights panel */}
      {page === 2 && <InsightsPanel isMobile={isMobile} />}
    </div>
  );
}
