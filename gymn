        border: `1.5px solid ${hovered ? service.color : "#222"}`,
        borderRadius: 20,
        overflow: "hidden",
        transition: "all 0.4s cubic-bezier(0.23,1,0.32,1)",
        transform: inView ? `translateY(0) scale(${hovered ? 1.02 : 1})` : "translateY(60px)",
